#include <assert.h>
#include <stdio.h>
#include <string.h>
@FLAGS@
@GAME_SPEED@
static unsigned obor_profile_build;
static int goto_mainmenu_flag, bothnewkeys, event_count;
static int callback_flag, callback_escape, time;
static int game_success, gameover_flag, hall_flag;
static struct { int lives, hasplayed, weapnum; } player[4];
static struct { int noshowgameover, noshowhof, maxplayers; } settings;
static struct { const char *filename; } entry;
static void event_separator(void){if(event_count++)putchar(',');}
static void playscene(const char *path)
{
    event_separator();printf("[\"scene\",\"%s\",%d]",path,goto_mainmenu_flag);
}
static void update(int a,int b)
{
    assert(a==0 && b==0);
    event_separator();printf("[\"update\",%d,%d,%d]",a,b,goto_mainmenu_flag);
    time+=7;
    if(callback_flag>=0)goto_mainmenu_flag=callback_flag;
    if(callback_escape>=0)bothnewkeys=callback_escape?FLAG_ESC:0;
}
static int playlevel(const char *path)
{
    assert(strcmp(path,"fixture-level")==0);
    event_separator();printf("[\"play\",%d]",goto_mainmenu_flag);return game_success;
}
static void gameover(void)
{
    event_separator();printf("[\"gameover\",%d]",goto_mainmenu_flag);
    if(gameover_flag>=0)goto_mainmenu_flag=gameover_flag;
}
static void hallfame(int value)
{
    assert(value==1);
    event_separator();printf("[\"hall\",%d,%d]",value,goto_mainmenu_flag);
    if(hall_flag>=0)goto_mainmenu_flag=hall_flag;
}
static void intro_frame(const int *c)
{
    int skiptoset=c[0],introtime=c[1]?40:41,started=7,relback=9,quit=0;
    char tmpBuff[256]={0},*custScenes=c[4]?"custom/":NULL;
    time=40;goto_mainmenu_flag=c[2];bothnewkeys=c[3]?FLAG_ESC:0;
    callback_flag=c[5];callback_escape=c[6];
    @INTRO@
    printf("],\"state\":[%d,%d,%d,%d,%d,%d,%d]}",goto_mainmenu_flag,
           started,relback,quit,introtime,time,!!(bothnewkeys&FLAG_ESC));
}
static void failed_level(const int *c)
{
    int i,reached=0;
    __typeof__(settings) *set=&settings;
    __typeof__(entry) *le=&entry;
    goto_mainmenu_flag=c[0];set->noshowgameover=c[1]&1;set->noshowhof=c[1]&2;
    set->maxplayers=c[3];game_success=c[4];gameover_flag=c[5];hall_flag=c[6];
    le->filename="fixture-level";
    const int lives[]={-1,0,-2,0};
    for(i=0;i<4;++i){player[i].lives=lives[i];player[i].hasplayed=10+i;player[i].weapnum=20+i;}
    if(c[2]>=0)player[c[2]].lives=3;
    for(;;){
        if(0){}
        @GAME@
        reached=1;break;
    }
    printf("],\"state\":[%d,%d",goto_mainmenu_flag,reached);
    for(i=0;i<4;++i)printf(",%d",player[i].hasplayed);
    for(i=0;i<4;++i)printf(",%d",player[i].weapnum);
    for(i=0;i<4;++i)printf(",%d",player[i].lives);
    printf("]}");
}
static const unsigned contexts[]={@CONTEXTS@};
static const int intro_cases[][7]={@INTRO_CASES@};
static const int game_cases[][7]={@GAME_CASES@};
int main(void)
{
    for(unsigned r=0;r<sizeof(contexts)/sizeof(*contexts);++r){
        obor_profile_build=contexts[r];
        for(unsigned k=0;k<2;++k){
            const int (*cases)[7]=k?game_cases:intro_cases;
            unsigned count=k?sizeof(game_cases)/sizeof(*game_cases):sizeof(intro_cases)/sizeof(*intro_cases);
            for(unsigned c=0;c<count;++c){
                event_count=0;
                printf("{\"revision\":%u,\"kind\":\"%s\",\"case\":%u,\"events\":[",
                       obor_profile_build,k?"game":"intro",c);
                if(k)failed_level(cases[c]);else intro_frame(cases[c]);
                putchar('\n');
            }
        }
    }
    return 0;
}
