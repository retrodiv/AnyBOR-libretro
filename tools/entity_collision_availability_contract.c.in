#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include "openbor.h"
#include "commands.h"
#include "profile_ids.h"
#undef assert
#undef printf
#include <assert.h>
#ifndef stricmp
#define stricmp strcasecmp
