#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef assert
#undef printf
#include <assert.h>

uint32_t obor_profile_build;
u32 time;
entity *self, *textbox, *smartbomber;
s_level *level;
static s_level scene;
static entity actors[3];
static entity *entities[3];
static entity **ent_list = entities;
static int ent_count, ent_max, endgame;
static s_anim animation;
static s_anim *animations[MAX_ANIS];
static int horizontal[] = {2, 4}, depth[] = {3, -1};
static float platform_boxes[2][8] = {{0,0,0,0,0,0,0,6}, {0,0,0,0,0,0,0,6}};
static char trace[96];
static unsigned events;
static int movement_policy, frame_impulse, animation_platform;

static void observe(char type, entity *actor)
{
    assert(actor >= actors && actor < actors + 3 && events + 2 < sizeof(trace));
    trace[events++] = type;
    trace[events++] = (char)('0' + (actor - actors));
    trace[events] = 0;
}

static int try_move(float x, float z)
{
    observe('M', self);
    if(movement_policy == 1) return 0;
    if(movement_policy == 2) x *= 0.5f;
    self->x += x;
    self->z += z;
    return movement_policy == 2 ? 0 : 1;
}

static void take_action(void) { observe('A', self); }
static void think(void) { observe('T', self); }
void execute_updateentity_script(entity *actor) { observe('U', actor); }
void execute_think_script(entity *actor) { observe('S', actor); }
void check_gravity(void) { observe('G', self); }
void check_attack(void) { observe('C', self); }
void check_lost(void) { observe('L', self); }
void update_health(void) { observe('H', self); }
int set_idle(entity *actor) { observe('I', actor); return 1; }
void adjust_bind(entity *actor) { observe('B', actor); }

int testplatform(entity *platform, float x, float z, entity *exclude)
{
    assert(platform == &actors[1] && !exclude);
    (void)x;
    (void)z;
    observe('P', self);
    return 1;
}

@MOTION@
@LINK@
@AI@

static void frame_motion(entity *ent, int f)
{
    s_anim *anim = ent->animation;
    float move, movez;
    @FRAME@
}

void update_animation(void)
{
    entity *other = animation_platform && self == &actors[0] ? self->landed_on_platform : NULL;
    int f;
    float move, movez;
    observe('F', self);
    if(frame_impulse && self == &actors[0]) frame_motion(self, 0);
    @PLATFORM_ANIMATION@
}

@POST@
@ARRANGE@
@UPDATE@

static void reset(void)
{
    time = 100;
    level = &scene;
    self = &actors[0];
    memset(actors, 0, sizeof(actors));
    for(unsigned i = 0; i < 3; ++i)
    {
        actors[i].exists = 1;
        actors[i].animation = &animation;
        actors[i].modeldata.animation = animations;
        actors[i].direction = 1;
        actors[i].takeaction = take_action;
        actors[i].think = think;
        entities[i] = &actors[i];
    }
    actors[0].xdir = 4;
    actors[0].zdir = 2;
    ent_count = ent_max = 1;
    events = 0;
    trace[0] = 0;
    movement_policy = frame_impulse = animation_platform = 0;
    animation.move = horizontal;
    animation.movez = depth;
    animation.platform = platform_boxes;
    animation.numframes = 2;
}

static void platform_scenario(void)
{
    ent_count = ent_max = 2;
    actors[0].landed_on_platform = &actors[1];
    actors[1].xdir = 8;
    actors[1].zdir = -2;
    actors[1].nextanim = time;
    actors[1].animating = 1;
    animation_platform = 1;
}

static void check(unsigned scenario)
{
    reset();
    switch(scenario)
    {
    case 0: frame_impulse = 1; break;
    case 1: frame_impulse = 1; actors[0].nextmove = time + 1; break;
    case 2: actors[0].frozen = 1; actors[0].freezetime = time + 1; break;
    case 3: actors[0].link = &actors[1]; actors[0].trymove = try_move; break;
    case 4: case 5:
        ent_count = ent_max = 2;
        actors[0].grabbing = actors[0].link = &actors[1];
        actors[1].link = &actors[0];
        actors[0].grabwalking = scenario == 4;
        actors[0].trymove = actors[1].trymove = try_move;
        break;
    case 6:
        actors[0].trymove = try_move;
        actors[0].idling = 1;
        movement_policy = 1;
        break;
    case 7: platform_scenario(); break;
    case 8:
        platform_scenario();
        actors[0].frozen = 1;
        actors[0].freezetime = time + 1;
        break;
    case 9:
        platform_scenario();
        entities[0] = &actors[1];
        entities[1] = &actors[0];
        break;
    case 10:
        ent_count = 2;
        ent_max = 3;
        actors[1].exists = 0;
        actors[2].bound = &actors[0];
        actors[2].xdir = -4;
        break;
    case 11: actors[0].nextthink = time + 10; break;
    case 12:
        actors[0].trymove = try_move;
        actors[0].idling = 1;
        movement_policy = 2;
        break;
    case 13:
        actors[0].timestamp = time;
        actors[0].movex = 3;
        actors[0].movez = -1;
        break;
    }

    update_ents();
    printf("{\"case\":%u,\"calls\":\"%s\",\"count\":%d,\"actors\":[", scenario, trace, ent_max);
    for(unsigned i = 0; i < 3; ++i)
    {
        entity *e = &actors[i];
        printf("%s[%.4f,%.4f,%.4f,%.4f,%u,%u,%u,%d]", i ? "," : "",
               e->x, e->z, e->movex, e->movez, e->nextmove, e->nextthink,
               (unsigned)e->update_mark, (int)e->pathblocked);
    }
    printf("],\"first\":%td,\"second\":%td}\n", entities[0] - actors, entities[1] - actors);
}

int main(void)
{
    obor_profile_build = @REVISION@;
    for(unsigned scenario = 0; scenario < 14; ++scenario) check(scenario);
    return 0;
}
