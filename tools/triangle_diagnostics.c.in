#include <assert.h>
#include <limits.h>
#include <stdarg.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#include "source/scriptlib/ScriptVariant.h"
#undef printf
#undef assert
#define assert(c) do {if(!(c)){fprintf(stderr,"triangle diagnostic profile=%u line=%d: %s\n",obor_profile_build,__LINE__,#c);abort();}}while(0)
_Static_assert(sizeof(LONG)==4 && (LONG)-1<0,"Native signed32 script integers required");
uint32_t obor_profile_build;
static const unsigned profiles[]={@PROFILES@};
@STORAGE@
#define TYPE_MATCH(kind) (@TYPE_MATCH@)
static char diagnostic[1024];
static unsigned captured,calls;
static void capture(const char *format,...) __attribute__((format(printf,1,2)));
static void capture(const char *format,...) {
    va_list args;va_start(args,format);
    int length=vsnprintf(diagnostic,sizeof(diagnostic),format,args);
    va_end(args);assert(length>=0 && (size_t)length<sizeof(diagnostic));++captured;
}
@CONVERTER@
#define printf capture
@CALLBACKS@
#undef printf
static void reset(ScriptVariant *result,ScriptVariant **out) {
    result->vt=VT_INTEGER;result->lVal=1234;*out=result;
    diagnostic[0]=0;captured=0;
}
static void outcome(HRESULT status,HRESULT expected,ScriptVariant *result,ScriptVariant *out,const char *text) {
    assert(status==expected && !out && result->vt==VT_INTEGER && result->lVal==1234);
    assert(captured==(text[0]?1u:0u) && !strcmp(diagnostic,text));++calls;
}
static void check(void) {
    ScriptVariant values[5],result={0},*out,*args[5];
    memset(values,0,sizeof(values));
    for(int i=0;i<5;++i){values[i].vt=VT_INTEGER;args[i]=values+i;}
    values[1].lVal=3;values[2].lVal=-4;values[3].lVal=5;values[4].lVal=-6;
    memset(verts,0,sizeof(verts));
    static const LONG invalid_vertex[]={-1,INT_MIN,INT_MAX,vert_buf_size};
    for(unsigned i=0;i<sizeof(invalid_vertex)/sizeof(*invalid_vertex);++i) {
        unsigned char before[sizeof(verts)];memcpy(before,verts,sizeof(before));
        char expected[256];values[0].lVal=invalid_vertex[i];reset(&result,&out);
        snprintf(expected,sizeof(expected),
                 "Index out of range in function setvertext: range from 0 to %d, %ld is given.\n",
                 vert_buf_size-1,(long)invalid_vertex[i]);
        HRESULT status=openbor_setvertex(args,&out,5);
        outcome(status,E_FAIL,&result,out,expected);assert(!memcmp(before,verts,sizeof(before)));
    }
    for(int i=0;i<2;++i) {
        unsigned char before[sizeof(verts)];memcpy(before,verts,sizeof(before));
        int index=i?vert_buf_size-1:0;values[0].lVal=index;reset(&result,&out);
        HRESULT status=openbor_setvertex(args,&out,5);
        outcome(status,S_OK,&result,out,"");
        assert(verts[index].x==3 && verts[index].y==-4 && verts[index].tx==5 && verts[index].ty==-6);
        for(int k=0;k<vert_buf_size;++k)if(k!=index)
            assert(!memcmp(before+(size_t)k*sizeof(*verts),verts+k,sizeof(*verts)));
    }
    for(int wrong_type=0;wrong_type<2;++wrong_type) {
        unsigned char before[sizeof(verts)];memcpy(before,verts,sizeof(before));
        values[2].vt=wrong_type?VT_EMPTY:VT_INTEGER;reset(&result,&out);
        HRESULT status=openbor_setvertex(args,&out,wrong_type?5:4);
        outcome(status,E_FAIL,&result,out,"Function requires 5 integer values: setvertex(index, x, y, tx, ty)\n");
        assert(!memcmp(before,verts,sizeof(before)));
    }
    s_screen screen={0};s_bitmap bitmap={0};s_sprite sprite={0};
    void *handles[]={&screen,&bitmap,&sprite};
    values[0].vt=VT_PTR;values[1].vt=VT_INTEGER;
    for(int type=0;type<3;++type) {
        values[0].ptrVal=handles[type];values[1].lVal=type;reset(&result,&out);
        HRESULT status=openbor_settexture(args,&out,2);outcome(status,S_OK,&result,out,"");
        if(type==0)assert(TYPE_MATCH(gfx_screen) && texture.screen==&screen);
        if(type==1)assert(TYPE_MATCH(gfx_bitmap) && texture.bitmap==&bitmap);
        if(type==2)assert(TYPE_MATCH(gfx_sprite) && texture.sprite==&sprite);
    }
    static const LONG invalid_texture[]={-1,3,INT_MIN,INT_MAX};
    for(unsigned i=0;i<sizeof(invalid_texture)/sizeof(*invalid_texture);++i) {
        unsigned char before[sizeof(texture)];memcpy(before,&texture,sizeof(before));
        char expected[128];values[1].lVal=invalid_texture[i];reset(&result,&out);
        snprintf(expected,sizeof(expected),"Invalid texture type for function settexture: %ld\n",(long)invalid_texture[i]);
        HRESULT status=openbor_settexture(args,&out,2);outcome(status,E_FAIL,&result,out,expected);
        assert(!memcmp(before,&texture,sizeof(before)));
    }
    for(int wrong_type=0;wrong_type<2;++wrong_type) {
        unsigned char before[sizeof(texture)];memcpy(before,&texture,sizeof(before));
        values[1].vt=wrong_type?VT_EMPTY:VT_INTEGER;reset(&result,&out);
        HRESULT status=openbor_settexture(args,&out,wrong_type?2:1);
        outcome(status,E_FAIL,&result,out,"Function requires a valid texture handle and a integer values: settexture(handle, type)\n");
        assert(!memcmp(before,&texture,sizeof(before)));
    }
}
int main(void) {
    for(unsigned i=0;i<sizeof(profiles)/sizeof(*profiles);++i) {
        obor_profile_build=profiles[i];check();
    }
    printf("{\"profiles\":%u,\"calls\":%u}\n",(unsigned)(sizeof(profiles)/sizeof(*profiles)),calls);
    return 0;
}
