#include <stdint.h>
#include <stdio.h>
#include <strings.h>
#include "openbor.h"
#include "commands.h"
#undef printf
#include <assert.h>

#ifndef stricmp
#define stricmp strcasecmp
#endif

uint32_t obor_profile_build;

HRESULT Interpreter_Call(Interpreter *interpreter) { (void)interpreter; abort(); }
HRESULT Interpreter_EvalInstruction(Interpreter *interpreter) { (void)interpreter; abort(); }
CHAR *StrCache_GetIfPresent(int index) { (void)index; return NULL; }
void StrCache_Collect(int index) { (void)index; abort(); }
int StrCache_Pop(void) { abort(); }

void *checkAlloc(void *pointer, size_t bytes, const char *function, const char *file, int line)
{
    if (!pointer && bytes) abort();
    return pointer;
}

static int obor_resolve_entity_property(LONG ordinal) { return ordinal; }
int mapstrings_entityproperty(ScriptVariant **args, int count) { (void)args; (void)count; return 1; }

@ENUMS@
@VARIANT@
@GETTER@
@COST_HELPER@
@SETTER@

static void apply_directive(s_anim *newanim, int cmd, int a, int b, int c, const char *frame_word)
{
    const int values[] = {0, a, b, c};
#undef GET_ARG
#undef GET_INT_ARG
#define GET_ARG(index) (frame_word)
#define GET_INT_ARG(index) (values[index])
    switch(cmd)
    {
        @DIRECTIVES@
        default: abort();
    }
#undef GET_ARG
#undef GET_INT_ARG
}

static const int fields[] = {_ep_energycost_cost, _ep_energycost_disable, _ep_energycost_mponly};

static LONG read_property(entity *actor, int property, int subproperty)
{
    ScriptVariant values[4] = {0};
    ScriptVariant *args[] = {values, values+1, values+2, values+3};
    ScriptVariant result = {.vt = VT_INTEGER, .lVal = 999}, *output = &result;
    values[0].vt = VT_PTR;
    values[0].ptrVal = actor;
    values[1].vt = values[2].vt = values[3].vt = VT_INTEGER;
    values[1].lVal = property;
    values[2].lVal = subproperty;
    assert(openbor_getentityproperty(args, &output, property == _ep_dropframe ? 3 : 4) == S_OK);
    assert(output == &result && result.vt == VT_INTEGER);
    return result.lVal;
}

static void write_cost(entity *actor, int field, LONG input)
{
    ScriptVariant values[5] = {0};
    ScriptVariant *args[] = {values, values+1, values+2, values+3, values+4};
    ScriptVariant result = {0}, *output = &result;
    values[0].vt = VT_PTR;
    values[0].ptrVal = actor;
    values[1].vt = values[2].vt = values[3].vt = values[4].vt = VT_INTEGER;
    values[1].lVal = _ep_energycost;
    values[2].lVal = field;
    values[4].lVal = input;
    assert(openbor_changeentityproperty(args, &output, 5) == S_OK);
    assert(output == NULL);
}

static void print_costs(entity *actor)
{
    for(size_t field = 0; field < sizeof(fields) / sizeof(fields[0]); ++field)
        printf(",%ld", (long)read_property(actor, _ep_energycost, fields[field]));
}

int main(void)
{
    static const unsigned revisions[] = {@REVISIONS@};
    static const int initial_writes[] = {16, -3, 2};
    static const int declared_writes[] = {8, -4, 0};
    static entity actor;
    static s_anim animation;
    static s_anim *animations[] = {&animation};
    actor.modeldata.animation = animations;
    actor.modeldata.animation_capacity = 1;
    animation.numframes = 8;
    for(size_t p = 0; p < sizeof(revisions) / sizeof(revisions[0]); ++p)
    {
        obor_profile_build = revisions[p];
        printf("[%u,[%ld", revisions[p], (long)read_property(&actor, _ep_dropframe, 0));
        print_costs(&actor);
        for(size_t field = 0; field < sizeof(fields) / sizeof(fields[0]); ++field)
        {
            write_cost(&actor, fields[field], initial_writes[field]);
            print_costs(&actor);
            free(animation.energycost);
            animation.energycost = NULL;
        }
        apply_directive(&animation, CMD_MODEL_ENERGYCOST, 12, 1, -2, "");
        print_costs(&actor);
        for(size_t field = 0; field < sizeof(fields) / sizeof(fields[0]); ++field)
            write_cost(&actor, fields[field], declared_writes[field]);
        print_costs(&actor);
        free(animation.energycost);
        animation.energycost = NULL;

        apply_directive(&animation, CMD_MODEL_MPONLY, 2, 0, 0, "");
        print_costs(&actor);
        apply_directive(&animation, CMD_MODEL_MPCOST, 4, 1, 0, "");
        print_costs(&actor);
        free(animation.energycost);
        animation.energycost = NULL;

        apply_directive(&animation, CMD_MODEL_DROPFRAME, 4, 0, 0, "");
        printf(",%ld", (long)read_property(&actor, _ep_dropframe, 0));
        free(animation.dropframe);
        animation.dropframe = NULL;
        apply_directive(&animation, CMD_MODEL_DROPFRAME, 0, 0, 0, "this");
        printf(",%ld]]\n", (long)read_property(&actor, _ep_dropframe, 0));
        free(animation.dropframe);
        animation.dropframe = NULL;
    }
    return 0;
}
