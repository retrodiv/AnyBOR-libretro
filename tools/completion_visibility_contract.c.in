#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <stdarg.h>
#include <setjmp.h>
#include <ctype.h>
#include "openbor.h"
#include "commands.h"
#undef printf
uint32_t obor_profile_build;
void *checkAlloc(void *p,size_t n,const char *fn,const char *file,int line){(void)fn;(void)file;(void)line;if(n && !p)abort();return p;}
#undef malloc
#undef free
HRESULT Interpreter_Call(Interpreter *p){(void)p;abort();}
HRESULT Interpreter_EvalInstruction(Interpreter *p){(void)p;abort();}
void borExit(int status){(void)status;abort();}
#include "List.c"
#undef assert
static unsigned active_case;
#define assert(c) do{if(!(c)){fprintf(stderr,"COMPLETION revision=%u case=%u line=%d: %s\n",obor_profile_build,active_case,__LINE__,#c);abort();}}while(0)
#ifndef stricmp
#define stricmp strcasecmp
#endif
#undef NAME
#define NAME(s) strdup(s)
static char diagnostic[4096];
static jmp_buf stopped;
static int message(const char *format,...)
{
    size_t used=strlen(diagnostic);va_list args;va_start(args,format);
    int result=vsnprintf(diagnostic+used,sizeof(diagnostic)-used,format,args);va_end(args);
    assert(result>=0 && (size_t)result<sizeof(diagnostic)-used);return result;
}
void shutdown(int status,char *format,...)
{
    assert(status==1);size_t used=strlen(diagnostic);va_list args;va_start(args,format);
    int count=vsnprintf(diagnostic+used,sizeof(diagnostic)-used,format,args);va_end(args);
    assert(count>=0 && (size_t)count<sizeof(diagnostic)-used);longjmp(stopped,1);
}
s_set_entry *levelsets;
s_savelevel *savelevel;
s_player player[MAX_PLAYERS];
int num_difficulties,defaultmaxplayers=2,current_stage,current_level;
char branch_name[MAX_NAME_LEN+1];
static unsigned observed_line,show_calls;
static int shown_stage;
static List *ordercmdlist;
void showcomplete(int num)
{
    assert(num==8 && current_stage==8);show_calls++;shown_stage=num;
    for(int i=0;i<MAX_PLAYERS;i++)assert(player[i].spawnhealth==11+i && player[i].spawnmp==21+i);
}
#define printf message
@PARSER@
@METHODS@
static void order_sequence(const char *input)
{
    @DEFAULT_ERROR@
    @CHKDEF@
    char filename[128]="data/levels.txt",*buf=strdup(input),*command,*errormessage=NULL;
    int line=0,pos=0;size_t size=strlen(input);s_set_entry *set=NULL;s_level_entry *le=NULL;
    ArgList arglist;char argbuf[MAX_ARG_LEN+1]={0};levelOrderCommands cmd;
    assert(buf);
    while(pos<size){
        line++;observed_line=line;ParseArgs(&arglist,buf+pos,argbuf);command=GET_ARG(0);
        cmd=getLevelOrderCommand(ordercmdlist,command);
        switch(cmd){@ARMS@ default:@DEFAULT@}
        assert(le==NULL);
        pos+=getNewLineStart(buf+pos);
    }
    @NO_SET@
    @CLEANUP@
#undef CHKDEF
static int run_order(const char *input)
{
    if(setjmp(stopped))return 0;
    order_sequence(input);return 1;
}
static void advance(s_set_entry *set,int gonext,s_savelevel *save)
{
    s_level_entry entries[2]={{0},{0}};int i;
    entries[0].gonext=gonext;set->numlevels=2;set->levelorder=entries;
    s_level_entry *le=entries;
    @COMPLETION@
    assert(le==entries+1);set->levelorder=NULL;
}
#undef printf
static const struct {unsigned revision;int epoch;} contexts[]={@CONTEXTS@};
static const struct {int kind;const char *text;int p[3];} cases[]={@CASES@};
static const struct {const char *diagnostic;unsigned count;int values[16],compare[16];} expected[][2]={@EXPECTATIONS@};
static void retire(void)
{
    for(int i=0;i<num_difficulties;i++)free(levelsets[i].name);
    free(levelsets);free(savelevel);levelsets=NULL;savelevel=NULL;num_difficulties=0;
}
static void check_values(const int *values,unsigned count,int epoch)
{
    assert(expected[active_case][epoch].count==count);
    assert(!strcmp(diagnostic,expected[active_case][epoch].diagnostic));
    for(unsigned i=0;i<count;i++)if(expected[active_case][epoch].compare[i]){
        if(values[i]!=expected[active_case][epoch].values[i])
            fprintf(stderr,"COMPLETION field=%u actual=%d expected=%d\n",i,values[i],expected[active_case][epoch].values[i]);
        assert(values[i]==expected[active_case][epoch].values[i]);
    }
}
int main(void)
{
    for(unsigned context=0;context<sizeof(contexts)/sizeof(*contexts);context++){
        obor_profile_build=contexts[context].revision;int epoch=contexts[context].epoch;
        ordercmdlist=createLevelOrderCommandList();assert(ordercmdlist);
        char name[]="NoShowComplete",set_name[]="set";
        assert(getLevelOrderCommand(ordercmdlist,name)==(epoch?CMD_LEVELORDER_NOSHOWCOMPLETE:0));
        assert(getLevelOrderCommand(ordercmdlist,set_name)==CMD_LEVELORDER_SET);
        for(defaultmaxplayers=1;defaultmaxplayers<=MAX_PLAYERS;defaultmaxplayers++){
            s_set_entry *first=add_set();assert(first && first->maxplayers==defaultmaxplayers);
            if(epoch){assert(first->noshowcomplete==0);first->noshowcomplete=17;}
            first->saveflag=7;s_set_entry *second=add_set();
            assert(second && second->maxplayers==defaultmaxplayers && second->saveflag==0);
            assert(levelsets[0].saveflag==7);if(epoch)assert(second->noshowcomplete==0 && levelsets[0].noshowcomplete==17);
            retire();
        }
        defaultmaxplayers=2;
        for(active_case=0;active_case<sizeof(cases)/sizeof(*cases);active_case++){
            diagnostic[0]=0;observed_line=0;strcpy(branch_name,"kept");
            if(cases[active_case].kind==0){
                int status=run_order(cases[active_case].text);
                s_set_entry *set=num_difficulties?levelsets+num_difficulties-1:NULL;
                int values[]={status,num_difficulties,set?set->noshowcomplete:0,set?set->saveflag:0,
                    set?set->ifcomplete:0,set?set->maxplayers:0,branch_name[0]==0,(int)observed_line};
                check_values(values,sizeof(values)/sizeof(*values),epoch);
            }else{
                const int *p=cases[active_case].p;s_set_entry *set=add_set();
                set->noshowcomplete=p[0];set->maxplayers=p[2];show_calls=0;shown_stage=-1;
                current_stage=8;current_level=0;s_savelevel save={0};save.stage=4;save.level=5;
                for(int i=0;i<MAX_PLAYERS;i++){player[i].spawnhealth=11+i;player[i].spawnmp=21+i;}
                advance(set,p[1],&save);
                int values[]={(int)show_calls,shown_stage,current_stage,(int)save.stage,current_level,(int)save.level,
                    player[0].spawnhealth,player[0].spawnmp,player[1].spawnhealth,player[1].spawnmp,
                    player[2].spawnhealth,player[2].spawnmp,player[3].spawnhealth,player[3].spawnmp};
                check_values(values,sizeof(values)/sizeof(*values),epoch);
            }
            retire();
        }
        freeCommandList(ordercmdlist);printf("{\"revision\":%u,\"status\":\"PASS\"}\n",obor_profile_build);
    }
    return 0;
}
