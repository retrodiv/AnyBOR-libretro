#define assert(c) do{if(!(c)){fprintf(stderr,"SYSTEM_VARIABLES revision=%u case=%u name=%s line=%d: %s\n",obor_profile_build,active_case,active_name?active_name:"?",__LINE__,#c);abort();}}while(0)
HRESULT Interpreter_Call(Interpreter *p){(void)p;abort();}
HRESULT Interpreter_EvalInstruction(Interpreter *p){(void)p;abort();}
static char strings[32][256],diagnostic[4096];
static unsigned references[32];
int StrCache_Pop(void){for(int i=0;i<32;i++)if(!references[i]){references[i]=1;strings[i][0]=0;return i;}abort();}
void StrCache_Collect(int i){assert(i>=0 && i<32 && references[i]);--references[i];}
void StrCache_Grab(int i){assert(i>=0 && i<32 && references[i]);++references[i];}
CHAR *StrCache_Get(int i){assert(i>=0 && i<32 && references[i]);return strings[i];}
CHAR *StrCache_GetIfPresent(int i){return i>=0 && i<32 && references[i]?strings[i]:NULL;}
void StrCache_Copy(int i,CHAR *text){assert(strlen(text)<sizeof(strings[i]));strcpy(StrCache_Get(i),text);}
static int message(const char *format,...){size_t used=strlen(diagnostic);va_list args;va_start(args,format);int n=vsnprintf(diagnostic+used,sizeof(diagnostic)-used,format,args);va_end(args);assert(n>=0 && (size_t)n<sizeof(diagnostic)-used);return n;}
