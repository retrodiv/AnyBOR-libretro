#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef printf
#undef assert
#ifdef NDEBUG
#error Seed-script checks must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do {if(!(c)){fprintf(stderr,"Seed script revision=%u case=%u line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
HRESULT Interpreter_Call(Interpreter *p) {(void)p;abort();}
HRESULT Interpreter_EvalInstruction(Interpreter *p) {(void)p;abort();}
int StrCache_Pop(void) {abort();}
void StrCache_Collect(int n) {(void)n;abort();}
@VARIANTS@
static unsigned seed_calls,draw_calls;
static unsigned long seed_argument;
static unsigned returned_value;
void srand32(unsigned long n) {++seed_calls;seed_argument=n;}
unsigned int rand32(void) {++draw_calls;return returned_value;}
@CALLBACK@
static unsigned unused_calls[@SYMBOL_COUNT@];
@STUBS@
List theFunctionList;
static struct {void *callback;const char *name;} registry[512];
static unsigned entries,resets;
void List_Reset(List *list) {assert(list==&theFunctionList);entries=0;++resets;}
void List_InsertAfter(List *list,void *callback,const char *name)
{
    assert(list==&theFunctionList && callback && name && entries<512);
    for(unsigned i=0;i<entries;++i)assert(strcmp(name,registry[i].name));
    registry[entries].callback=callback;registry[entries++].name=name;
}
static void *lookup(const char *name)
{
    for(unsigned i=0;i<entries;++i)if(!strcmp(name,registry[i].name))return registry[i].callback;
    return NULL;
}
@METHODS@
static const struct {unsigned revision;int registered;} contexts[]={@CONTEXTS@};
static const struct {VARTYPE type;double value;int converts,integer;} inputs[]={@INPUTS@};
static const unsigned results[]={@RESULTS@};
int main(void)
{
    assert(sizeof(LONG)==4);
    for(unsigned p=0;p<sizeof(contexts)/sizeof(contexts[0]);++p)
    {
        obor_profile_build=contexts[p].revision;active_case=1;Script_LoadSystemFunctions();
        assert(resets==p+1 && entries>8);
        assert(lookup("srand")== (contexts[p].registered?(void *)system_srand:NULL));
        assert(!strcmp(Script_GetFunctionName((void *)system_srand),contexts[p].registered?"srand":"<unknown function>"));
        if(contexts[p].registered)
        for(unsigned i=0;i<sizeof(inputs)/sizeof(inputs[0]);++i)
        for(unsigned v=0;v<sizeof(results)/sizeof(results[0]);++v)
        for(int count=0;count<3;++count)
        {
            ScriptVariant arg={0},extra={0},output={0},*ret=&output;
            ScriptVariant *varlist[]={&arg,&extra};arg.vt=inputs[i].type;
            if(arg.vt==VT_DECIMAL)arg.dblVal=inputs[i].value;else arg.lVal=(LONG)inputs[i].value;
            extra.vt=VT_INTEGER;extra.lVal=77;output.vt=VT_INTEGER;output.lVal=17;
            returned_value=results[v];seed_calls=draw_calls=0;seed_argument=19;++active_case;
            HRESULT status=system_srand(varlist,&ret,count);assert(ret==&output);
            if(count==0)
            {assert(status==E_FAIL && output.vt==VT_EMPTY && !output.ptrVal && !seed_calls && !draw_calls);}
            else
            {
                LONG expected;memcpy(&expected,&returned_value,sizeof(expected));
                assert(status==(inputs[i].converts?S_OK:E_FAIL));
                assert(output.vt==VT_INTEGER && output.lVal==expected && draw_calls==1);
                assert(seed_calls==(unsigned)inputs[i].converts);
                assert(seed_argument==(inputs[i].converts?(unsigned long)(LONG)inputs[i].integer:19ul));
            }
            assert(arg.vt==inputs[i].type && extra.vt==VT_INTEGER && extra.lVal==77);
        }
        for(unsigned i=0;i<sizeof(unused_calls)/sizeof(unused_calls[0]);++i)assert(!unused_calls[i]);
        printf("{\"revision\":%u,\"cases\":%u,\"status\":\"PASS\"}\n",obor_profile_build,active_case);
    }
    return 0;
}
