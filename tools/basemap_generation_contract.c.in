#include <limits.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "source/scriptlib/depends.h"
#undef calloc
#undef realloc
#undef free
#undef printf

@VARIANT_TYPES@
@TYPES@
static struct { int numbasemaps; s_basemap *basemaps; void *obor_arrays; } level_data, *level = &level_data;
enum { OBOR_LEVEL_ARRAY_BASEMAP };
static int obor_level_grow_array(void *record, int id, int count)
{
    (void)record; (void)id; (void)count;
    abort();
}
uint32_t obor_profile_build;
static struct { float *cells; size_t bytes; } recorded[4];
static unsigned allocations;

static void *allocate_grid(size_t count, size_t size)
{
    if(allocations >= sizeof(recorded) / sizeof(*recorded) ||
       (size && count > 512 / size)) abort();
    float *cells = calloc(count, size);
    recorded[allocations].cells = cells;
    recorded[allocations++].bytes = count * size;
    return cells;
}

static size_t obor_allocation_size(const void *map)
{
    if(!map) return 0;
    for(unsigned i = 0; i < allocations; ++i)
        if(recorded[i].cells == map) return recorded[i].bytes;
    abort();
}

@VARIANTS@
#define calloc allocate_grid
@GENERATOR@
@SCRIPT@
#undef calloc

static const struct {
    int route, index, continuation, existing, argc, text_optional;
    double parameters[6];
} cases[] = { @CASES@ };
static const unsigned revisions[] = { @REVISIONS@ };

int main(void)
{
    for(size_t r = 0; r < sizeof(revisions) / sizeof(*revisions); ++r)
    {
        obor_profile_build = revisions[r];
        for(size_t i = 0; i < sizeof(cases) / sizeof(*cases); ++i)
        {
            const double *p = cases[i].parameters;
            int status = S_OK;
            ScriptVariant args[8] = {0}, result = {0}, *out = &result;
            ScriptVariant *slots[8];
            result.vt = VT_INTEGER;
            result.lVal = -23;
            allocations = 0;
            level->numbasemaps = 2;
            level->basemaps = calloc(2, sizeof(*level->basemaps));
            if(!level->basemaps) abort();
            if(cases[i].existing)
            {
                float *cells = allocate_grid(cases[i].existing, sizeof(*cells));
                for(int k = 0; k < cases[i].existing; ++k) cells[k] = -7.0f;
                level->basemaps[1].map = cells;
            }
            switch(cases[i].route)
            {
            case 0:
                generate_basemap(cases[i].index, p[0], p[1], p[2], p[3], p[4], p[5], cases[i].continuation);
                break;
            case 1:
                addbasemap(p[0], p[1], p[2], p[3], p[4], p[5], cases[i].continuation);
                break;
            case 2:
                for(int k = 0; k < 8; ++k)
                {
                    slots[k] = &args[k];
                    args[k].vt = VT_DECIMAL;
                }
                args[0].dblVal = cases[i].index;
                for(int k = 0; k < 6; ++k) args[k + 1].dblVal = p[k];
                args[7].dblVal = cases[i].continuation;
                if(cases[i].text_optional) args[7].vt = VT_STR;
                status = openbor_generatebasemap(slots, &out, cases[i].argc);
                break;
            default:
                abort();
            }
            printf("{\"revision\":%u,\"status\":%d,\"null_result\":%d,\"marker\":%d,\"maps\":[",
                   obor_profile_build, status, out == NULL, (int)result.lVal);
            for(int k = 0; k < level->numbasemaps; ++k)
            {
                const s_basemap *map = &level->basemaps[k];
                const size_t bytes = obor_allocation_size(map->map);
                printf("%s{\"bounds\":[%d,%d,%d,%d],\"bytes\":%zu,\"cells\":[", k ? "," : "",
                       map->position.x, map->position.z, map->size.x, map->size.z, bytes);
                for(size_t c = 0; c < bytes / sizeof(float); ++c)
                    printf("%s\"%a\"", c ? "," : "", (double)map->map[c]);
                printf("]}");
            }
            printf("]}\n");
            for(unsigned k = 0; k < allocations; ++k) free(recorded[k].cells);
            free(level->basemaps);
        }
    }
}
