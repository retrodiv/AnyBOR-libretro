@PREFIX@
static unsigned otg_input_index;
static int otg_route,otg_grounded;
#undef assert
#define assert(c) do {if(!(c)){fprintf(stderr,"OTG revision=%u input=%u route=%d grounded=%d line=%d\n",obor_profile_build,otg_input_index,otg_route,otg_grounded,__LINE__);abort();}}while(0)
int StrCache_Pop(void) {abort();}
void StrCache_Collect(int slot) {(void)slot;abort();}
CHAR *StrCache_Get(int slot) {(void)slot;abort();}
@VARIANTS@
@HELPERS@
@DEFAULT@
enum {CMD_MODEL_OTG,_ep_attack_otg};
static void directive(int value)
{
    char number[32];snprintf(number,sizeof(number),"%d",value);
    ArgList arglist={0};arglist.count=2;arglist.args[0]="otg";arglist.args[1]=number;
    char *filename="fixture",*command="otg";
    switch(CMD_MODEL_OTG) {@DIRECTIVE@}
}
static void setter(double value,int integral)
{
    ScriptVariant input={.vt=VT_DECIMAL};DOUBLE dbltemp;
    if(integral){input.vt=VT_INTEGER;input.lVal=(LONG)value;}else input.dblVal=value;
    assert(SUCCEEDED(ScriptVariant_DecimalValue(&input,&dbltemp)));
    switch(_ep_attack_otg) {@SETTER@}
}
static LONG getter(s_attack *attack)
{
    ScriptVariant result={.vt=VT_EMPTY},*value=&result,**pretvar=&value;
    switch(_ep_attack_otg) {@GETTER@}
    assert(value==&result && result.vt==VT_INTEGER);return result.lVal;
}
static const struct {unsigned revision;int signed_otg;} otg_contexts[]={@CONTEXTS@};
static const struct {
    double value;int stored,signed_hits[2],enum_hits[2];
    long long getter32,signed_getter64,enum_getter64;
} otg_inputs[]={@INPUTS@};
static const int hit_trace[]={@HIT_TRACE@};
int main(void)
{
    assert(sizeof(e_otg)==4 && (sizeof(LONG)==4 || sizeof(LONG)==8));
    active_case=@CONTACT_CASE@;
    for(unsigned p=0;p<sizeof(otg_contexts)/sizeof(otg_contexts[0]);++p)
    {
        obor_profile_build=otg_contexts[p].revision;unsigned checked=1;
        assert(emptyattack.otg==0);
        for(otg_input_index=0;otg_input_index<sizeof(otg_inputs)/sizeof(otg_inputs[0]);++otg_input_index)
        for(otg_route=0;otg_route<3;++otg_route)
        for(otg_grounded=0;otg_grounded<2;++otg_grounded)
        {
            double value=otg_inputs[otg_input_index].value;
            if(otg_route!=1 && value!=(int)value)continue;
            ++checked;memset(actors,0,sizeof(actors));memset(&animation,0,sizeof(animation));
            memset(animations,0,sizeof(animations));memset(defenses,0,sizeof(defenses));
            attack=emptyattack;memset(&lasthit,0,sizeof(lasthit));
            if(otg_route==0)directive((int)value);else setter(value,otg_route==2);
            assert((uint32_t)attack.otg==(uint32_t)otg_inputs[otg_input_index].stored);
            long long expected_getter=sizeof(LONG)==4?otg_inputs[otg_input_index].getter32:
                otg_contexts[p].signed_otg?otg_inputs[otg_input_index].signed_getter64:
                                          otg_inputs[otg_input_index].enum_getter64;
            assert((long long)getter(&attack)==expected_getter);
            trace_count=summary_sounds=summary_kills=0;savedata.effectvol=9;
            expected_type=0;attack.attack_type=0;attack.attack_force=12;attack.no_flash=1;attack.hitsound=2;
            actors[0].exists=1;actors[0].animation=&animation;actors[0].defense=defenses[0];
            actors[0].modeldata.type=TYPE_PLAYER;actors[0].modeldata.candamage=TYPE_ENEMY;
            actors[0].attack_id=17;actors[0].remove_on_attack=1;
            animation.numframes=1;animation.counterrange.frame.min=animation.counterrange.frame.max=-1;
            attacks[0]=&attack;animation.attacks=attacks;
            actors[1].exists=1;actors[1].health=100;actors[1].animation=&animation;
            actors[1].modeldata.type=TYPE_ENEMY;actors[1].modeldata.nopassiveblock=1;
            actors[1].modeldata.animation=animations[1];actors[1].modeldata.animation_capacity=MAX_ANIS+1;
            actors[1].defense=defenses[1];actors[1].takedamage=damage;
            actors[1].takeaction=otg_grounded?common_lie:NULL;
            entities[0]=&actors[1];ent_list=entities;ent_max=1;self=&actors[0];do_attack(&actors[0]);
            int hit=otg_contexts[p].signed_otg?otg_inputs[otg_input_index].signed_hits[otg_grounded]:
                                            otg_inputs[otg_input_index].enum_hits[otg_grounded];
            assert(self==&actors[0] && actors[1].hit_by_attack_id==(hit?17:0));
            assert(animation.animhits==hit && actors[0].rush.count.current==hit);
            assert(summary_sounds==hit && summary_kills==hit);
            assert(actors[0].lasthit==(hit?&actors[1]:NULL));
            assert(actors[0].combotime==(hit?fixture_clock+combodelay:0));
            assert(trace_count==(hit?(int)(sizeof(hit_trace)/sizeof(hit_trace[0])):0));
            for(int i=0;i<trace_count;++i)assert(trace[i]==hit_trace[i]);
        }
        printf("{\"revision\":%u,\"cases\":%u,\"status\":\"PASS\"}\n",obor_profile_build,checked);
    }
    return 0;
}
