 * Model the fields used by the native cache traversal. This probe checks
 * bounds and call order, not model ABI, pixels or allocator performance.
 */
#include <assert.h>
#include <stdio.h>
#include <stdlib.h>

#define MAX_PLAYERS @PLAYERS@
typedef struct { int numframes; int *sprite; } s_anim;
typedef struct {
    struct { int def, die, get, mphigh, mplow, mpmed, pain, weapon; } icon;
    int parrow[MAX_PLAYERS][2];
    s_anim **animation;
    int animation_capacity;
} s_model;
static unsigned int obor_profile_build;
static int max_animations, calls, sprite_ids[32], load_modes[32];
static void cachesprite(int id, int load)
{
    assert(calls < 32);
    sprite_ids[calls] = id;
    load_modes[calls++] = load;
}

@FUNCTION@

typedef struct { unsigned int revision; int load, unload; } context;
typedef struct { int capacity, global_limit, extra; } test_case;
static const context contexts[] = {@CONTEXTS@};
static const test_case cases[] = {@CASES@};

static void check(const context *ctx, const test_case *test, int load)
{
    s_model model = {.icon = {1,2,3,4,5,6,7,8}};
    int first_frames[] = {20,21}, last_frames[] = {22};
    s_anim first = {2,first_frames}, last = {1,last_frames};
    int expected[32], count = 0, i, enabled = load ? ctx->load : ctx->unload;
    obor_profile_build = ctx->revision;
    max_animations = test->global_limit;
    model.animation_capacity = test->capacity;
    for(i = 0; i < 8; ++i) expected[count++] = i + 1;
    for(i = 0; i < MAX_PLAYERS; ++i) {
        model.parrow[i][0] = i + 9;
        expected[count++] = i + 9;
    }
    if(test->capacity) {
        model.animation = calloc((size_t)test->capacity, sizeof(*model.animation));
        assert(model.animation);
        model.animation[0] = &first;
        expected[count++] = 20;
        expected[count++] = 21;
        if(test->extra) {
            assert(test->capacity > 1);
            model.animation[test->capacity - 1] = &last;
            expected[count++] = 22;
        }
    }
    calls = 0;
    cache_model_sprites(&model, load);
    assert(calls == (enabled ? count : 0));
    for(i = 0; i < calls; ++i) {
        assert(sprite_ids[i] == expected[i]);
        assert(load_modes[i] == load);
    }
    free(model.animation);
}

int main(void)
{
    size_t i, j;
    for(i = 0; i < sizeof(contexts)/sizeof(*contexts); ++i) {
        for(j = 0; j < sizeof(cases)/sizeof(*cases); ++j) {
            check(&contexts[i], &cases[j], 0);
            check(&contexts[i], &cases[j], 1);
        }
        printf("{\"revision\":%u,\"cases\":%lu}\n", contexts[i].revision,
               (unsigned long)(2 * sizeof(cases)/sizeof(*cases)));
    }
    return 0;
}
