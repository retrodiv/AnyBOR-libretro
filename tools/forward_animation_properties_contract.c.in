static const char *missing_roots[]={@MISSING_ROOTS@};
static const unsigned extra_counts[]={@EXTRA_COUNTS@};
static const struct{unsigned first;const char *property,*leaf;VARTYPE type;int search,zero_refusal,zero_get;const char *get_error,*set_error;double written;int absent_get,absent_set;} frame_properties[]={@FRAME_CASES@};
static void set_field(unsigned field,double value){switch(field){@SET_FIELD@ default:abort();}}
static double get_field(unsigned field){switch(field){@GET_FIELD@ default:abort();}}
