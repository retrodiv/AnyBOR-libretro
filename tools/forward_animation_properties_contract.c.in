static void unconsumed_model_cases(unsigned row,API change){
 const char *roots[]={"counterrange","dropframe","energycost","followup","jumpframe","landframe","loop","projectile","quakeframe","range","size","spawnframe","summonframe","weaponframe","attack"};
 for(unsigned root=0;root<sizeof(roots)/sizeof(*roots);++root)
  for(int write=0;write<=(contexts[row].binding==2);++write){
   active_case=6500+root;frame_setup();values[0].ptrVal=NULL;values[1].lVal=INT_MAX;
   text_value(values+2,2,roots[root]);values[3].vt=VT_INTEGER;values[3].lVal=999;
   values[4].vt=VT_DECIMAL;values[4].dblVal=NAN;
   struct record_state before;record_capture(&before);
   assert((write?change:openbor_getanimationproperty)(args,&out,write?5:4)==S_OK && !diagnostic[0]);
   result_value(VT_INTEGER,0);record_equal(&before);
  }
 for(int write=0;write<=(contexts[row].binding==2);++write){
  active_case=6520+write;frame_setup();values[0].ptrVal=(void*)(uintptr_t)1;values[1].lVal=INT_MAX;
  values[2].vt=VT_INTEGER;values[2].lVal=999;values[3].vt=VT_DECIMAL;values[3].dblVal=NAN;
  assert((write?change:openbor_getanimationproperty)(args,&out,write?4:3)==E_FAIL && out==NULL);
  assert(!strcmp(diagnostic,write?"Error: unsupported property in changeanimationproperty\n":"Error: unsupported property in getanimationproperty\n"));
  frame_setup();values[0].ptrVal=NULL;values[1].lVal=INT_MAX;
  text_value(values+2,2,"counterrange");values[3].vt=VT_DECIMAL;values[3].dblVal=1.25;
  values[4].vt=VT_DECIMAL;values[4].dblVal=NAN;
  assert((write?change:openbor_getanimationproperty)(args,&out,write?5:4)==E_FAIL);
  assert(!strcmp(diagnostic,write?"You must provide an animation ID and all properties: changeanimationproperty({ent}, {animation id}, 'counterrange', {sub-property}, {frame_index}, {value})\n":"You must provide an animation ID and all properties: getanimationproperty({ent}, {animation id}, 'counterrange', {sub-property})\n"));
 }
 fresh();
}
static void partial_cases(unsigned row){
 assert(List_FindByName(&theFunctionList,"getanimationproperty"));API get=(API)List_Retrieve(&theFunctionList);
 assert(get==openbor_getanimationproperty && !List_FindByName(&theFunctionList,"changeanimationproperty"));
 scalar_cases(row,get);owner_controls(row,get);frame_cases(row,get);fixed_cases(row,get);sprite_cases(row,get);
 record_cases(row,get);record_special_cases(row,get);numeric_cases(row,get);attack_search_controls();unconsumed_model_cases(row,get);
 active_case=6415;frame_setup();hit.dropv.x=17.25;text_value(values+2,2,"attack");text_value(values+3,3,"dropv");
 text_value(values+4,4,"velocity.x");values[5].vt=VT_INTEGER;values[5].lVal=1;
 assert(get(args,&out,6)==S_OK && values[4].vt==VT_INTEGER);result_value(VT_DECIMAL,17.25);expected_diagnostic(row,1,"");
 frame_setup();text_value(values+2,2,"attack");text_value(values+3,3,"dropv");
 values[4].vt=VT_DECIMAL;values[4].dblVal=1.25;values[5].vt=VT_INTEGER;values[5].lVal=1;
 assert(get(args,&out,6)==E_FAIL);
 expected_diagnostic(row,1,"You must provide an animation ID and all properties: getanimationproperty({ent}, {animation id}, 'attack', 'dropv', {subproperty}, {frame_index})\n");
 frame_setup();text_value(values+2,2,"attack");text_value(values+3,3,"dropv");
 values[4].vt=VT_INTEGER;values[4].lVal=0;values[5].vt=VT_DECIMAL;values[5].dblVal=1;
 assert(get(args,&out,6)==E_FAIL);
 expected_diagnostic(row,1,"You must provide an animation ID and all properties: getanimationproperty({ent}, {animation id}, 'dropv', {subproperty}, {frame_index})\n");
 if(!contexts[row].draw_full){
  active_case=6410;frame_setup();values[0].ptrVal=NULL;values[1].lVal=INT_MAX;text_value(values+2,2,"offset");
  assert(get(args,&out,3)==S_OK && !diagnostic[0]);result_value(VT_INTEGER,55);
  values[3].vt=VT_INTEGER;values[3].lVal=999;args[4]=NULL;
  assert(get(args,&out,5)==S_OK && !diagnostic[0]);result_value(VT_INTEGER,55);
 }
 fresh();
}
int main(void){
 assert(sizeof(properties)/sizeof(*properties)==13);
