static void set_frame_owner(unsigned field,void *value){switch(field){@SET_FRAME_OWNER@ default:abort();}}
static size_t frame_stride(unsigned field){switch(field){@FRAME_STRIDES@ default:abort();}}
static const struct{const char *property,*leaf;VARTYPE type;double written;} fixed_properties[]={@FIXED_CASES@};
