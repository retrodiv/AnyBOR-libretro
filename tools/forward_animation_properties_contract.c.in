static int delays[3],sounds[3],shadows[3],vulnerables[3],sprites[3];
static int boxes[3][6],offsets[3][2],shadow_xy[3][2];
static unsigned idles[3];static float platforms[3][8];
static s_axis_i movement[3],*movements[3];
static s_drawmethod drawing[3],*drawings[3];
static float fixed_spawn[5],fixed_summon[5];static int fixed_weapon[2];
static s_sprite_map sprite_entries[3];static s_sprite_list sprite_node;
static s_sprite sprite_pixels,replacement_pixels;
static char sprite_filename[16],unterminated_filename[4];
int sprite_map_max_items;unsigned int sprites_loaded;
static const void *short_owner;static size_t short_bytes;
static ScriptVariant values[16],result,*out,*args[16];
entity **ent_list;int ent_list_size;
static entity *pool[1];static s_anim_list registered[2];
@ACTOR_SCOPE@
/* Allocation extent is the only delegated owner service; registry lookup,
 * callback scopes and model-animation membership execute their real bodies. */
size_t obor_allocation_size(const void *value){
 if(short_owner && value==short_owner)return short_bytes;
 if(value==table)return sizeof(table);
 if(value==pool)return sizeof(pool);
 if(value==&target)return sizeof(target);
 if(value==&legacy)return sizeof(legacy);
 if(value==&hit || value==&second_hit)return sizeof(hit);
 if(value==attacks)return sizeof(attacks);
#define EXTENT(object) if(value==(object))return sizeof(object)
 EXTENT(delays);EXTENT(sounds);EXTENT(shadows);EXTENT(vulnerables);EXTENT(sprites);
 EXTENT(boxes);EXTENT(offsets);EXTENT(shadow_xy);EXTENT(idles);EXTENT(platforms);
 EXTENT(movements);EXTENT(drawings);
 EXTENT(fixed_spawn);EXTENT(fixed_summon);EXTENT(fixed_weapon);EXTENT(sprite_entries);
 EXTENT(sprite_filename);EXTENT(unterminated_filename);
#undef EXTENT
 if(value==&sprite_node)return sizeof(sprite_node);
 if(value==&sprite_pixels || value==&replacement_pixels)return sizeof(sprite_pixels);
 for(unsigned i=0;i<16;++i)if(value && value==texts[i])return (size_t)cache_entries[i].len+1;
 for(unsigned i=0;i<3;++i){
  if(value==movement+i)return sizeof(movement[i]);
  if(value==drawing+i)return sizeof(drawing[i]);
 }
 return 0;
}
