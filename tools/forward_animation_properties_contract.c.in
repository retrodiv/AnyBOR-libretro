@HEADER@
#undef printf
#undef assert

/* These consumer contracts observe successful delegated allocations.
 * Native wrapper outputs are covered by the separate compatibility suite. */
void *checkAlloc(void *pointer,size_t size,const char *function,const char *file,int line)
{
    (void)function; (void)file; (void)line;
    if(size && !pointer) abort();
    return pointer;
}
uint32_t obor_profile_build;
static unsigned active_case;
#define CHECK(c) do{if(!(c)){fprintf(stderr,"ANIMATION_PROPERTIES revision=%u case=%u line=%d: %s\n",obor_profile_build,active_case,__LINE__,#c);abort();}}while(0)
#define assert(c) CHECK(c)
HRESULT Interpreter_Call(Interpreter *v){(void)v;abort();}
HRESULT Interpreter_EvalInstruction(Interpreter *v){(void)v;abort();}
void borExit(int value){(void)value;abort();}
@LIST@
#undef assert
#define assert(c) CHECK(c)
#ifndef stricmp
#define stricmp strcasecmp
#endif
static const char *texts[16];static unsigned refs[16];
@CACHE_TYPE@
static Varstr cache_entries[16];Varstr *strcache=cache_entries;int strcache_size=16;
static char cache_output[16][128];
static char diagnostic[2048];
CHAR *StrCache_Get(int key){assert(key>=0 && key<16);return (CHAR*)texts[key];}
void StrCache_Collect(int key){assert(key>=0 && key<16 && refs[key]);--refs[key];}
int StrCache_Pop(void){
 for(int key=0;key<16;++key)if(!refs[key]){
  refs[key]=1;texts[key]=cache_output[key];cache_output[key][0]=0;
  cache_entries[key].str=(CHAR*)cache_output[key];cache_entries[key].len=127;return key;
 }
 abort();
}
void StrCache_Copy(int key,CHAR *text){
 assert(key>=0 && key<16 && refs[key] && texts[key]==cache_output[key] && text && strlen(text)<128);
 memmove(cache_output[key],text,strlen(text)+1);
}
static int message(const char *format,...){
 size_t size=strlen(diagnostic);va_list args;va_start(args,format);
 int n=vsnprintf(diagnostic+size,sizeof(diagnostic)-size,format,args);va_end(args);
 assert(n>=0 && (size_t)n<sizeof(diagnostic)-size);return n;
}
