#include <stdint.h>
#include <inttypes.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
static uint32_t obor_profile_build;
static char actual[512];static size_t used;
static int observed_printf(const char *format,...){
 va_list ap;va_start(ap,format);
 int n=vsnprintf(actual+used,sizeof(actual)-used,format,ap);va_end(ap);
 if(n<0 || (size_t)n>=sizeof(actual)-used){abort();}
 used+=(size_t)n;return n;
}
struct context{unsigned revision;int count_line;};
static const struct context contexts[]={@CONTEXTS@};
int main(void){
 for(unsigned p=0;p<sizeof(contexts)/sizeof(*contexts);++p){
  obor_profile_build=contexts[p].revision;
  uint64_t totalram=1000,freeram=400,usedram=600;int sprites_loaded=27;
  used=0;actual[0]=0;
#define printf observed_printf
  @DIAGNOSTIC@
#undef printf
  const char *expected=contexts[p].count_line?
   "Total Ram: 1000 Bytes\n Free Ram: 400 Bytes\n Used Ram: 600 Bytes\nTotal sprites mapped: 27\n\n":
   "Total Ram: 1000 Bytes\n Free Ram: 400 Bytes\n Used Ram: 600 Bytes\n\n";
  if(strcmp(actual,expected)){fprintf(stderr,"SPRITE_DIAGNOSTIC revision=%u\n",obor_profile_build);abort();}
  fprintf(stdout,"{\"revision\":%u,\"diagnostic\":\"PASS\"}\n",obor_profile_build);
 }
 return 0;
}
