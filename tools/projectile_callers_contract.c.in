#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include "openbor.h"
#undef assert
#undef printf
uint32_t obor_profile_build;
entity *self;
entity **ent_list;
int ent_list_size;
static entity actor,created;
static s_anim animation;
static entity *entries[MAX_ENTS+16];
static int active_case,projectile_cases,projectile_guard_cases,entity_cases,entity_guard_cases,testing_absent_self;
static int spawn_calls,spawn_success,name_reads,seen_bomb,seen_direction,seen_ptype,seen_map,seen_null_name;
static float seen_x,seen_z,seen_a;
static char names[3][96]={{"controlled-projectile"},{""},{0}},seen_name[96],diagnostic[256];
static ScriptVariant values[10];
#define assert(c) do{if(!(c)){fprintf(stderr,"PROJECTILE_CALL revision=%u case=%d line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
static int captured_printf(const char *format,...){
 va_list ap;va_start(ap,format);
 int n=vsnprintf(diagnostic,sizeof(diagnostic),format,ap);va_end(ap);
 assert(n>=0 && (size_t)n<sizeof(diagnostic));return n;
}
CHAR *StrCache_Get(int index){assert(index>=0&&index<3);++name_reads;return names[index];}
void StrCache_Collect(int index){(void)index;abort();}
int StrCache_Pop(void){abort();}
@VARIANTS@
static entity *observe_spawn(char *name,int model,float x,float z,float a,int direction,int ptype,int map,int bomb){
 assert(model==-1);++spawn_calls;seen_null_name=name==NULL;
 if(name){size_t n=strlen(name);assert(n<sizeof(seen_name));memcpy(seen_name,name,n+1);}
 seen_x=x;seen_z=z;seen_a=a;seen_direction=direction;seen_ptype=ptype;seen_map=map;seen_bomb=bomb;
 return spawn_success?&created:NULL;
}
entity *knife_spawn(char *name,int model,float x,float z,float a,int direction,int ptype,int map){
 return observe_spawn(name,model,x,z,a,direction,ptype,map,0);
}
entity *bomb_spawn(char *name,int model,float x,float z,float a,int direction,int map){
 return observe_spawn(name,model,x,z,a,direction,-99,map,1);
}
#define printf captured_printf
@FUNCTIONS@
#undef printf
struct context{unsigned revision;int strict_projectile,projectile_error_null,relative_defaults,dynamic_entity_list,fixed_entity_capacity;};
static const struct context contexts[]={@CONTEXTS@};
static void reset(void){
 memset(&actor,0,sizeof(actor));memset(&created,0,sizeof(created));memset(&animation,0,sizeof(animation));
 memset(values,0,sizeof(values));for(int i=0;i<10;++i)values[i].vt=VT_INTEGER;
 memset(names[2],'L',70);names[2][70]=0;seen_name[0]=diagnostic[0]=0;
 self=testing_absent_self?NULL:&actor;actor.x=10.5f;actor.z=-4.25f;actor.a=6.5f;actor.animation=&animation;animation.throwa=2.25f;
 spawn_calls=name_reads=0;spawn_success=1;seen_bomb=seen_direction=seen_ptype=seen_map=-99;
 seen_null_name=0;seen_x=seen_z=seen_a=-99;
 for(unsigned i=0;i<sizeof(entries)/sizeof(*entries);++i)entries[i]=i==1||i==149?NULL:&actor;
 ent_list=entries;ent_list_size=MAX_ENTS+10;
}
static HRESULT call_native(HRESULT (*callback)(ScriptVariant**,ScriptVariant**,int),int count,ScriptVariant *result,ScriptVariant **out){
 ScriptVariant **args=count?malloc((size_t)count*sizeof(*args)):NULL;
 assert(!count||args);for(int i=0;i<count;++i)args[i]=values+i;
 memset(result,0,sizeof(*result));result->vt=VT_INTEGER;result->lVal=999;*out=result;
 HRESULT status=callback(args,out,count);free(args);++active_case;return status;
}
static double numeric(int index){return values[index].vt==VT_DECIMAL?values[index].dblVal:(double)values[index].lVal;}
static int numeric_kind(int index){return values[index].vt==VT_INTEGER||values[index].vt==VT_DECIMAL;}
static void projectile_case(const struct context *c,int count,int mode,int facing,int success,int bad,int type,int decimal,int name){
 reset();actor.direction=facing;spawn_success=success;
 int offset=mode==1;
 if(offset)values[0].lVal=1;
 values[offset].vt=mode==2?VT_INTEGER:VT_STR;values[offset].lVal=mode==2?0:name;
 int numbers[]={12,-7,8,1,3,0,2};
 for(int i=0;i<7;++i)values[offset+i+1].lVal=numbers[i];
 values[offset+6].lVal=type;
 if(decimal){
  double numbers_decimal[]={12.5,-7.25,8.75,1.5,3.75,1.75,2.75};
  for(int i=0;i<7;++i){values[offset+i+1].vt=VT_DECIMAL;values[offset+i+1].dblVal=numbers_decimal[i];}
 }
 if(bad)values[offset+bad-1].vt=VT_EMPTY;
 int early_name=count==8&&values[0].vt==VT_STR;
 int failure=c->strict_projectile&&(!early_name);
 if(c->strict_projectile&&early_name)for(int i=1;i<8;++i)if(!numeric_kind(i))failure=1;
 ScriptVariant result,*out;HRESULT status=call_native(openbor_projectile,count,&result,&out);
 assert(status==(failure?E_FAIL:S_OK)&&spawn_calls==!failure);
 if(failure){
  assert(!strcmp(diagnostic,"Function requires 8 values: entity * projectile(char *name, float x, float z, float a, int direction, int type, int ptype, int map)\n"));
  assert(c->projectile_error_null?!out:out==&result);
  assert(result.vt==(early_name?VT_EMPTY:VT_INTEGER));
  if(!early_name)assert(result.lVal==999);
  assert(name_reads==early_name);
 }else{
  assert(!diagnostic[0]&&out==&result&&result.vt==VT_PTR&&result.ptrVal==(success?&created:NULL));
  int relative=!c->strict_projectile&&count&&values[0].vt==VT_INTEGER&&values[0].lVal;
  int base=relative?1:0,n=count-base;
  const char *expected_name=n>=1&&values[base].vt==VT_STR?names[values[base].strVal]:NULL;
  assert(seen_null_name==(expected_name==NULL));
  if(expected_name){
   if(c->strict_projectile&&strlen(expected_name)>=MAX_STR_VAR_LEN)
    assert(strlen(seen_name)==MAX_STR_VAR_LEN&&!memcmp(seen_name,expected_name,MAX_STR_VAR_LEN));
   else assert(!strcmp(seen_name,expected_name));
  }
  assert(name_reads==(expected_name!=NULL));
  float x,z,a;int direction,ptype,map,dispatch;
  if(c->strict_projectile){
   x=(float)(LONG)numeric(1);z=(float)(LONG)numeric(2);a=(float)(LONG)numeric(3);
   direction=(int)(LONG)numeric(4);ptype=(int)(LONG)numeric(5);dispatch=(int)(LONG)numeric(6);map=(int)(LONG)numeric(7);
  }else{
   x=n>=2&&numeric_kind(base+1)?(float)numeric(base+1):(relative&&c->relative_defaults?0:actor.x);
   z=n>=3&&numeric_kind(base+2)?(float)numeric(base+2):(relative&&c->relative_defaults?0:actor.z);
   a=n>=4&&numeric_kind(base+3)?(float)numeric(base+3):(relative&&c->relative_defaults?animation.throwa:actor.a+animation.throwa);
   direction=n>=5&&numeric_kind(base+4)?(int)(LONG)numeric(base+4):(relative&&c->relative_defaults?1:facing);
   ptype=n>=6&&numeric_kind(base+5)?(int)(LONG)numeric(base+5):0;
   dispatch=n>=7&&numeric_kind(base+6)?(int)(LONG)numeric(base+6):0;
   map=n>=8&&numeric_kind(base+7)?(int)(LONG)numeric(base+7):0;
   if(relative){if(facing)x+=actor.x;else{x=actor.x-x;if(c->relative_defaults)direction=!direction;}z+=actor.z;a+=actor.a;}
  }
  assert(seen_x==x&&seen_z==z&&seen_a==a&&seen_direction==direction&&seen_map==map);
  assert(seen_bomb==(dispatch==1)&&seen_ptype==(dispatch==1?-99:ptype));
 }
 if(testing_absent_self)++projectile_guard_cases;else ++projectile_cases;
}
static void entity_case(const struct context *c,int capacity,int count,int index,int kind,int core_guard){
 reset();ent_list_size=capacity;if(!capacity)ent_list=NULL;
 values[0].vt=kind==0?VT_INTEGER:kind==1?VT_DECIMAL:kind==2?VT_EMPTY:kind==3?VT_STR:VT_PTR;
 if(kind==1)values[0].dblVal=(double)index+(index<0?-0.75:0.75);else values[0].lVal=index;
 int bad=count!=1||kind>=2;
 int in_range=!bad&&index>=0&&index<(c->dynamic_entity_list?capacity:c->fixed_entity_capacity);
 ScriptVariant result,*out;HRESULT status=call_native(openbor_getentity,count,&result,&out);
 assert(status==(bad?E_FAIL:S_OK)&&!spawn_calls&&!name_reads);
 assert(!strcmp(diagnostic,bad?"Function need an integer parameter: getentity(int index_in_list)\n":""));
 if(bad)assert(!out&&result.vt==VT_INTEGER&&result.lVal==999);
 else{
  assert(out==&result&&result.vt==(in_range?VT_PTR:VT_EMPTY));
  if(in_range)assert(result.ptrVal==(index<capacity?entries[index]:NULL));
 }
 if(core_guard)++entity_guard_cases;else ++entity_cases;
}
int main(void){
 for(unsigned p=0;p<sizeof(contexts)/sizeof(*contexts);++p){
  const struct context *c=contexts+p;obor_profile_build=c->revision;
  assert(c->fixed_entity_capacity==MAX_ENTS);
  active_case=projectile_cases=projectile_guard_cases=entity_cases=entity_guard_cases=testing_absent_self=0;
  for(int count=0;count<=10;++count)for(int mode=0;mode<3;++mode)for(int facing=0;facing<2;++facing)
   for(int success=0;success<2;++success)projectile_case(c,count,mode,facing,success,0,0,0,0);
  for(int bad=1;bad<=8;++bad)for(int facing=0;facing<2;++facing)for(int success=0;success<2;++success)
   projectile_case(c,8,0,facing,success,bad,0,0,0);
  for(int type=-1;type<=2;++type)for(int facing=0;facing<2;++facing)for(int success=0;success<2;++success)
   projectile_case(c,8,0,facing,success,0,type,0,0);
  for(int mode=0;mode<2;++mode)for(int facing=0;facing<2;++facing)for(int success=0;success<2;++success)
   projectile_case(c,8+mode,mode,facing,success,0,0,1,0);
  /* Long names have a bounded core oracle, independent of original validity. */
  for(int name=1;name<=2;++name)for(int facing=0;facing<2;++facing)for(int success=0;success<2;++success)
   projectile_case(c,8,0,facing,success,0,0,0,name);
  /* Fully specified absolute coordinates do not need an entity context.
   * This is a core stability control, independent of original validity. */
  testing_absent_self=1;projectile_case(c,8,0,0,1,0,0,0,0);testing_absent_self=0;
  int indices[]={-1,0,1,32,148,149,150,151,159,160,165,999};
  for(int size=0;size<2;++size)for(unsigned i=0;i<sizeof(indices)/sizeof(*indices);++i)for(int kind=0;kind<2;++kind)
   entity_case(c,c->fixed_entity_capacity+10*size,1,indices[i],kind,0);
  for(int count=0;count<=2;count+=2)for(int kind=0;kind<5;++kind)entity_case(c,MAX_ENTS,count,0,kind,0);
  for(int size=0;size<2;++size)for(int kind=2;kind<5;++kind)entity_case(c,MAX_ENTS+10*size,1,0,kind,0);
  int short_indices[]={0,31,32,149,150};
  for(int capacity=0;capacity<=32;capacity+=32)
   for(unsigned i=0;i<sizeof(short_indices)/sizeof(*short_indices);++i)for(int kind=0;kind<2;++kind)
    entity_case(c,capacity,1,short_indices[i],kind,1);
  assert(projectile_cases==196&&projectile_guard_cases==1&&entity_cases==64&&entity_guard_cases==20);
  fprintf(stdout,"{\"revision\":%u,\"projectile_cases\":%d,\"projectile_guard_cases\":%d,\"entity_cases\":%d,\"entity_guard_cases\":%d}\n",
          obor_profile_build,projectile_cases,projectile_guard_cases,entity_cases,entity_guard_cases);
 }
 return 0;
}
