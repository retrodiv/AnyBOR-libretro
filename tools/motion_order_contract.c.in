#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef assert
#undef printf
#ifdef NDEBUG
#error Motion caller assertions must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do {if(!(c)){fprintf(stderr,"MOTION_ORDER revision=%u case=%u line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
static entity actor,target;
entity *self;
unsigned int time;
int autoland,ent_max=2;
entity *ent_list[2];
s_savedata savedata;
static s_anim nodes[256],*animation_table[256],target_animation;
static short vulnerability[1];
static int mutate,airborne,find_target;
static void initial_action(void) {abort();}
static void callback_action(void) {abort();}
void common_attack_proc(void) {abort();}
void common_prejump(void) {abort();}
void common_spawn(void) {abort();}
void common_fall(void) {abort();}
void bomb_explode(void) {abort();}
void common_throw(void) {abort();}
static int action_id(void (*action)(void)) {
 if(!action)return 0;
 if(action==initial_action)return 1;
 if(action==callback_action)return 2;
 if(action==common_attack_proc)return 3;
 if(action==common_prejump)return 4;
 if(action==common_spawn)return 5;
 if(action==common_fall)return 6;
 if(action==bomb_explode)return 7;
 if(action==common_throw)return 8;
 abort();
}
static int entity_id(entity *e) {
 if(!e)return -1;
 if(e==&actor)return 0;
 if(e==&target)return 1;
 abort();
}
#define WIDTH 51
static void snapshot(double *v) {
 const double fields[]={entity_id(self),action_id(actor.takeaction),action_id(target.takeaction),
 actor.xdir,actor.zdir,actor.tossv,actor.a,actor.base,actor.x,actor.z,actor.direction,
 target.xdir,target.zdir,target.tossv,target.a,target.base,target.x,target.z,target.direction,
 actor.attacking,actor.idling,actor.running,actor.projectile,actor.damage_on_landing,
 actor.modeldata.no_adjust_base,actor.modeldata.subject_to_wall,actor.modeldata.subject_to_platform,
 actor.modeldata.subject_to_hole,actor.nextthink,actor.knockdowncount,actor.knockdowntime,
 actor.toss_time,actor.jumpv,actor.jumpx,actor.jumpz,actor.jumpid,
 target.attacking,target.idling,target.running,target.projectile,target.damage_on_landing,
 target.nextthink,target.knockdowncount,target.knockdowntime,target.toss_time,actor.drop,target.drop,
 actor.link==&target,target.link==&actor,actor.grabbing==&target,target.grabbing==&actor};
 _Static_assert(sizeof(fields)/sizeof(*fields)==WIDTH,"Observer fields bound");
 memcpy(v,fields,sizeof(fields));
}
struct event {int kind,subject;double args[5],fields[WIDTH];};
static struct event events[16];static unsigned event_count;
static void observe(int kind,entity *e,double a,double b,double c,double d,double f,int callback) {
 assert(event_count<16);struct event *out=&events[event_count++];
 out->kind=kind;out->subject=entity_id(e);
 out->args[0]=a;out->args[1]=b;out->args[2]=c;out->args[3]=d;out->args[4]=f;snapshot(out->fields);
 if(callback && mutate){
  actor.takeaction=target.takeaction=callback_action;
  if(e){e->knockdowncount=33;e->knockdowntime=44;}
 }
}
int set_idle(entity *e) {observe(1,e,0,0,0,0,0,1);return 1;}
void ent_set_anim(entity *e,int index,int reset) {observe(2,e,index,reset,0,0,0,1);}
entity *normal_find_target(int animation,int detect) {
 observe(3,NULL,animation,detect,0,0,0,0);return find_target?&target:NULL;
}
void dojump(float v,float x,float z,int id) {observe(4,self,v,x,z,id,0,1);}
void adjust_walk_animation(entity *e) {observe(5,e,0,0,0,0,0,1);}
#define ent_unlink native_unlink
@UNLINK@
#undef ent_unlink
void ent_unlink(entity *e) {observe(6,e,0,0,0,0,0,0);native_unlink(e);}
#define toss native_toss
@TOSS@
#undef toss
void toss(entity *e,float lift) {observe(7,e,lift,0,0,0,0,0);native_toss(e,lift);}
int sound_play_sample(int sample,unsigned int priority,int left,int right,unsigned int speed) {
 observe(8,self,sample,priority,left,right,speed,0);return 0;
}
float randf(float max) {observe(9,NULL,max,0,0,0,0,0);return 0.25f;}
int set_fall(entity *e,int type,int reset,entity *other,int force,int drop,int noblock,int guardcost,int jugglecost,int pauseadd) {
 assert(!force && !drop && !noblock && !guardcost && !jugglecost && !pauseadd);
 observe(10,e,type,reset,entity_id(other),0,0,1);return 1;
}
void dropweapon(int flag) {observe(11,self,flag,0,0,0,0,0);}
int inair(entity *e) {assert(e==self);return airborne;}
@FUNCTIONS@
struct motion_case {int operation,provided_target,find_target,jumping,running,vulnerable,target_drop,target_attacking,animation_mask,parent,noflip,direction,target_left,stall,linked,autoland,lift_mode,eligibility,airborne,toexplode,already_exploding,sound,mutate,target_direction;};
static const struct motion_case cases[]={@CASES@};
static const unsigned profiles[]={@PROFILES@};
static const int selected_animations[]={ANI_UPPER,ANI_RUNATTACK,ANI_JUMPDELAY,ANI_RESPAWN,ANI_SPAWN,ANI_LAND,ANI_FALL,ANI_ATTACK1,ANI_ATTACK2};
static void prepare(const struct motion_case *c) {
 memset(&actor,0,sizeof(actor));memset(&target,0,sizeof(target));memset(&savedata,0,sizeof(savedata));
 memset(nodes,0,sizeof(nodes));memset(animation_table,0,sizeof(animation_table));memset(&target_animation,0,sizeof(target_animation));
 self=&actor;time=100;actor.takeaction=c->already_exploding?bomb_explode:initial_action;target.takeaction=initial_action;
 actor.xdir=2;actor.zdir=3;actor.tossv=4;actor.a=6;actor.base=5;actor.x=9;actor.z=12;actor.direction=c->direction;
 target.xdir=5;target.zdir=6;target.tossv=7;target.a=10;target.base=8;target.x=c->target_left?-42:42;target.z=20;target.direction=c->target_direction;
 actor.idling=target.idling=1;actor.running=c->running;actor.damage_on_landing=2;
 actor.modeldata.subject_to_wall=actor.modeldata.subject_to_hole=1;
 actor.nextthink=13;actor.knockdowncount=3;actor.knockdowntime=17;actor.drop=1;
 target.attacking=c->target_attacking;target.damage_on_landing=3;target.nextthink=14;
 target.knockdowncount=4;target.knockdowntime=18;target.drop=c->target_drop;
 actor.parent=c->parent?&target:NULL;actor.modeldata.noflip=c->noflip;actor.modeldata.speed=4;
 actor.stalltime=(unsigned)c->stall;actor.modeldata.throwdamage=6;
 if(c->linked){actor.link=&target;target.link=&actor;actor.grabbing=&target;target.grabbing=&actor;}
 target.modeldata.throwheight=c->lift_mode==0?6:c->lift_mode==3?-2:0;
 target.modeldata.jumpheight=c->lift_mode==2?0:4;target.modeldata.throwdist=3;
 target.modeldata.knockdowncount=10;target.health=10;target.exists=1;target.modeldata.type=TYPE_ENEMY;
 actor.modeldata.type=TYPE_PLAYER;actor.exists=1;actor.health=10;ent_list[0]=&actor;ent_list[1]=&target;
 actor.modeldata.animation=target.modeldata.animation=animation_table;
 actor.modeldata.animation_capacity=target.modeldata.animation_capacity=256;
 for(int i=0;i<256;++i)nodes[i].numframes=1;
 for(unsigned i=0;i<sizeof(selected_animations)/sizeof(*selected_animations);++i)
  if(c->animation_mask&(1<<i))animation_table[selected_animations[i]]=&nodes[selected_animations[i]];
 target.jumping=c->jumping;vulnerability[0]=(short)c->vulnerable;
 target_animation.numframes=1;target_animation.vulnerable=vulnerability;target.animation=&target_animation;
 switch(c->eligibility){
  case 0:break;case 1:target.exists=0;break;case 2:target.health=0;break;
  case 3:target.modeldata.type=TYPE_NPC;break;case 4:target.owner=&actor;break;
  case 5:target.frozen=1;break;case 6:target.modeldata.nomove=1;break;
  case 7:target.modeldata.nodrop=1;break;case 8:animation_table[ANI_FALL]=NULL;break;
  default:abort();
 }
 actor.toexplode=c->toexplode;actor.modeldata.diesound=c->sound?2:-1;savedata.effectvol=60;
 mutate=c->mutate;airborne=c->airborne;find_target=c->find_target;autoland=c->autoland;event_count=0;
}
static void array_json(const double *v,unsigned n) {
 putchar('[');for(unsigned i=0;i<n;++i){if(i)putchar(',');printf("%.17g",v[i]);}putchar(']');
}
int main(void) {
 for(unsigned p=0;p<sizeof(profiles)/sizeof(*profiles);++p){
  obor_profile_build=profiles[p];
  for(unsigned k=0;k<sizeof(cases)/sizeof(*cases);++k){
   active_case=k;const struct motion_case *c=&cases[k];prepare(c);int result=-1;
   switch(c->operation){
    case 0:result=common_try_upper(c->provided_target?&target:NULL);break;
    case 1:tryjump(3,4,5,ANI_FALL);break;
    case 2:npc_warp();break;
    case 3:result=common_try_runattack(c->provided_target?&target:NULL);break;
    case 4:common_runoff();break;
    case 5:dothrow();break;
    case 6:drop_all_enemies();break;
    case 7:result=bomb_move();break;
    default:abort();
   }
   double final[WIDTH];snapshot(final);
   printf("{\"revision\":%u,\"case\":%u,\"result\":%d,\"fields\":",obor_profile_build,k,result);array_json(final,WIDTH);
   printf(",\"events\":[");
   for(unsigned i=0;i<event_count;++i){struct event *e=&events[i];if(i)putchar(',');
    printf("{\"kind\":%d,\"subject\":%d,\"args\":",e->kind,e->subject);array_json(e->args,5);
    printf(",\"fields\":");array_json(e->fields,WIDTH);putchar('}');}
   puts("]}");
  }
 }
 return 0;
}
