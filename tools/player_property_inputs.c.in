#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <stdarg.h>
#include <limits.h>
#include <float.h>
@CONFIG@
#include "openbor.h"
#include "@SCRIPT_HEADER@"
#undef printf
#undef assert
#ifdef NDEBUG
#error Player input assertions must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned cases;
static int own_requires_actor,own_integer_result;
#define assert(c) do {if(!(c)){fprintf(stderr,"Player input revision=%u case=%u line=%d: %s\n",obor_profile_build,cases,__LINE__,#c);abort();}}while(0)
HRESULT Interpreter_Call(Interpreter *p) {(void)p;abort();}
HRESULT Interpreter_EvalInstruction(Interpreter *p) {(void)p;abort();}
s_player player[MAX_PLAYERS];
s_modelcache *model_cache;
int credits, noshare;
static entity actor;
static char strings[64][1024], diagnostic[2048];
static int used[64], weapon_calls, weapon_number, weapon_flag;
int StrCache_Pop(@POP_ARGUMENTS@)
{
    @POP_UNUSED@
    for(int i=0;i<64;++i)if(!used[i]){used[i]=1;strings[i][0]=0;return i;}
    abort();
}
void StrCache_Collect(int i){assert(i>=0 && i<64 && used[i]);used[i]=0;}
CHAR *StrCache_Get(int i){assert(i>=0 && i<64 && used[i]);return strings[i];}
CHAR *StrCache_GetIfPresent(int i)
{return i>=0 && i<64 && used[i] && memchr(strings[i],0,sizeof(strings[i]))?strings[i]:NULL;}
void StrCache_Copy(int i,CHAR *value)
{assert(i>=0 && i<64 && used[i] && strlen(value)<sizeof(strings[i]));strcpy(strings[i],value);}
int StrCache_CreateNewFrom(const CHAR *text)
{
    int i;
    @CREATE_SLOT@
    assert(strlen(text)<sizeof(strings[i]));strcpy(strings[i],text);return i;
}
void set_weapon(entity *ent,int number,int flag)
{assert(ent==&actor);++weapon_calls;weapon_number=number;weapon_flag=flag;}
static int record_printf(const char *format,...)
{
    va_list args;va_start(args,format);size_t n=strlen(diagnostic);
    int result=vsnprintf(diagnostic+n,sizeof(diagnostic)-n,format,args);
    va_end(args);assert(result>=0 && (size_t)result<sizeof(diagnostic)-n);return result;
}
/* Model and input-device paths are deliberately not exercised here. */
#define get_cached_model_index(name) (-1)
@CONTROL_UNDEF@#define control_getmappedkeyname(...) ""
#define control_getdevicename(...) ""
@VARIANTS@
#if @MODERN_VIEW@
HRESULT ScriptVariant_GetStringView(const ScriptVariant *arg,CHAR *buffer,size_t capacity,ScriptVariantStringView *view)
{
    const char *text=NULL;
    switch(arg->vt)
    {
    case VT_STR:text=StrCache_GetIfPresent(arg->strVal);break;
    case VT_EMPTY:snprintf(buffer,capacity,"<VT_EMPTY>   Unitialized");text=buffer;break;
    case VT_INTEGER:snprintf(buffer,capacity,"%ld",(long)arg->lVal);text=buffer;break;
    case VT_DECIMAL:snprintf(buffer,capacity,"%lf",arg->dblVal);text=buffer;break;
    default:return E_FAIL;
    }
    if(!text)return E_FAIL;
    view->string=text;view->length=strlen(text);return S_OK;
}
#endif
@ENUMS@
@SEARCH@
@MACRO@
#define printf record_printf
@SUPPORT@
@BASELINE@
@METHODS@
#undef printf
static const struct {uint32_t revision;int requires_actor,integer_result;} contexts[]={@CONTEXTS@};
static ScriptVariant integer(LONG n){ScriptVariant v={0};v.vt=VT_INTEGER;v.lVal=n;return v;}
static ScriptVariant text(const char *s)
{
    ScriptVariant v={0};v.vt=VT_STR;
    v.strVal=StrCache_CreateNewFrom(s);return v;
}
static void reset(int spawned)
{
    memset(player,0,sizeof(player));memset(strings,0,sizeof(strings));memset(used,0,sizeof(used));
    memset(diagnostic,0,sizeof(diagnostic));weapon_calls=0;weapon_number=weapon_flag=-1;credits=13;noshare=1;
    for(int i=0;i<MAX_PLAYERS;++i)
    {
        player[i].ent=spawned?&actor:NULL;player[i].score=30+i;player[i].lives=20+i;
        player[i].credits=10+i;player[i].playkeys=40+i;strcpy(player[i].name,"Player");
    }
}
typedef HRESULT (*entry_fn)(ScriptVariant**,ScriptVariant**,int);
struct observation
{
    s_player players[MAX_PLAYERS];ScriptVariant result,property;
    char cache[64][1024],log[2048];int slots[64],has_result,status,calls,number,flag,shared_credits;
};
static void observe(struct observation *out,entry_fn fn,const char *property,int index,int index_kind,int spawned,int setter,int name_length,int optional)
{
    reset(spawned);ScriptVariant i=integer(index),p=text(property),value=integer(51),extra=integer(2),result={0},*returned=&result;
    if(index_kind==1){i.vt=VT_DECIMAL;i.dblVal=index+0.75;}
    if(index_kind==2)i.vt=VT_EMPTY; /* Native conversion failure defaults to0. */
    if(!strcmp(property,"name"))
    {char name[256];assert(name_length>=0 && name_length<(int)sizeof(name));memset(name,'x',name_length);name[name_length]=0;value=text(name);}
    ScriptVariant *args[]={&i,&p,&value,&extra};
    out->status=fn(args,&returned,setter?(optional?4:3):2);out->has_result=returned!=NULL;
    memcpy(out->players,player,sizeof(player));out->result=result;out->property=p;
    memcpy(out->cache,strings,sizeof(strings));memcpy(out->slots,used,sizeof(used));
    memcpy(out->log,diagnostic,sizeof(diagnostic));out->calls=weapon_calls;out->number=weapon_number;out->flag=weapon_flag;out->shared_credits=credits;
}
static void compare_valid(const char *property,int index,int index_kind,int spawned,int setter,int length,int optional)
{
    struct observation native={0},original={0};
    observe(&native,setter?openbor_changeplayerproperty:openbor_getplayerproperty,property,index,index_kind,spawned,setter,length,optional);
    observe(&original,setter?original_set:original_get,property,index,index_kind,spawned,setter,length,optional);
    int native_result=native.status,original_result=original.status;
    assert(native_result == original_result);
    assert(native.has_result==original.has_result);
    if(setter && native_result==S_OK)assert(native.has_result==own_integer_result);
    if(!setter && !spawned && own_requires_actor)assert(native.result.vt==VT_EMPTY);
    assert(!memcmp(&native.result,&original.result,sizeof(native.result)));
    assert(!memcmp(&native.property,&original.property,sizeof(native.property)));
    assert(!memcmp(native.players,original.players,sizeof(native.players)));
    assert(!memcmp(native.cache,original.cache,sizeof(native.cache)));
    assert(!memcmp(native.slots,original.slots,sizeof(native.slots)));
    assert(!memcmp(native.log,original.log,sizeof(native.log)));
    assert(native.calls==original.calls && native.number==original.number && native.flag==original.flag && native.shared_credits==original.shared_credits);
    ++cases;
}
static void refusal(entry_fn fn,ScriptVariant **args,ScriptVariant **returned,int count)
{
    s_player snapshot[MAX_PLAYERS];memcpy(snapshot,player,sizeof(player));int calls=weapon_calls;
    assert(fn(args,returned,count)==E_FAIL);
    assert(!memcmp(snapshot,player,sizeof(player)) && calls==weapon_calls);++cases;
}
static void invalid_inputs(void)
{
    const LONG bad[]={-1,INT_MIN,MAX_PLAYERS,INT_MAX};
    for(unsigned k=0;k<sizeof(bad)/sizeof(*bad);++k)
    for(int setter=0;setter<2;++setter)
    {
        reset(1);ScriptVariant i=integer(bad[k]),p=text("score"),v=integer(19),r={0},*out=&r;
        ScriptVariant *args[]={&i,&p,&v};refusal(setter?openbor_changeplayerproperty:openbor_getplayerproperty,args,&out,setter?3:2);assert(!out);
    }
    for(int setter=0;setter<2;++setter)
    for(int missing=0;missing<5;++missing)
    {
        reset(1);ScriptVariant i=integer(0),p=text("name"),v=integer(19),r={0},*out=&r;ScriptVariant *args[]={&i,&p,&v};
        if(missing<2)args[missing]=NULL;
        else if(missing==2){p.vt=VT_STR;p.strVal=-1;}
        else if(missing==3 && setter)args[2]=NULL;
        entry_fn fn=setter?openbor_changeplayerproperty:openbor_getplayerproperty;
        if(missing==4)refusal(fn,NULL,&out,setter?3:2);
        else if(missing!=3 || setter)refusal(fn,args,&out,setter?3:2);
        refusal(fn,args,NULL,setter?3:2);
    }
    for(int oversized=0;oversized<2;++oversized)
    {
        reset(1);ScriptVariant i=integer(0),p=text("name"),v=text("valid"),r={0},*out=&r;
        if(oversized){memset(strings[v.strVal],'x',sizeof(player[0].name));strings[v.strVal][sizeof(player[0].name)]=0;}
        else v.strVal=-1;
        ScriptVariant *args[]={&i,&p,&v};refusal(openbor_changeplayerproperty,args,&out,3);
    }
    reset(1);memset(player[0].name,'x',sizeof(player[0].name));
    ScriptVariant i=integer(0),p=text("name"),v=integer(2),r={0},*out=&r;ScriptVariant *args[]={&i,&p,&v,NULL};
    refusal(openbor_getplayerproperty,args,&out,2);
    reset(1);p=text("score");out=NULL;
    refusal(openbor_getplayerproperty,args,&out,2);
    if(obor_profile_build<3797)refusal(openbor_changeplayerproperty,args,&out,3);
    else
    {
        assert(openbor_changeplayerproperty(args,&out,3)==S_OK && !out && player[0].score==2);++cases;
    }
    if(own_requires_actor)
    {
        reset(0);p=text("score");out=&r;args[2]=NULL;
        assert(openbor_changeplayerproperty(args,&out,3)==S_OK && out==&r && r.vt==VT_INTEGER && r.lVal==1);++cases;
        args[2]=&v;
    }
    reset(1);p=text("weapon");out=&r;
    s_player snapshot[MAX_PLAYERS];memcpy(snapshot,player,sizeof(player));
    HRESULT status=openbor_changeplayerproperty(args,&out,4);
    if(obor_profile_build<3797){assert(status==S_OK && out==&r && r.lVal==0);}
    else assert(status==E_FAIL && !out);
    assert(!memcmp(snapshot,player,sizeof(player)) && !weapon_calls);++cases;
    /* Rejected optional values retain historical return style, with bounded
     * diagnostics even when the rejected value has a long representation. */
    for(int large=0;large<2;++large)
    {
        reset(1);p=text("weapon");out=&r;
        if(large){char message[512];memset(message,'x',sizeof(message)-1);message[sizeof(message)-1]=0;v=text(message);}
        else{v.vt=VT_DECIMAL;v.dblVal=DBL_MAX;p=text("name");}
        memcpy(snapshot,player,sizeof(player));args[2]=&v;
        status=openbor_changeplayerproperty(args,&out,3);
        if(obor_profile_build<3797 && large)assert(status==S_OK && out==&r && r.lVal==0);
        else assert(status==E_FAIL);
        assert(!memcmp(snapshot,player,sizeof(player)) && !weapon_calls);++cases;
    }
#if @HAS_HISTORY@
    const char *fields[]={"combokey","inputtime"};
    for(unsigned f=0;f<2;++f)
    for(int k=0;k<5;++k)
    {
        reset(1);p=text(fields[f]);v=integer(k==0?-1:k==1?MAX_SPECIAL_INPUTS:k==2?INT_MAX:0);out=&r;args[2]=k==3?NULL:&v;
        refusal(openbor_getplayerproperty,args,&out,k==4?2:3);assert(!out);
    }
    for(unsigned f=0;f<2;++f)
    {
        reset(1);p=text(fields[f]);v=integer(MAX_SPECIAL_INPUTS-1);args[2]=&v;out=&r;
        player[0].combokey[MAX_SPECIAL_INPUTS-1]=731;player[0].inputtime[MAX_SPECIAL_INPUTS-1]=739;
        assert(openbor_getplayerproperty(args,&out,3)==S_OK && out==&r && r.vt==VT_INTEGER && r.lVal==(f?739:731));++cases;
    }
#endif
}
int main(void)
{
    for(unsigned c=0;c<sizeof(contexts)/sizeof(*contexts);++c)
    {
        obor_profile_build=contexts[c].revision;
        own_requires_actor=contexts[c].requires_actor;own_integer_result=contexts[c].integer_result;
#ifdef ENDPOINT_ONLY
        compare_valid("score",MAX_PLAYERS-1,0,1,0,0,0);
#else
        const char *properties[]={"score","lives","name","playkeys","credits","weapon"};
        for(unsigned p=0;p<sizeof(properties)/sizeof(*properties);++p)
        for(int index=0;index<MAX_PLAYERS;++index)
        for(int kind=0;kind<3;++kind)
        for(int spawned=0;spawned<2;++spawned)
        for(int setter=0;setter<2;++setter)
        for(int extra=0;extra<2;++extra)
            compare_valid(properties[p],index,kind,spawned,setter,extra?(int)sizeof(player[0].name)-1:0,extra);
        invalid_inputs();
#endif
    }
    printf("{\"status\":\"PASS\",\"profiles\":%zu,\"cases\":%u}\n",sizeof(contexts)/sizeof(*contexts),cases);return 0;
}
