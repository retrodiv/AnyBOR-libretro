#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef assert
#undef printf
#ifdef NDEBUG
#error Navigation assertions must remain enabled
#endif
struct navigation_case {
 int routine,flags[10],video[2],range[4];
 float position[2],target[2],velocity[2],destination[2],speeds[3],camera[2];
 int scroll,idle_distance;uint32_t word,stall;
};
static const struct navigation_case cases[]={@CASES@},*test;
static const uint32_t profiles[]={@PROFILES@};
uint32_t obor_profile_build;
static entity actor,target,*self=&actor;
static s_level world,*level=&world;
static s_videomodes videomodes;
static float advancex,advancey;
static unsigned active_case,draws;
static char trace[256];static size_t used;
#define assert(c) do {if(!(c)){fprintf(stderr,"Navigation provider mismatch: profile=%u case=%u line=%d trace=%s\n",obor_profile_build,active_case,__LINE__,trace);abort();}}while(0)
static uint32_t bits(float value){uint32_t word;_Static_assert(sizeof(value)==sizeof(word),"binary32 required");memcpy(&word,&value,sizeof(word));return word;}
static void append(const char *text){size_t n=strlen(text);assert(n<sizeof(trace)-used);memcpy(trace+used,text,n+1);used+=n;}
static int pick_random_attack(entity *ent,int mode){assert(!ent&&!mode);append("P;");return test->flags[9]?114:-1;}
static uint32_t observed_rand32(void){assert(draws++==0);char buffer[32];snprintf(buffer,sizeof(buffer),"D%u;",test->word);append(buffer);return test->word;}
void adjust_walk_animation(entity *ent){
 assert(ent==&target);char buffer[128];snprintf(buffer,sizeof(buffer),"L%u,%u,%u,%u,%d;",bits(actor.xdir),bits(actor.zdir),bits(actor.destx),bits(actor.destz),actor.running);append(buffer);
}
#undef rand32
#define rand32 observed_rand32
@DIFF@
@ADJUSTSPEED@
@COMMON_TRY_CHASE@
@COMMON_TRY_AVOID@
@COMMON_TRY_FOLLOW@
@COMMON_TRY_PICK@
int main(void){
 _Static_assert(ANI_IDLE!=ANI_RUN && ANI_IDLE!=114 && ANI_RUN!=114,"Distinct native navigation animation slots required");
 s_anim attack,run,idle,*animations[MAX_ANIS]={0};
 for(unsigned p=0;p<sizeof(profiles)/sizeof(*profiles);++p){
  obor_profile_build=profiles[p];
  for(unsigned c=0;c<sizeof(cases)/sizeof(*cases);++c){
   active_case=c;test=cases+c;
   memset(&actor,0,sizeof(actor));memset(&target,0,sizeof(target));memset(&world,0,sizeof(world));
   memset(&attack,0,sizeof(attack));memset(&run,0,sizeof(run));memset(&idle,0,sizeof(idle));memset(animations,0,sizeof(animations));
   attack.numframes=run.numframes=idle.numframes=1;
   attack.range.xmin=test->range[0];attack.range.xmax=test->range[1];attack.range.zmin=test->range[2];attack.range.zmax=test->range[3];
   idle.range.xmin=test->idle_distance;animations[114]=&attack;
   if(test->flags[7])animations[ANI_RUN]=&run;
   if(test->flags[8])animations[ANI_IDLE]=&idle;
   actor.modeldata.animation=animations;actor.modeldata.animation_capacity=MAX_ANIS;
   actor.modeldata.nomove=test->flags[1];actor.direction=test->flags[4];actor.running=test->flags[5];actor.modeldata.runupdown=test->flags[6];
   actor.x=test->position[0];actor.z=test->position[1];target.x=test->target[0];target.z=test->target[1];
   actor.xdir=test->velocity[0];actor.zdir=test->velocity[1];actor.destx=test->destination[0];actor.destz=test->destination[1];
   actor.modeldata.speed=test->speeds[0];actor.modeldata.runspeed=test->speeds[1];actor.modeldata.grabdistance=test->speeds[2];
   videomodes.hRes=test->video[0];videomodes.vRes=test->video[1];advancex=test->camera[0];advancey=test->camera[1];
   world.scrolldir=test->scroll==1?SCROLL_UP:test->scroll==2?SCROLL_DOWN:SCROLL_RIGHT;actor.stalltime=test->stall;
   draws=used=0;trace[0]=0;entity *argument=test->flags[0]?&target:NULL;int result;
   switch(test->routine){
    case 0:result=common_try_chase(argument,test->flags[2],test->flags[3]);break;
    case 1:result=common_try_avoid(argument,test->flags[2],test->flags[3]);break;
    case 2:result=common_try_follow(argument,test->flags[2],test->flags[3]);break;
    case 3:assert(argument);result=common_try_pick(argument);break;
    case 4:adjustspeed(actor.modeldata.speed,actor.x,actor.z,target.x,target.z,&actor.xdir,&actor.zdir);result=1;break;
    default:abort();
   }
   printf("{\"revision\":%u,\"case\":%u,\"vectors\":[%u,%u,%u,%u],\"running\":%d,\"stall\":%u,\"result\":%d,\"trace\":\"%s\"}\n",
    obor_profile_build,c,bits(actor.xdir),bits(actor.zdir),bits(actor.destx),bits(actor.destz),actor.running,actor.stalltime,result,trace);
  }
 }
 return 0;
}
