#include <assert.h>
#include <float.h>
#include <limits.h>
#include <math.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "types.h"
#include "anybor_resources.h"
#pragma GCC diagnostic ignored "-Wsign-compare"
#pragma GCC diagnostic ignored "-Wmisleading-indentation"
#undef assert
#include <assert.h>
static unsigned checks;
#define CHECK(x) do {++checks;assert(x);} while(0)
static struct {unsigned char *base;size_t physical,visible;} blocks[3];
static unsigned block_count,queries;
size_t obor_allocation_size(const void *owner){for(unsigned i=0;i<block_count;++i)if(owner==blocks[i].base)return blocks[i].visible;return 0;}
int obor_allocation_query(const void *address,const void **owner,size_t *remaining) {
 ++queries;if(owner)*owner=NULL;if(remaining)*remaining=0;
 for(unsigned i=0;i<block_count;++i) {
  uintptr_t a=(uintptr_t)address,b=(uintptr_t)blocks[i].base;
  if(a>=b && a-b<blocks[i].visible){if(owner)*owner=blocks[i].base;if(remaining)*remaining=blocks[i].visible-(a-b);return 1;}
 }
 return 0;
}
@UNITS@
#undef distortion
enum {SW=13,SH=7,BW=4,BH=3};
static s_screen *left,*right;
static s_bitmap *image;
static s_drawmethod method;
static union { unsigned short short_palette[256]; unsigned int int_palette[256]; } alternate;
static size_t screen_bytes,bitmap_bytes;
static void reset(int bytes) {
 for(unsigned i=0;i<3;++i){blocks[i].visible=blocks[i].physical;memset(blocks[i].base,0,blocks[i].physical);}
 left->width=right->width=SW;left->height=right->height=SH;
 left->pixelformat=right->pixelformat=bytes==1?PIXEL_8:bytes==2?PIXEL_16:PIXEL_32;
 image->width=BW;image->height=BH;image->pixelformat=PIXEL_x8;
 image->palette=image->data+((BW*BH+3)&~3);
 memset(left->data,0xa5,SW*SH*4);memset(right->data,0xa5,SW*SH*4);
 for(size_t i=0;i<bitmap_bytes-(size_t)((unsigned char*)image-blocks[2].base)-offsetof(s_bitmap,data);++i)image->data[i]=(unsigned char)(i*17+3);
 for(unsigned i=0;i<256;++i){
  if(bytes==2){unsigned short value=(unsigned short)(i*257u+3u);memcpy(image->palette+i*2,&value,2);alternate.short_palette[i]=(unsigned short)~value;}
  else {unsigned int value=i*UINT32_C(0x01010101)+UINT32_C(0x19355779);memcpy(image->palette+i*bytes,&value,(size_t)bytes);alternate.int_palette[i]=~value;}
 }
 memset(&method,0,sizeof(method));method.flag=1;method.table=(unsigned char*)&alternate;
}
static void render(int old,int wave,int direct,int bytes,s_screen *target,int x,int y,int w,int h,int ox,int oy,int phase,int step,int factor,s_drawmethod *m) {
 if(!direct) {
  if(wave){if(old)original_apply_texture_wave(target,x,y,w,h,ox,oy,image,phase,step,m);else apply_texture_wave(target,x,y,w,h,ox,oy,image,phase,step,m);}
  else {if(old)original_apply_texture_plane(target,x,y,w,h,ox,factor,image,m);else apply_texture_plane(target,x,y,w,h,ox,factor,image,m);}
 } else if(wave) {
  if(bytes==1){if(old)original_texture_wave(target,x,y,w,h,ox,oy,image,phase,step);else texture_wave(target,x,y,w,h,ox,oy,image,phase,step);}
  else if(bytes==2){if(old)original_texture_wavex8p16(target,x,y,w,h,ox,oy,image,phase,step,alternate.short_palette);else texture_wavex8p16(target,x,y,w,h,ox,oy,image,phase,step,alternate.short_palette);}
  else {if(old)original_texture_wavex8p32(target,x,y,w,h,ox,oy,image,phase,step,alternate.int_palette);else texture_wavex8p32(target,x,y,w,h,ox,oy,image,phase,step,alternate.int_palette);}
 } else {
  if(bytes==1){if(old)original_texture_plane(target,x,y,w,h,ox,factor,image);else texture_plane(target,x,y,w,h,ox,factor,image);}
  else if(bytes==2){if(old)original_texture_planex8p16(target,x,y,w,h,ox,factor,image,alternate.short_palette);else texture_planex8p16(target,x,y,w,h,ox,factor,image,alternate.short_palette);}
  else {if(old)original_texture_planex8p32(target,x,y,w,h,ox,factor,image,alternate.int_palette);else texture_planex8p32(target,x,y,w,h,ox,factor,image,alternate.int_palette);}
 }
}
static void valid_pixels(void) {
 static const int rects[][4]={{0,0,SW,SH},{-2,-1,12,5},{8,5,20,20},{SW,0,2,3},{0,0,0,SH}};
 for(int bytes=1;bytes<=4;bytes*=2)for(int wave=0;wave<2;++wave)for(int direct=0;direct<2;++direct)
 for(unsigned r=0;r<sizeof(rects)/sizeof(*rects);++r)for(int variant=0;variant<3;++variant) {
  reset(bytes);method.flag=variant;texture_set_wave(variant==2?-1.0f:2.0f);original_texture_set_wave(variant==2?-1.0f:2.0f);
  const int *q=rects[r];
  render(1,wave,direct,bytes,left,q[0],q[1],q[2],q[3],wave?4:256,0,variant?255:0,variant?-3:5,variant?10:0,&method);
  queries=0;render(0,wave,direct,bytes,right,q[0],q[1],q[2],q[3],wave?4:256,0,variant?255:0,variant?-3:5,variant?10:0,variant==2 && !direct?NULL:&method);
  if(!direct)CHECK(queries==0);
  CHECK(!memcmp(left->data,right->data,(size_t)SW*SH*bytes));
  CHECK(left->width==right->width && left->height==right->height && left->pixelformat==right->pixelformat);
 }
 /* Interior borrowed records use the existing containing-allocation query. */
 for(int bytes=1;bytes<=4;bytes*=2) {
  image=(s_bitmap*)(blocks[2].base+16);reset(bytes);texture_set_wave(1);original_texture_set_wave(1);
  original_apply_texture_wave(left,0,0,SW,SH,1,0,image,0,1,&method);queries=0;
  apply_texture_wave(right,0,0,SW,SH,1,0,image,0,1,&method);
  CHECK(queries>0);CHECK(!memcmp(left->data,right->data,(size_t)SW*SH*bytes));
  image=(s_bitmap*)blocks[2].base;
 }
 /* A negative row origin that has a nonnegative native remainder is valid. */
 reset(1);texture_set_wave(1);original_texture_set_wave(1);
 original_texture_wave(left,0,0,5,1,0,-BH,image,0,1);texture_wave(right,0,0,5,1,0,-BH,image,0,1);
 CHECK(!memcmp(left->data,right->data,SW*SH));

 /* Pixel transfers also accept unaligned but otherwise complete palettes. */
 for(int bytes=2;bytes<=4;bytes*=2) {
  union {unsigned short p16[256];unsigned int p32[256];} aligned;
  reset(bytes);texture_set_wave(1);original_texture_set_wave(1);
  if(bytes==2)for(int i=0;i<256;++i)aligned.p16[i]=(unsigned short)(i*257u+19u);
  else for(int i=0;i<256;++i)aligned.p32[i]=(unsigned int)i*UINT32_C(0x01020304)+31u;
  unsigned char *unaligned=image->palette+1;memcpy(unaligned,&aligned,(size_t)256*bytes);
  image->palette=(unsigned char*)&aligned;original_apply_texture_wave(left,0,0,SW,SH,1,0,image,0,1,&method);
  image->palette=unaligned;apply_texture_wave(right,0,0,SW,SH,1,0,image,0,1,&method);
  CHECK(!memcmp(left->data,right->data,(size_t)SW*SH*bytes));
 }
 static const float large_valid[]={16777216.0f,2147483520.0f,-2147483648.0f};
 for(unsigned i=0;i<sizeof(large_valid)/sizeof(*large_valid);++i) {
  reset(1);texture_set_wave(large_valid[i]);original_texture_set_wave(large_valid[i]);int origin=i==2?INT_MAX:0;
  original_texture_wave(left,0,0,5,1,origin,0,image,0,0);texture_wave(right,0,0,5,1,origin,0,image,0,0);
  CHECK(!memcmp(left->data,right->data,SW*SH));
 }
}
static void endpoint(void) {
 reset(1);unsigned char target[4]={0xa5,0xa5,0xa5,0xa5};
 unsigned char *source=blocks[2].base+offsetof(s_bitmap,data);
 native_line0(target,source,1,BW,BW,0,BW*BH);CHECK(target[0]==source[BW]);
 target[0]=0xa5;
 native_line0(target,source+(BH-1)*BW,1,BW,BW,0,BW);
 CHECK(target[0] == 0xa5);
 /* Known trailing bytes are part of the original backing and remain readable. */
 native_line0(target,source+(BH-1)*BW,1,BW,BW,0,BW+1);
 CHECK(target[0]==source[BW*BH]);
}
static void malformed(void) {
 for(int bytes=1;bytes<=4;bytes*=2)for(int wave=0;wave<2;++wave)for(int direct=0;direct<2;++direct) {
  for(int kind=0;kind<13;++kind) {
   reset(bytes);texture_set_wave(1);s_bitmap *saved=image;
   if(kind==0)image=NULL;if(kind==1)image->width=0;if(kind==2)image->height=-1;
   if(kind==3)left->width=0;if(kind==4)left->height=-1;
   if(kind==5)blocks[0].visible=offsetof(s_screen,data)+1;
   if(kind==6)blocks[2].visible=offsetof(s_bitmap,data)+1;
   if(kind==7 && !direct && bytes!=1)image->palette=NULL;
   if(kind==8 && !direct && bytes!=1)image->palette=blocks[2].base+blocks[2].visible-1;
   if(kind==12 && !direct && bytes!=1)image->palette=blocks[2].base+blocks[2].visible;
   if(kind==10)image->width=INT_MAX;if(kind==11)image->height=INT_MAX;
   s_screen *target=kind==9?NULL:left;
   if(kind==7 || kind==8 || kind==12){if(bytes==1 || direct)continue;}
   render(0,wave,direct,bytes,target,0,0,SW,SH,0,0,0,0,1,&method);
   image=saved;
   for(int i=0;i<SW*SH*bytes;++i)CHECK(left->data[i]==0xa5);
  }
 }
 for(int wave=0;wave<2;++wave) {
  reset(1);texture_set_wave(INFINITY);render(0,1,0,1,left,0,0,SW,SH,0,0,0,0,0,&method);
  for(int i=0;i<SW*SH;++i)CHECK(left->data[i]==0xa5);
  reset(1);texture_set_wave(1);
  render(0,wave,0,1,left,0,0,SW,SH,INT_MAX,INT_MAX,INT_MAX,INT_MAX,INT_MAX,&method);
  render(0,wave,0,1,right,0,0,SW,SH,INT_MAX,INT_MAX,INT_MAX,INT_MAX,INT_MAX,&method);
  CHECK(!memcmp(left->data,right->data,SW*SH));
 }
 for(int kind=0;kind<3;++kind) {
  reset(1);texture_set_wave(kind==0?NAN:kind==1?-INFINITY:FLT_MAX);
  texture_wave(left,0,0,SW,SH,0,0,image,0,0);
  for(int i=0;i<SW*SH;++i)CHECK(left->data[i]==0xa5);
 }
 for(int wave=0;wave<2;++wave) {
  reset(1);texture_set_wave(1);
  render(0,wave,0,1,left,1,1,INT_MAX,INT_MAX,0,0,0,0,1,&method);
  render(0,wave,0,1,right,1,1,INT_MAX,INT_MAX,0,0,0,0,1,&method);
  CHECK(!memcmp(left->data,right->data,SW*SH));
 }
 reset(1);texture_wave(left,0,0,SW,SH,0,-1,image,0,0);
 for(int i=0;i<SW*SH;++i)CHECK(left->data[i]==0xa5);
}
int main(void) {
 screen_bytes=sizeof(s_screen)+SW*SH*4+64;bitmap_bytes=sizeof(s_bitmap)+BW*BH+1024+64;
 for(unsigned i=0;i<3;++i){blocks[i].physical=i<2?screen_bytes:bitmap_bytes;blocks[i].visible=blocks[i].physical;blocks[i].base=malloc(blocks[i].physical);CHECK(blocks[i].base);}
 block_count=3;left=(s_screen*)blocks[0].base;right=(s_screen*)blocks[1].base;image=(s_bitmap*)blocks[2].base;
 static const unsigned profiles[]={@PROFILES@};
#ifdef ENDPOINT_ONLY
 endpoint();
#else
 for(unsigned i=0;i<sizeof(profiles)/sizeof(*profiles);++i){valid_pixels();endpoint();malformed();}
#endif
 for(unsigned i=0;i<3;++i)free(blocks[i].base);
 fprintf(stdout,"{\"status\":\"PASS\",\"profiles\":%u,\"checks\":%u}\n",(unsigned)(sizeof(profiles)/sizeof(*profiles)),checks);
 return 0;
}
