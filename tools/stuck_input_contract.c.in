#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef assert
#undef printf
#ifdef NDEBUG
#error Stuck input assertions must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do {if(!(c)){fprintf(stderr,"STUCK_INPUT revision=%u case=%u line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
static entity actor,platform_entity;
entity *self;
s_player player[MAX_PLAYERS];
static s_anim animation,*animations[ANI_DUCKATTACK+1];
static int platform_present,mutate,platform_mutate;
static void initial_action(void) {abort();}
static void callback_action(void) {abort();}
void common_attack_proc(void) {abort();}
static int action_id(void (*action)(void)) {
 if(!action)return 0;
 if(action==initial_action)return 1;
 if(action==callback_action)return 2;
 if(action==common_attack_proc)return 3;
 abort();
}
#define WIDTH 13
static void snapshot(double *out) {
 const double fields[]={action_id(actor.takeaction),actor.idling,actor.attacking,actor.running,
 actor.xdir,actor.zdir,actor.direction,actor.combostep[0],actor.playerindex,
 player[0].keys,player[0].playkeys,player[1].keys,player[1].playkeys};
 _Static_assert(sizeof(fields)/sizeof(*fields)==WIDTH,"Observer fields bound");
 _Static_assert(sizeof(player[0].playkeys)==4,"Native unsigned key domain");
 memcpy(out,fields,sizeof(fields));
}
struct event {int kind,value;double fields[WIDTH];};
static struct event events[3];static unsigned event_count;
static void observe(int kind,int value) {
 assert(event_count<3);struct event *out=&events[event_count++];
 out->kind=kind;out->value=value;snapshot(out->fields);
}
entity *check_platform_between(float x,float z,float amin,float amax,entity *exclude) {
 assert(x==9 && z==12 && amin==6 && amax==16 && exclude==self);
 observe(1,platform_present);
 if(platform_mutate){actor.takeaction=callback_action;actor.direction=1;
  actor.playerindex=1-actor.playerindex;
  player[actor.playerindex].keys=FLAG_MOVEDOWN;player[actor.playerindex].playkeys=FLAG_JUMP;}
 return platform_present?&platform_entity:NULL;
}
static void callback_writes(void) {
 if(mutate){actor.takeaction=callback_action;actor.idling=4;actor.attacking=3;actor.running=5;
  actor.xdir=7;actor.zdir=8;actor.combostep[0]=11;player[actor.playerindex].playkeys^=FLAG_ATTACK;}
}
void ent_set_anim(entity *e,int index,int reset) {
 assert(e==self && (index==ANI_DUCKATTACK || index==ANI_SLIDE) && !reset);
 observe(2,index);callback_writes();
}
int set_idle(entity *e) {assert(e==self);observe(3,1);callback_writes();return 1;}
@FUNCTION@
struct stuck_case {int slot;unsigned held,pending;int platform,duck,slide,mutate,platform_mutate,direction;};
static const struct stuck_case cases[]={@CASES@};
static const unsigned profiles[]={@PROFILES@};
static void prepare(const struct stuck_case *c) {
 memset(&actor,0,sizeof(actor));memset(&platform_entity,0,sizeof(platform_entity));
 memset(player,0,sizeof(player));memset(&animation,0,sizeof(animation));memset(animations,0,sizeof(animations));
 assert(c->slot==0 || c->slot==1);self=&actor;actor.takeaction=initial_action;
 actor.idling=1;actor.running=1;actor.xdir=2;actor.zdir=3;actor.direction=c->direction;actor.combostep[0]=5;
 actor.x=9;actor.z=12;actor.a=6;actor.modeldata.height=10;actor.playerindex=c->slot;
 player[0].keys=player[1].keys=0x1000u;player[0].playkeys=player[1].playkeys=0x2000u;
 player[c->slot].keys=c->held;player[c->slot].playkeys=c->pending;
 actor.modeldata.animation=animations;actor.modeldata.animation_capacity=ANI_DUCKATTACK+1;animation.numframes=1;
 animations[ANI_DUCKATTACK]=c->duck?&animation:NULL;animations[ANI_SLIDE]=c->slide?&animation:NULL;
 platform_present=c->platform;mutate=c->mutate;platform_mutate=c->platform_mutate;event_count=0;
}
static void fields_json(const double *v) {
 putchar('[');for(unsigned i=0;i<WIDTH;++i){if(i)putchar(',');printf("%.17g",v[i]);}putchar(']');
}
int main(void) {
 for(unsigned p=0;p<sizeof(profiles)/sizeof(*profiles);++p){
  obor_profile_build=profiles[p];
  for(unsigned k=0;k<sizeof(cases)/sizeof(*cases);++k){
   active_case=k;prepare(&cases[k]);common_stuck_underneath();double final[WIDTH];snapshot(final);
   printf("{\"revision\":%u,\"case\":%u,\"fields\":",obor_profile_build,k);fields_json(final);printf(",\"events\":[");
   for(unsigned i=0;i<event_count;++i){struct event *e=&events[i];if(i)putchar(',');printf("{\"kind\":%d,\"value\":%d,\"fields\":",e->kind,e->value);fields_json(e->fields);putchar('}');}
   puts("]}");
  }
 }
 return 0;
}
