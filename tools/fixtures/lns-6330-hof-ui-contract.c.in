#include <assert.h>
#include <stdbool.h>
#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <stdarg.h>
#include <stdlib.h>
#include <string.h>
#include @ABI@
@LIMITS@
@KEYS@
@RECORD@
typedef uint32_t u32;
static unsigned obor_profile_features;
static s_savescore savescore,*savescore_modes,records[20];
static unsigned short savescore_modes_count,savescore_difficulty_count;
static char *savescore_initials,*savescore_difficulty_variable,*savescore_difficulty_names[MAX_DIFFICULTIES];
@ALPHABET@
static int savescore_min_time,savescore_max_time,savescore_extra_time;
static int num_difficulties,current_set,current_level,noshare,hiscorebg,hallOfFame,scoreformat;
static char *custBkgrds;
static u32 _time,bothnewkeys;
static struct {int hRes,vRes,vShift;} videomodes;
static struct {int effectvol;} savedata;
static struct {unsigned score,credits;char name[MAX_NAME_LEN];void *ent;u32 newkeys;} player[MAX_PLAYERS];
typedef struct {char *name;int numlevels,maxplayers;s_savescore *savescore;} Set;
static Set sets[4],*levelsets;
typedef struct {int vt;int32_t lVal;} ScriptVariant;
#define VT_INTEGER 1
static ScriptVariant script_difficulty;
static int script_found,script_null;
static struct {void *list;} global_var_list;
static int List_FindByName(void *list,const char *name) {(void)list;assert(name);return script_found && !strcmp(name,"mode");}
static void *List_Retrieve(void *list) {(void)list;return script_null?NULL:&script_difficulty;}
#define Tr(text) (text)
#define SAMPLE_BEEP 7
#define MAX_EVENTS 4096
static struct Event {int kind,x,y,font,length;unsigned char text[128];} trace[MAX_EVENTS],expected_trace[MAX_EVENTS];
static unsigned event_count,frames,saves,new_one_credit,new_multiple_credits;
static unsigned input_mode,input_mask,player_limit_override;
static struct Frame {u32 time,global,keys[MAX_PLAYERS];} input[12];
static unsigned input_count;
static int width(int font) {return 5+font*2;}
/* Original long conversions come from a 32-bit runner. The supplied value is
 * u32. Normalize that one spelling before formatting in this host provider. */
static int format_message(char *out,size_t size,const char *format,va_list args) {
 if(!strcmp(format,"%09lu"))format="%09u";
 int n=vsnprintf(out,size,format,args);assert(n>=0 && (size_t)n<size);return n;
}
static void event(int kind,int x,int y,int font,const void *bytes,size_t length) {
 assert(event_count<MAX_EVENTS && length<=128);struct Event *e=&trace[event_count++];
 memset(e,0,sizeof(*e));e->kind=kind;e->x=x;e->y=y;e->font=font;e->length=(int)length;
 if(length)memcpy(e->text,bytes,length);
}
static int font_string_width(int font,const char *format,...) {
 char text[128];va_list args;va_start(args,format);int n=format_message(text,sizeof(text),format,args);va_end(args);
 return n*width(font);
}
static int fontmonowidth(int font) {return width(font);}
static int fontheight(int font) {return 9+font;}
static void font_printf(int x,int y,int font,int align,const char *format,...) {
 assert(align==0);char text[128];va_list args;va_start(args,format);int n=format_message(text,sizeof(text),format,args);va_end(args);event(1,x,y,font,text,(size_t)n);
}
@MACROS@
static void sound_play_sample(int sample,int loop,int left,int right,int pitch) {
 assert(sample==SAMPLE_BEEP && loop==0 && left==savedata.effectvol && right==left && pitch==100);event(2,sample,left,pitch,NULL,0);
}
static void load_background(const char *name,int flag) {assert(flag==0);event(3,0,0,0,name,strlen(name));}
static void load_cached_background(const char *name,int flag) {assert(flag==0);event(4,0,0,0,name,strlen(name));}
static void unload_background(void) {event(5,0,0,0,NULL,0);}
static int saveHighScoreFile(void) {++saves;event(6,0,0,0,NULL,0);return 1;}
static void update(int a,int b) {
 assert(a==0 && b==0 && frames<input_count);struct Frame *frame=&input[frames++];
 _time=frame->time;bothnewkeys=frame->global;
 for(unsigned p=0;p<MAX_PLAYERS;++p)player[p].newkeys=frame->keys[p];
 event(7,(int)frames,0,0,NULL,0);
}
@CANDIDATE@
@ORIGINALS@
static void setup(unsigned flags,unsigned seed,int tables) {
 obor_profile_features=flags;memset(records,0,sizeof(records));memset(&savescore,0,sizeof(savescore));memset(sets,0,sizeof(sets));memset(player,0,sizeof(player));
 memset(trace,0,sizeof(trace));event_count=frames=saves=0;
 levelsets=sets;num_difficulties=4;current_set=0;current_level=seed&128?5:4;noshare=(int)((seed>>8)&1);
 savescore_modes=tables?records:NULL;savescore_modes_count=2;savescore_difficulty_count=3;
 savescore_initials="ABC09!?";savescore_difficulty_variable="mode";
 script_found=1;script_null=0;script_difficulty.vt=VT_INTEGER;script_difficulty.lVal=seed%3;
 videomodes.hRes=320+(int)(seed%3)*80;videomodes.vRes=240+(int)(seed%2)*40;videomodes.vShift=seed%2?4:0;
 savedata.effectvol=37;scoreformat=seed%2;hiscorebg=seed%3!=0;custBkgrds=seed%3==2?"authored/":NULL;hallOfFame=0;
 savescore_min_time=8;savescore_max_time=20;savescore_extra_time=3;_time=99;bothnewkeys=0;
 for(unsigned i=0;i<MAX_DIFFICULTIES;++i)savescore_difficulty_names[i]="DIFFICULTY";
 static char *names[]={"SET A","SET B","SET C","SET D"};
 for(unsigned i=0;i<4;++i){sets[i].name=names[i];sets[i].numlevels=5;sets[i].maxplayers=player_limit_override?(int)player_limit_override:1+(seed%4);}
 sets[0].savescore=records;sets[3].savescore=records+3;
 for(unsigned i=0;i<20;++i) {
  records[i].compatibleversion=i==4?0:CV_HIGH_SCORE;records[i].mode=(unsigned short)((i/3)*3);records[i].difficulty=i%3;records[i].credits=3;
  for(unsigned row=0;row<10;++row) {
   records[i].highsc[row]=1000-row*100;snprintf(records[i].hscoren[row],MAX_NAME_LEN,"OLD%u_%u",i,row);
   memcpy(records[i].hscorei[row],"XYZ",NUM_INITIALS);records[i].is1CC[row]=(row%2)==0;
  }
 }
 savescore=records[0];
 unsigned pattern=seed%8,alive=(seed>>3)%16;
 for(unsigned p=0;p<MAX_PLAYERS;++p) {
  snprintf(player[p].name,MAX_NAME_LEN,"PLAYER_%u",p);player[p].ent=alive&(1u<<p)?&player[p]:NULL;player[p].credits=p==0 && seed%5==0?UINT32_MAX:p%3;
  switch(pattern) {
   case 0:player[p].score=0;break;case 1:player[p].score=UINT32_MAX-p*10;break;
   case 2:player[p].score=700;break;case 3:player[p].score=p?0:150;break;
   case 4:player[p].score=p?0:100;break;case 5:player[p].score=p?0:1000;break;
   case 6:player[p].score=UINT32_MAX;break;default:player[p].score=p?0:1001;break;
  }
 }
 input_count=8;memset(input,0,sizeof(input));
 unsigned buttons[]={FLAG_MOVEUP,FLAG_MOVERIGHT,FLAG_MOVEDOWN,FLAG_ATTACK,FLAG_START,0,0,0};
 for(unsigned f=0;f<input_count;++f) {
  input[f].time=f*GAME_SPEED;input[f].global=f==input_count-1?FLAG_ESC:0;
  for(unsigned p=0;p<MAX_PLAYERS;++p)input[f].keys[p]=buttons[f];
 }
 input[input_count-1].time=UINT32_MAX;
 if(input_mode==1)for(unsigned f=0;f<input_count-1;++f)for(unsigned p=0;p<MAX_PLAYERS;++p)input[f].keys[p]=input_mask;
 if(input_mode==2)for(unsigned f=0;f<input_count-1;++f)input[f].global=(f%2)?FLAG_MOVEUP:input_mask;
}
static struct Result {s_savescore records[20],single;unsigned events,frames,saves;int fame;u32 time;} expected;
static void remember(void) {
 memcpy(expected.records,records,sizeof(records));expected.single=savescore;expected.events=event_count;expected.frames=frames;expected.saves=saves;expected.fame=hallOfFame;expected.time=_time;
 memcpy(expected_trace,trace,event_count*sizeof(*trace));
}
static void compare(void) {
 assert(!memcmp(expected.records,records,sizeof(records)) && !memcmp(&expected.single,&savescore,sizeof(savescore)));
 assert(expected.events==event_count && expected.frames==frames && expected.saves==saves && expected.fame==hallOfFame && expected.time==_time);
 assert(!memcmp(expected_trace,trace,event_count*sizeof(*trace)));
}
static void compare_add(unsigned seed) {
 setup(OBOR_PROFILE_LNS_6330,seed,1);lns_hallfame_add();
 for(unsigned i=0;i<3;++i)for(unsigned row=0;row<10;++row)if(!strncmp(records[i].hscoren[row],"PLAYER_",7)) {
  if(records[i].is1CC[row])++new_one_credit;else ++new_multiple_credits;
 }
 remember();
 setup(OBOR_PROFILE_LNS_6330,seed,1);hallfame_add();compare();
}
static void show_dimensions(unsigned modes,unsigned difficulties) {
 savescore_modes_count=modes;savescore_difficulty_count=difficulties;
 for(unsigned i=0;i<modes*difficulties;++i){records[i].mode=(i/difficulties)*3;records[i].difficulty=i%difficulties;}
}
static void compare_show(unsigned seed) {
 unsigned modes=1+(seed%2),difficulties=seed%3==0?1:seed%3==1?3:10;
 setup(OBOR_PROFILE_LNS_6330,seed,1);show_dimensions(modes,difficulties);lns_hallfame_show();remember();
 setup(OBOR_PROFILE_LNS_6330,seed,1);show_dimensions(modes,difficulties);hallfame_show();compare();
}
static void compare_dispatch(unsigned flags,unsigned seed,int tables,int add) {
 setup(flags,seed,tables);
 if(flags&OBOR_PROFILE_LNS_6330)lns_hallfame(add);else if(flags&OBOR_PROFILE_ATTACK_HISTORY_FOUR)physical_hallfame(add);else official_hallfame(add);
 remember();setup(flags,seed,tables);hallfame(add);compare();
}
static void compare_difficulty_binding(void) {
 for(unsigned mode=0;mode<2;++mode) {
  setup(OBOR_PROFILE_LNS_6330,1,1);script_found=mode!=0;script_difficulty.vt=mode==1?0:VT_INTEGER;
  lns_hallfame_add();remember();
  setup(OBOR_PROFILE_LNS_6330,1,1);script_found=mode!=0;script_difficulty.vt=mode==1?0:VT_INTEGER;
  hallfame_add();compare();
 }
}
static void compare_defined_names_and_timers(void) {
 int limits[]={-3,-1,0,1,20};
 for(unsigned n=0;n<sizeof(limits)/sizeof(*limits);++n) {
  setup(OBOR_PROFILE_LNS_6330,0,1);savescore_min_time=limits[n];lns_hallfame_add();remember();
  setup(OBOR_PROFILE_LNS_6330,0,1);savescore_min_time=limits[n];hallfame_add();compare();
 }
 unsigned lengths[]={0,1,48,49};
 for(unsigned n=0;n<sizeof(lengths)/sizeof(*lengths);++n) {
  setup(OBOR_PROFILE_LNS_6330,1,1);memset(player[0].name,'q',lengths[n]);player[0].name[lengths[n]]=0;lns_hallfame_add();remember();
  setup(OBOR_PROFILE_LNS_6330,1,1);memset(player[0].name,'q',lengths[n]);player[0].name[lengths[n]]=0;hallfame_add();compare();
 }
}
static void compare_credit_boundaries(void) {
 const unsigned short credits[]={0,1,3,65535};
 const unsigned remaining[]={UINT32_MAX,0,2,65534};
 for(unsigned c=0;c<4;++c)for(unsigned match=0;match<2;++match) {
  setup(OBOR_PROFILE_LNS_6330,385,1);records[1].credits=credits[c];player[0].ent=player;
  player[0].credits=remaining[c]+(match?0:1);lns_hallfame_add();assert(records[1].is1CC[0]==(bool)match);remember();
  setup(OBOR_PROFILE_LNS_6330,385,1);records[1].credits=credits[c];player[0].ent=player;
  player[0].credits=remaining[c]+(match?0:1);hallfame_add();compare();
 }
}
static void safe_boundaries(void) {
 setup(OBOR_PROFILE_LNS_6330,1,1);script_difficulty.lVal=-1;hallfame_add();assert(!frames && !saves);
 setup(OBOR_PROFILE_LNS_6330,1,1);script_difficulty.lVal=3;hallfame_add();assert(!frames && !saves);
 setup(OBOR_PROFILE_LNS_6330,1,1);current_set=-1;hallfame_add();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);current_set=4;hallfame_add();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);levelsets=NULL;hallfame_add();hallfame_show();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);savescore_difficulty_count=MAX_DIFFICULTIES+1;hallfame_add();hallfame_show();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);savescore_modes_count=0;hallfame_show();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);records[0].mode=65535;hallfame_show();assert(!frames);
 setup(0,1,1);hallfame_add();hallfame_show();assert(!frames && !saves);
 setup(OBOR_PROFILE_LNS_6330,1,1);sets[0].savescore=NULL;hallfame_add();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);records[1].compatibleversion=0;hallfame_add();assert(!frames);
 setup(OBOR_PROFILE_LNS_6330,1,1);savescore_initials=NULL;savescore_difficulty_variable=NULL;hallfame_add();assert(saves==1);
 setup(OBOR_PROFILE_LNS_6330,1,1);script_null=1;hallfame_add();assert(saves==1);
 setup(OBOR_PROFILE_LNS_6330,1,1);savescore_initials="";hallfame_add();assert(saves==1);
 for(unsigned row=0;row<4;++row)for(unsigned n=0;n<NUM_INITIALS;++n)assert(records[1].hscorei[row][n]==0);
 setup(OBOR_PROFILE_LNS_6330,1,1);savescore_initials=NULL;hallfame_add();assert(saves==1);
 assert(!memcmp(records[1].hscorei[0],"B_A",NUM_INITIALS));
 /* A player pushed out of row 9 must not update row 10's initials. */
 setup(OBOR_PROFILE_LNS_6330,0,1);current_level=5;player[0].score=150;player[1].score=2000;sets[0].maxplayers=2;hallfame_add();assert(saves==1 && records[0].highsc[0]==2000);
 /* Names and timers remain safe when inputs exceed the source's defined range. */
 setup(OBOR_PROFILE_LNS_6330,1,1);memset(player[0].name,'q',MAX_NAME_LEN);hallfame_add();assert(records[1].hscoren[0][MAX_NAME_LEN-1]==0);
 setup(OBOR_PROFILE_LNS_6330,0,1);savescore_min_time=INT32_MAX;hallfame_add();assert(frames==8);
 setup(OBOR_PROFILE_LNS_6330,0,1);savescore_min_time=INT32_MIN;hallfame_add();assert(frames==2);
}
int main(void) {
 static const char expected_alphabet[]= @EXPECTED_ALPHABET@;
 assert(sizeof(savescore_initials_default)==sizeof(expected_alphabet));assert(!memcmp(savescore_initials_default,expected_alphabet,sizeof(expected_alphabet)));
 for(unsigned seed=0;seed<512;++seed)compare_add(seed);
 const unsigned keys[]={FLAG_MOVEUP,FLAG_MOVEDOWN,FLAG_MOVELEFT,FLAG_MOVERIGHT,FLAG_ATTACK,FLAG_START,FLAG_ATTACK2,FLAG_ATTACK3,FLAG_ATTACK4};
 input_mode=1;
 for(unsigned mask=0;mask<512;++mask) {
  input_mask=0;for(unsigned k=0;k<9;++k)if(mask&(1u<<k))input_mask|=keys[k];
  for(unsigned p=0;p<4;++p){player_limit_override=p+1;compare_add(129);}
 }
 player_limit_override=0;input_mode=2;
 for(unsigned mask=0;mask<512;++mask) {
  input_mask=0;for(unsigned k=0;k<9;++k)if(mask&(1u<<k))input_mask|=keys[k];
  compare_show(mask);compare_show(mask+64);
 }
 input_mode=0;
 unsigned flags[]={0,OBOR_PROFILE_ATTACK_HISTORY_FOUR,OBOR_PROFILE_LNS_6330};
 for(unsigned m=0;m<3;++m)for(unsigned seed=0;seed<12;++seed)for(int tables=0;tables<2;++tables)for(int add=0;add<2;++add)compare_dispatch(flags[m],seed,tables,add);
 compare_difficulty_binding();compare_defined_names_and_timers();compare_credit_boundaries();safe_boundaries();
 assert(new_one_credit && new_multiple_credits);
 fprintf(stderr,"HOF source comparisons include %u new 1CC and %u other new records\n",new_one_credit,new_multiple_credits);return 0;
}
