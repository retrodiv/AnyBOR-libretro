#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <strings.h>
#include <stdarg.h>
#include @ABI@
static uint32_t obor_profile_features;
@KEYS@
@LIMITS@
@CONTROL@
#define stricmp strcasecmp
#define Tr(text) (text)
typedef struct {int identity;} Controls;
static Controls controls[MAX_PLAYERS],default_control;
static Controls *playercontrolpointers[MAX_PLAYERS]={&controls[0],&controls[1],&controls[2],&controls[3]};
static struct Savedata {int keys[MAX_PLAYERS][MAX_BTN_NUM],joyrumble[MAX_PLAYERS];} savedata;
static int default_keys[MAX_BTN_NUM];
static struct {int hRes,vRes;} videomodes;
static unsigned metric;
static struct Event {int kind,a,b,c,d;uint32_t flags;char text[64];} events[128],expected_events[128];
static unsigned event_count;
static void control_setkey(Controls *control,uint32_t flags,int key) {
 int identity=-1;if(control==&default_control)identity=MAX_PLAYERS;
 for(unsigned i=0;i<MAX_PLAYERS;++i)if(control==&controls[i])identity=(int)i;
 assert(identity>=0 && event_count<128);struct Event *event=&events[event_count++];memset(event,0,sizeof(*event));event->kind=1;event->a=identity;event->flags=flags;event->b=key;
}
static int fontmonowidth(int font) {return 5+font*2+(int)metric;}
static int fontheight(int font) {return 9+font+(int)metric;}
static int font_string_width(int font,const char *format,...) {
 char text[64];va_list args;va_start(args,format);int n=vsnprintf(text,sizeof(text),format,args);va_end(args);assert(n>=0 && n<64);return n*fontmonowidth(font);
}
static void font_printf(int x,int y,int font,int align,const char *format,...) {
 assert(event_count<128);struct Event *event=&events[event_count++];memset(event,0,sizeof(*event));event->kind=2;event->a=x;event->b=y;event->c=font;event->d=align;
 va_list args;va_start(args,format);int n=vsnprintf(event->text,sizeof(event->text),format,args);va_end(args);assert(n>=0 && n<64);
}
@MACROS@
@CANDIDATE@
@ORIGINALS@
static struct Result {struct Savedata saved;int defaults[MAX_BTN_NUM];char labels[MAX_BTN_NUM][32];unsigned count;} expected;
static void reset(unsigned family,unsigned seed) {
 obor_profile_features=family==2?OBOR_PROFILE_LNS_6330:(seed&1?OBOR_PROFILE_ATTACK_HISTORY_FOUR:0);event_count=0;memset(events,0,sizeof(events));
 for(unsigned p=0;p<MAX_PLAYERS;++p) {
  savedata.joyrumble[p]=17+(int)p;
  for(unsigned key=0;key<MAX_BTN_NUM;++key)savedata.keys[p][key]=1000+(int)(seed*100+p*MAX_BTN_NUM+key);
 }
 for(unsigned key=0;key<MAX_BTN_NUM;++key)default_keys[key]=2000+(int)key;
 videomodes.hRes=320+(int)seed*2;videomodes.vRes=240+(int)seed;metric=seed%3;
}
static void remember(void) {
 expected.saved=savedata;memcpy(expected.defaults,default_keys,sizeof(default_keys));expected.count=event_count;memcpy(expected_events,events,event_count*sizeof(*events));
}
static void compare(void) {
 assert(!memcmp(&expected.saved,&savedata,sizeof(savedata)) && !memcmp(expected.defaults,default_keys,sizeof(default_keys)));
 assert(expected.count==event_count && !memcmp(expected_events,events,event_count*sizeof(*events)));
}
static void original_clear(unsigned family,int p) {if(family==0)official_clearbuttons(p);else if(family==1)physical_clearbuttons(p);else lns_clearbuttons(p);}
static void original_apply(unsigned family) {if(family==0)official_apply_controls();else if(family==1)physical_apply_controls();else lns_apply_controls();}
static int original_slot(unsigned family,char *name) {return family==0?official_translate_SDID(name):family==1?physical_translate_SDID(name):lns_translate_SDID(name);}
static void original_labels(unsigned family,char labels[MAX_BTN_NUM][32]) {if(family==0)official_labels(labels);else if(family==1)physical_labels(labels);else lns_labels(labels);}
static void original_title(unsigned family,int p) {if(family==0)official_title(p);else if(family==1)physical_title(p);else lns_title(p);}
int main(void) {
 unsigned binding_cases=0,label_cases=0,translation_cases=0;
 char *names[]={"moveup","movedown","moveleft","moveright","attack","attack2","attack3","attack4","jump","special","start","screenshot","esc","ATTACK2","Special","unknown",""};
 for(unsigned family=0;family<3;++family)for(unsigned seed=0;seed<16;++seed)for(unsigned mask=0;mask<16;++mask) {
  reset(family,seed);for(unsigned i=0;i<MAX_PLAYERS;++i){unsigned p=(i+seed)%MAX_PLAYERS;if(mask&(1u<<p))original_clear(family,(int)p);}original_apply(family);remember();
  reset(family,seed);for(unsigned i=0;i<MAX_PLAYERS;++i){unsigned p=(i+seed)%MAX_PLAYERS;if(mask&(1u<<p))clearbuttons((int)p);}apply_controls();compare();++binding_cases;
 }
 for(unsigned family=0;family<3;++family)for(unsigned seed=0;seed<8;++seed) {
  char labels[MAX_BTN_NUM][32];reset(family,seed);memset(expected.labels,0,sizeof(expected.labels));original_labels(family,expected.labels);for(unsigned p=0;p<MAX_PLAYERS;++p)original_title(family,(int)p);remember();
  reset(family,seed);memset(labels,0,sizeof(labels));candidate_labels(labels);for(unsigned p=0;p<MAX_PLAYERS;++p)candidate_title((int)p);compare();assert(!memcmp(expected.labels,labels,sizeof(labels)));++label_cases;
  for(unsigned n=0;n<sizeof(names)/sizeof(*names);++n){assert(original_slot(family,names[n])==translate_SDID(names[n]));++translation_cases;}
 }
 fprintf(stderr,"Key-slot/default/binding comparisons: %u; keyboard labels/title: %u; name translations: %u\n",binding_cases,label_cases,translation_cases);return 0;
}
