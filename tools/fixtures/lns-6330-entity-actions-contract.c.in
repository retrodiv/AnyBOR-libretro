#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef printf
void exitIfFalse(int value,const char *condition,const char *func,const char *file,int line) {
    if(!value) {fprintf(stderr,"%s:%d %s: %s\n",file,line,func,condition);abort();}
}
uint32_t obor_profile_build,obor_profile_features;
int PLAYER_MIN_Z=160;
float advancex,advancey;
s_videomodes videomodes;
s_level area,*level=&area;
entity *self;
static entity actors[3];
static s_anim animations[8],*animation_table[8];
int max_attack_types=4;
static int rise_ids[4]={0,1,2,3},back_ids[4]={4,5,6,7};
int *animriseattacks=rise_ids,*animbackriseattacks=back_ids;
static unsigned char palettes[4][4],*colourmaps[3];
static s_item_properties properties;
static struct {unsigned count;double values[64];} trace;
static s_spawn_entry captured_spawn;
static int spawn_success,child_type,platform_success;
static float returned_y;
static int use_mirror;
static void record(double v) {assert(trace.count<64);trace.values[trace.count++]=v;}
void ent_set_anim(entity *e,int id,int reset) {
    assert(e==actors && id>=0 && id<8 && animation_table[id]);
    record(1);record(id);record(reset);record(e->projectile);
    e->animnum=(unsigned)id;e->animation=animation_table[id];e->animpos=0;
}
int reset_backpain(entity *e) {assert(e==actors);record(2);e->inbackpain=0;return 1;}
void common_attack_proc(void) {}
entity *smartspawn(s_spawn_entry *p) {
    record(3);memcpy(&captured_spawn,p,sizeof(*p));
    if(!spawn_success)return NULL;
    actors[2].position.y=returned_y;actors[2].modeldata.type=child_type;return actors+2;
}
entity *check_platform_between(float x,float z,float lo,float hi,entity *e) {
    assert(e==actors);record(4);record(x);record(z);record(lo);record(hi);
    return platform_success?actors+2:NULL;
}
@CANDIDATE@
@ORIGINAL@
@DISPLAY@
static void reset(void) {
    memset(actors,0,sizeof actors);memset(&trace,0,sizeof trace);memset(&captured_spawn,0,sizeof captured_spawn);
    memset(&area,0,sizeof area);self=actors;level=&area;
    animriseattacks=rise_ids;animbackriseattacks=back_ids;max_attack_types=4;
}
static void rise_setup(unsigned mask,int model,int back,int self_id) {
    reset();self=actors+self_id;
    for(unsigned i=0;i<8;i++) {memset(animations+i,0,sizeof(*animations));animations[i].numframes=1;animation_table[i]=(mask&(1u<<i))?animations+i:NULL;}
    actors[0].modeldata.animation=animation_table;actors[0].modeldata.animation_capacity=8;
    actors[0].modeldata.riseattacktype=model;actors[0].inbackpain=back;
    actors[0].modeldata.jugglepoints.current=3;actors[0].modeldata.jugglepoints.max=9;
    actors[0].projectile=7;actors[0].inpain=actors[0].falling=actors[0].rising=actors[0].drop=1;
    actors[0].ducking=DUCK_ACTIVE;actors[0].idling=IDLING_ACTIVE;actors[0].attacking=ATTACKING_ACTIVE;
    actors[0].nograb=1;actors[0].nograb_default=3;
    actors[0].staydown.riseattack_stall=actors[1].staydown.riseattack_stall=42;
}
int main(void) {
    void (*maps[])(entity *,unsigned)={official_ent_set_colourmap,physical_ent_set_colourmap,lns_ent_set_colourmap};
    int (*rises[])(entity *,int,int)={official_set_riseattack,physical_set_riseattack,lns_set_riseattack};
    entity *(*drops[])(entity *)={official_drop_item,physical_drop_item,lns_drop_item};
    entity *(*obstacles[])(entity *)={official_check_block_obstacle,physical_check_block_obstacle,lns_check_block_obstacle};
    int (*sorts[])(entity *)={official_sort,physical_sort,lns_sort};
    int (*mirrors[])(entity *)={official_mirror,physical_mirror,lns_mirror};
    static const int owner_maps[]={-2147483647-1,-1,0,1,2,3,2147483647};
    static const unsigned selections[]={0,1,2,3,4,2147483647u,4294967295u};
    static const unsigned availability[]={0,1,2,4,8,16,32,64,128,15,240,255,85,170,129,24};
    static const int heights[]={-10,0,10};static const float ys[]={-20.5f,-1,0,1.5f,20};
    static const float xs[]={-0.5f,0,319.5f,320,320.5f},zs[]={-0.5f,0,239.5f,240,240.5f},drop_ys[]={-100,-1.25f,0,2.25f,100};
    static const float mirror_z[]={154.9f,155,155.1f};
    static const unsigned moves[]={0,AIMOVE1_STAR,AIMOVE1_BOOMERANG,AIMOVE1_STAR|AIMOVE1_BOOMERANG,AIMOVE1_ARROW,AIMOVE1_STAR|AIMOVE1_ARROW,AIMOVE1_BOOMERANG|AIMOVE1_ARROW,AIMOVE1_STAR|AIMOVE1_BOOMERANG|AIMOVE1_ARROW};
    unsigned map_cases=0,rise_cases=0,obstacle_cases=0,drop_cases=0,display_cases=0;
    for(unsigned i=0;i<3;i++)colourmaps[i]=palettes[i+1];
    for(unsigned oracle=0;oracle<3;oracle++)for(unsigned flags=0;flags<8;flags++) {
        if(((flags&OBOR_PROFILE_LNS_6330)!=0)!=(oracle==2))continue;
        obor_profile_build=oracle==1?6391:6330;obor_profile_features=flags;
        for(unsigned parent=0;parent<2;parent++)for(unsigned om=0;om<7;om++)for(unsigned count=0;count<=3;count++)for(unsigned which=0;which<7;which++) {
            reset();actors[0].owner=parent?actors+1:NULL;actors[1].map=owner_maps[om];
            actors[0].modeldata.maps_loaded=count;actors[0].modeldata.palette=palettes[0];actors[0].modeldata.colourmap=colourmaps;
            candidate_ent_set_colourmap(actors,selections[which]);int result=actors[0].map;unsigned char *palette=actors[0].colourmap;
            actors[0].map=-99;actors[0].colourmap=NULL;maps[oracle](actors,selections[which]);
            assert(result==actors[0].map && palette==actors[0].colourmap);map_cases++;
        }
        for(unsigned mask=0;mask<16;mask++)for(int model=-1;model<=4;model++)for(int back=0;back<=1;back++)
        for(int type=0;type<4;type++)for(int reset_mode=-1;reset_mode<=1;reset_mode++)for(int si=0;si<2;si++) {
            rise_setup(availability[mask],model,back,si);
            int a=candidate_set_riseattack(actors,type,reset_mode);
            unsigned char saved_actor[sizeof actors],saved_trace[sizeof trace];memcpy(saved_actor,actors,sizeof actors);memcpy(saved_trace,&trace,sizeof trace);
            rise_setup(availability[mask],model,back,si);int b=rises[oracle](actors,type,reset_mode);
            assert(a==b && !memcmp(saved_actor,actors,sizeof actors) && !memcmp(saved_trace,&trace,sizeof trace));rise_cases++;
        }
        rise_setup(255,3,0,0);assert(candidate_set_riseattack(NULL,0,0)==0);
        animriseattacks=NULL;assert(candidate_set_riseattack(actors,0,0)==0);
        rise_setup(255,3,0,0);max_attack_types=0;assert(candidate_set_riseattack(actors,0,0)==0);
        rise_setup(255,3,1,0);animbackriseattacks=NULL;assert(candidate_set_riseattack(actors,0,0)==0);
        rise_setup(255,3,0,0);
        for(int a=0;a<3;a++)for(int m=0;m<3;m++)for(int y=0;y<5;y++)for(int subject=-1;subject<=2;subject++)for(int found=0;found<=1;found++) {
            reset();actors[0].animation=animations;animations[0].size.y=heights[a];actors[0].modeldata.size.y=heights[m];actors[0].modeldata.subject_to_platform=subject;
            actors[0].position.x=7.25f;actors[0].position.z=9.5f;actors[0].position.y=ys[y];platform_success=found;
            entity *a_result=candidate_check_block_obstacle(actors);unsigned char saved[sizeof trace];memcpy(saved,&trace,sizeof trace);memset(&trace,0,sizeof trace);
            entity *b_result=obstacles[oracle](actors);assert(a_result==b_result && !memcmp(saved,&trace,sizeof trace));obstacle_cases++;
        }
        for(unsigned x=0;x<5;x++)for(unsigned z=0;z<5;z++)for(unsigned y=0;y<5;y++)for(int vertical=0;vertical<2;vertical++)for(int success=0;success<2;success++) {
            reset();videomodes.hRes=320;videomodes.vRes=240;advancex=-100;advancey=30;
            actors[0].position.x=advancex+xs[x];actors[0].position.z=advancey+zs[z];actors[0].position.y=5.5f;
            actors[0].item_properties=&properties;memset(&properties,0,sizeof properties);properties.index=3;strcpy(properties.alias,"drop");properties.health=7;properties.alpha=1;properties.colorset=2;
            actors[0].boss=(x+z)&1;actors[0].direction=(x+y)&1;child_type=(z+y)&1?TYPE_ENEMY:TYPE_ITEM;
            area.scrolldir=vertical?(x&1?SCROLL_UP:SCROLL_DOWN):0;returned_y=drop_ys[y];spawn_success=success;
            entity *a_result=candidate_drop_item(actors);unsigned char saved_actor[sizeof actors],saved_trace[sizeof trace],saved_spawn[sizeof captured_spawn];
            memcpy(saved_actor,actors,sizeof actors);memcpy(saved_trace,&trace,sizeof trace);memcpy(saved_spawn,&captured_spawn,sizeof captured_spawn);
            memset(actors+2,0,sizeof actors[2]);memset(&trace,0,sizeof trace);memset(&captured_spawn,0,sizeof captured_spawn);
            entity *b_result=drops[oracle](actors);
            assert(a_result==b_result && !memcmp(saved_actor,actors,sizeof actors) && !memcmp(saved_trace,&trace,sizeof trace) && !memcmp(saved_spawn,&captured_spawn,sizeof captured_spawn));drop_cases++;
        }
        reset();assert(candidate_drop_item(actors)==NULL && drops[oracle](actors)==NULL && !trace.count);drop_cases++;
        for(unsigned eflags=0;eflags<8;eflags++)for(unsigned sflags=0;sflags<8;sflags++)for(int ez=0;ez<3;ez++)for(int sz=0;sz<3;sz++)for(use_mirror=0;use_mirror<2;use_mirror++) {
            reset();actors[0].modeldata.aimove=moves[eflags];actors[1].modeldata.aimove=moves[sflags];actors[0].position.z=mirror_z[ez];actors[1].position.z=mirror_z[sz];self=actors+1;
            assert(candidate_sort(actors)==sorts[oracle](actors));assert(candidate_mirror(actors)==mirrors[oracle](actors));display_cases++;
            if(flags&OBOR_PROFILE_LNS_6330) {self=NULL;assert(candidate_sort(actors)==sorts[oracle](actors));assert(candidate_mirror(actors)==mirrors[oracle](actors));display_cases++;}
        }
    }
    assert(map_cases==4704 && rise_cases==55296 && obstacle_cases==4320 && drop_cases==6012 && display_cases==18432);
    printf("maps %u rise %u obstacle %u drop %u display %u\n",map_cases,rise_cases,obstacle_cases,drop_cases,display_cases);return 0;
}
