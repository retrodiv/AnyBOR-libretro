 * Native loading directives, number conversion, mapper and height getter.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <stdarg.h>
#include "openbor.h"
#undef printf
#undef assert
#ifdef NDEBUG
#error Animation-height assertions must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do {if(!(c)){fprintf(stderr,"Animation height revision=%u case=%u line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
HRESULT Interpreter_Call(Interpreter *p) { (void)p; abort(); }
HRESULT Interpreter_EvalInstruction(Interpreter *p) { (void)p; abort(); }
static char strings[32][128],diagnostic[4096];
static int used[32];
static entity actor;
static s_anim animation;
int StrCache_Pop(void)
{for(int i=0;i<32;++i)if(!used[i]){used[i]=1;strings[i][0]=0;return i;}abort();}
void StrCache_Collect(int i) {assert(i>=0 && i<32 && used[i]);used[i]=0;}
CHAR *StrCache_Get(int i) {assert(i>=0 && i<32 && used[i]);return strings[i];}
void StrCache_Copy(int i,CHAR *text)
{assert(i>=0 && i<32 && used[i] && strlen(text)<sizeof(strings[i]));strcpy(strings[i],text);}
static int record_printf(const char *format,...)
{va_list args;va_start(args,format);size_t len=strlen(diagnostic);int n=vsnprintf(diagnostic+len,sizeof(diagnostic)-len,format,args);va_end(args);assert(n>=0 && (size_t)n<sizeof(diagnostic)-len);return n;}
@VARIANTS@
@SEARCH@
#define printf record_printf
@NUMBERS@
@MACROS@
@DECLARATIONS@
@GETTER@
static void height_directive(int animated,int value)
{
    enum {CMD_MODEL_HEIGHT,CMD_MODEL_ANIMHEIGHT};
    ArgList arglist={0};s_model *newchar=&actor.modeldata;s_anim *newanim=&animation;
    char number[32],*filename="fixture",*command=animated?"animheight":"height";
    snprintf(number,sizeof(number),"%d",value);arglist.count=2;
    arglist.args[0]=command;arglist.args[1]=number;
    switch(animated?CMD_MODEL_ANIMHEIGHT:CMD_MODEL_HEIGHT){@DIRECTIVES@}
}
#undef printf
static const struct {uint32_t revision;int property,read_loaded_height;} contexts[]={@CONTEXTS@};
static const int heights[]={@HEIGHTS@},widths[]={@WIDTHS@};
static void property_value(ScriptVariant *value,int named,int property)
{
    memset(value,0,sizeof(*value));
    if(named){ScriptVariant_ChangeType(value,VT_STR);StrCache_Copy(value->strVal,"animheight");}
    else {value->vt=VT_INTEGER;value->lVal=property;}
}
int main(void)
{
    for(unsigned p=0;p<sizeof(contexts)/sizeof(contexts[0]);++p)
    {
        obor_profile_build=contexts[p].revision;active_case=0;diagnostic[0]=0;
        for(unsigned h=0;h<sizeof(heights)/sizeof(heights[0]);++h)
        for(unsigned w=0;w<sizeof(widths)/sizeof(widths[0]);++w)
        {
            memset(&actor,0,sizeof(actor));memset(&animation,0,sizeof(animation));actor.animation=&animation;
            animation.size.x=widths[w];animation.size.y=7;actor.modeldata.size.y=200;
            height_directive(0,heights[h]);assert(actor.modeldata.size.y==heights[h]);
            for(int animated=0;animated<2;++animated)
            {
                if(animated)height_directive(1,heights[h]);
                for(int named=0;named<2;++named)for(int premap=0;premap<2;++premap)
                {
                    ScriptVariant handle={.vt=VT_PTR},property,*args[]={&handle,&property};handle.ptrVal=&actor;
                    property_value(&property,named,contexts[p].property);
                    if(premap)assert(mapstrings_entityproperty(args,2)==1);
                    for(int repeat=0;repeat<2;++repeat)
                    {
                        ScriptVariant result={.vt=VT_EMPTY},*output=&result;++active_case;
                        assert(openbor_getentityproperty(args,&output,2)==S_OK && output==&result);
                        int expected=contexts[p].read_loaded_height?(animated?heights[h]:7):widths[w];
                        assert(result.vt==VT_INTEGER && result.lVal==expected);
                        assert(property.vt==VT_INTEGER && property.lVal==contexts[p].property);
                        assert(animation.size.x==widths[w] && animation.size.y==(animated?heights[h]:7));
                        assert(actor.modeldata.size.y==heights[h] && !diagnostic[0]);ScriptVariant_Clear(&result);
                    }
                    ScriptVariant_Clear(&property);for(int i=0;i<32;++i)assert(!used[i]);
                }
            }
        }
        for(int named=0;named<2;++named)
        {
            ScriptVariant handle={.vt=VT_PTR,.ptrVal=NULL},property,result={.vt=VT_EMPTY},*output=&result,*args[]={&handle,&property};
            property_value(&property,named,contexts[p].property);++active_case;
            assert(openbor_getentityproperty(args,&output,2)==S_OK && output==&result && result.vt==VT_EMPTY);
            assert(!diagnostic[0]);ScriptVariant_Clear(&property);for(int i=0;i<32;++i)assert(!used[i]);
        }
        printf("{\"revision\":%u,\"cases\":%u,\"status\":\"PASS\"}\n",obor_profile_build,active_case);
    }
    return 0;
}
