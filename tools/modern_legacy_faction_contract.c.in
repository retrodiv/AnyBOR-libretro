#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#pragma GCC diagnostic ignored "-Wignored-qualifiers"
#if defined(__clang__)
#pragma GCC diagnostic ignored "-Wdeprecated-non-prototype"
#endif
#include "scriptcommon.h"
#undef printf
#undef stricmp
#define stricmp strcasecmp

uint32_t obor_profile_build;

void ScriptVariant_Clear(ScriptVariant *value) { *value = (ScriptVariant){0}; }
void ScriptVariant_ChangeType(ScriptVariant *value, VARTYPE type) { value->vt = type; }
HRESULT ScriptVariant_IntegerValue(ScriptVariant *value, LONG *number)
{
    if (value->vt != VT_INTEGER)
    {
        return E_FAIL;
    }
    *number = value->lVal;
    return S_OK;
}

@CONSTANT_HELPER@
@CONSTANT_MACRO@

static int lookup(const char *constname, uint32_t *value)
{
    ScriptVariant v = {0};
    if (0) {}
    @CONSTANT_NAMES@
    else { return 0; }
    *value = v.lVal;
    return 1;
}

#define printf(...) ((void)0)
@ROUTINES@
#undef printf

static unsigned registrations;

static void check(int pass, const char *label)
{
    if (!pass)
    {
        fprintf(stderr, "%u: %s\n", obor_profile_build, label);
        abort();
    }
}

static void register_faction(void *routine, const char *name)
{
    if (strcmp(name, "get_faction_property") == 0 && routine == (void*)openbor_get_faction_property)
    {
        registrations |= 1;
    }
    else if (strcmp(name, "set_faction_property") == 0 && routine == (void*)openbor_set_faction_property)
    {
        registrations |= 2;
    }
    else
    {
        abort();
    }
}

static void register_runtime_functions(void)
{
    #define List_InsertAfter(list, routine, name) register_faction(routine, name)
    @REGISTRATION@
    #undef List_InsertAfter
}

static void check_mask(int field, uint32_t original, e_entity_type *native_type, uint32_t expected,
                       s_faction *faction)
{
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = faction};
    ScriptVariant name = {.vt = VT_INTEGER, .lVal = field};
    ScriptVariant input = {.vt = VT_INTEGER, .lVal = (LONG)original};
    ScriptVariant result = {0}, *output = &result;
    ScriptVariant *args[] = {&handle, &name, &input};
    check(openbor_set_faction_property(args, &output, 3) == S_OK, "Faction mask setter");
    if (native_type)
    {
        check((uint32_t)*native_type == expected, "Faction type mask reaches the original canonical types");
    }
    check(openbor_get_faction_property(args, &output, 2) == S_OK &&
          result.vt == VT_INTEGER && (uint32_t)result.lVal == original, "Faction mask numeric round trip");
}

int main(void)
{
    static const struct { unsigned revision, model_index; } profiles[] = {
        {7369,0}, {7391,0}, {7420,0}, {7444,0}, {7445,0}, {7446,2}, {7447,2}, {7454,3},
        {7459,4}, {7470,5}, {7471,6}, {7482,7}, {7487,6}, {7489,7}, {7493,10},
        {7495,17}, {7497,18}, {7503,18}, {7504,17}, {7524,18}, {7533,18}
    };
    static entity actor;
    static s_model template;
    for (size_t i = 0; i < sizeof(profiles) / sizeof(*profiles); ++i)
    {
        obor_profile_build = profiles[i].revision;
        const int active = obor_profile_build >= 7445;
        const int modern_groups = obor_profile_build >= 7447;
        uint32_t value = 0;
        registrations = 0;
        register_runtime_functions();
        check(registrations == (active ? 3u : 0u), "Faction API registration boundary");
        check(lookup("FACTION_GROUP_A", &value) == active, "Group constant introduction");
        check(lookup("FACTION_PROPERTY_TYPE_HOSTILE", &value) == active, "Faction property constant introduction");
        check(lookup("ENTITY_PROPERTY_FACTION", &value) == active, "Entity faction handle admission");
        const s_property_access_map map = entity_get_property_map(&actor, ENTITY_PROPERTY_FACTION);
        check(active ? map.field == &actor.faction && map.type == VT_PTR : map.field != &actor.faction,
              "Entity faction points to the actor's live data");
        const int model_available = profiles[i].model_index != 0;
        check(lookup("MODEL_PROPERTY_FACTION", &value) == model_available, "Model faction handle admission");
        if (model_available)
        {
            check(value == profiles[i].model_index, "Model faction's original selector ordinal");
            const s_property_access_map model = model_get_property_map(&template, value);
            check(model.field == &template.faction &&
                  model.type == (obor_profile_build < 7504 ? VT_PTR : VT_INTEGER),
                  "Model faction property retains its original result type");
        }
        else
        {
            check(model_get_property_map(&template, MODEL_PROPERTY_FACTION).field == NULL,
                  "The shared model index cannot expose unavailable faction storage");
        }
        if (!active)
        {
            ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor.faction};
            ScriptVariant property = {.vt = VT_INTEGER, .lVal = FACTION_PROPERTY_GROUP_MEMBER};
            ScriptVariant input = {.vt = VT_INTEGER, .lVal = 0};
            ScriptVariant result = {0}, *out = &result;
            ScriptVariant *args[] = {&handle, &property, &input};
            check(openbor_get_faction_property(args, &out, 2) == E_FAIL && !out,
                  "Unavailable faction getter rejects direct invocation");
            out = &result;
            check(openbor_set_faction_property(args, &out, 3) == E_FAIL && !out,
                  "Unavailable faction setter rejects direct invocation");
            continue;
        }
        check(lookup("FACTION_GROUP_Z", &value) && value == (UINT32_C(1) << (modern_groups ? 30 : 28)),
              "Original last faction group bit");
        check(lookup("FACTION_GROUP_DEFAULT", &value) == modern_groups, "Default group name introduction");
        check(lookup("FACTION_GROUP_NEUTRAL", &value) == modern_groups, "Neutral group name introduction");
        check(lookup("FACTION_GROUP_ALL", &value) &&
              value == (modern_groups ? UINT32_C(0x7ffffffc) : UINT32_C(0x1fffffff)), "All-group constant");

        for (int field = FACTION_PROPERTY_GROUP_DAMAGE_DIRECT; field <= FACTION_PROPERTY_GROUP_MEMBER; ++field)
        {
            for (unsigned bit = 0; bit < 32; ++bit)
            {
                check_mask(field, UINT32_C(1) << bit, NULL, 0, &actor.faction);
            }
        }
        const uint32_t type = modern_groups ? (TYPE_PLAYER | TYPE_NPC) : 2 | 2048;
        check_mask(FACTION_PROPERTY_TYPE_DAMAGE_DIRECT, type, &actor.faction.type_damage_direct,
                   TYPE_PLAYER | TYPE_NPC, &actor.faction);
        check_mask(FACTION_PROPERTY_TYPE_DAMAGE_INDIRECT, type, &actor.faction.type_damage_indirect,
                   TYPE_PLAYER | TYPE_NPC, &actor.faction);
        check_mask(FACTION_PROPERTY_TYPE_HOSTILE, type, &actor.faction.type_hostile,
                   TYPE_PLAYER | TYPE_NPC, &actor.faction);
    }
    return 0;
}
