uint32_t obor_profile_build;
static s_set_entry stage_set;
static s_savelevel record;
s_set_entry *levelsets = &stage_set;
s_savelevel *savelevel = &record;
s_player player[MAX_PLAYERS];
s_savedata savedata;
char allowselect_args[MAX_ALLOWSELECT_LEN];
@NAME_STORAGE@
char branch_name[MAX_NAME_LEN + 1];
char *custBkgrds = "custom/";
int current_set, current_level, current_stage, num_difficulties = 1;
int useSave, useSet, allow_secret_chars, musicoverlap, magic_type, fade;
int PLAYER_LIVES = 4, CONTINUES = 6, psmenu[4][4], noshare, credits, creditscheat;
int selectScreen, nofadeout = 1, nosave, sameplayer, colourselect, unlockbg = 1, bonus = 1;
int goto_mainmenu_flag, PLAYER_MIN_Z, PLAYER_MAX_Z, BGHEIGHT;
int SAMPLE_BEEP = -1, SAMPLE_BEEP2 = -1;
u32 time, bothnewkeys;

static s_model models[] = {
    {.name = "Scout", .type = TYPE_PLAYER}, {.name = "Guard", .type = TYPE_PLAYER},
    {.name = "Pilot", .type = TYPE_PLAYER}, {.name = "Guest", .type = TYPE_PLAYER},
};
static s_modelcache cache[3];
unsigned models_cached = 3;
static int events;
static int music_fallback;
static const char select_file[] =
    "music file.ogg 1 42\n"
    "allowselect Scout Pilot\n"
    "background file-bg\n"
    "load Guard 3\n"
    "load Guest 5\n"
    "load Scout\n";

static void text_value(const char *value, int trim)
{
    size_t size = strlen(value);
    if(trim)
    {
        while(size && value[size - 1] == ' ') --size;
    }
    if(strpbrk(value, "\"\\\n")) abort();
    printf("\"%.*s\"", (int)size, value);
}

static void event(const char *kind, const char *value, int flag, long extra)
{
    if(events++) putchar(',');
    printf("[\"%s\",", kind);
    text_value(value, 1);
    printf(",%d,%ld]", flag, extra);
}

HRESULT Interpreter_Call(Interpreter *interpreter) { abort(); }
HRESULT Interpreter_EvalInstruction(Interpreter *interpreter) { abort(); }
void *checkAlloc(void *pointer, size_t size, const char *fn, const char *file, int line)
{
