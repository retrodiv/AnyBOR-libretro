#include <stdint.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#ifndef stricmp
#define stricmp strcasecmp
#endif
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wignored-qualifiers"
#if defined(__clang__)
#pragma GCC diagnostic ignored "-Wdeprecated-non-prototype"
#endif
#include "scriptcommon.h"
#undef printf
uint32_t obor_profile_build;
static s_flash_properties object;
static char log_text[8192];
static int dump_calls, dump_rows;
static int capture_log(const char *format, ...)
{
    va_list args;
    size_t used = strlen(log_text);
    int count;
    va_start(args, format);
    count = vsnprintf(log_text + used, sizeof(log_text) - used, format, args);
    va_end(args);
    if(count < 0 || (size_t)count >= sizeof(log_text) - used) abort();
    return count;
}
void StrCache_Collect(int index) { (void)index; abort(); }
CHAR *StrCache_Get(int index) { (void)index; abort(); }
int StrCache_Pop(int size) { (void)size; abort(); }
int StrCache_CreateNewFrom(const CHAR *text) { (void)text; abort(); }
@VARIANTS@
void property_access_dump_members(property_access_map mapper, const int count, const void *acting)
{
    int i;
    ++dump_calls;
    dump_rows = 0;
    for(i = 0; i < count; ++i)
    {
        const s_property_access_map map = mapper(acting, i);
        if(map.config_flags != PROPERTY_ACCESS_CONFIG_NONE && map.field) ++dump_rows;
    }
}
#define printf capture_log
@COMMON@
@ENTRIES@
#undef printf
List theFunctionList;
static const char *registered[2];
static int registered_count;
void List_InsertAfter(List *list, void *entry, const char *name)
{
    if(list != &theFunctionList || registered_count >= 2 ||
       (entry != (void*)openbor_get_flash_property && entry != (void*)openbor_set_flash_property)) abort();
    registered[registered_count++] = name;
}
static void register_flash(void) { @REGISTRATION@ }
static const char *flash_function_name(void *functionRef)
{
    if(0) { }
    @NAMES@
    return "";
}
@CONSTANT_HELPER@
@MACRO@
static int constant_query(const char *constname, LONG *result)
{
    ScriptVariant v = {0};
    if(0) { }
    @CONSTANT_CHAIN@
    else return 0;
    *result = v.lVal;
    return 1;
}
#pragma GCC diagnostic pop
static void quote(const char *text)
{
    const unsigned char *p = (const unsigned char *)text;
    putchar('"');
    for(; *p; ++p)
    {
        if(*p == '\n') printf("\\n");
        else if(*p == '\r') printf("\\r");
        else if(*p == '\t') printf("\\t");
        else if(*p == '"' || *p == '\\') printf("\\%c", *p);
        else putchar(*p);
    }
    putchar('"');
}
static int field_marker(const void *field)
{
    const void *const fields[] = {&object.layer_adjust, &object.layer_source,
        &object.model_block, &object.model_hit, &object.z_source};
    unsigned i;
    for(i = 0; i < sizeof(fields) / sizeof(*fields); ++i)
        if(field == fields[i]) return (int)i;
    return -1;
}
static void print_variant(HRESULT status, ScriptVariant *out, ScriptVariant *result)
{
    printf("[%d,%d,%d,%d]", (int)status, out == result, result->vt,
           result->vt == VT_INTEGER ? (int)result->lVal : 0);
}
struct input_case { int property, value_kind, class_kind, object_type, property_type; };
static const struct input_case cases[] = {@CASES@};
static void api_case(const struct input_case *input)
{
    ScriptVariant handle = {0}, property = {0}, value = {0};
    ScriptVariant result = {0}, *out;
    ScriptVariant *args[] = {&handle, &property, &value};
    HRESULT status;
    object = (s_flash_properties){.layer_adjust=11,.layer_source=12,
        .model_block=13,.model_hit=14,.z_source=15,
        .object_type=input->class_kind ? OBJECT_TYPE_FLASH : OBJECT_TYPE_GLOBAL_CONFIG};
    handle.vt = input->object_type; handle.ptrVal = &object;
    property.vt = input->property_type; property.lVal = input->property;
    value.vt = input->value_kind;
    if(value.vt == VT_DECIMAL) value.dblVal = 3.75;
    else value.lVal = -7;
    dump_calls = dump_rows = 0;
    result.vt = VT_INTEGER; result.lVal = 77; out = &result; log_text[0] = '\0';
    status = openbor_get_flash_property(args, &out, 2);
    printf("{\"get\":"); print_variant(status, out, &result);
    printf(",\"get_log\":"); quote(log_text);
    result.vt = VT_INTEGER; result.lVal = 77; out = &result; log_text[0] = '\0';
    status = openbor_set_flash_property(args, &out, 3);
    printf(",\"set\":"); print_variant(status, out, &result);
    printf(",\"set_log\":"); quote(log_text);
    result.vt = VT_INTEGER; result.lVal = 77; out = &result; log_text[0] = '\0';
    status = openbor_get_flash_property(args, &out, 2);
    printf(",\"after\":"); print_variant(status, out, &result);
    printf(",\"after_log\":"); quote(log_text);
    printf(",\"state\":[%d,%d,%d,%d,%d],\"dump\":[%d,%d]}",
           object.layer_adjust,object.layer_source,object.model_block,object.model_hit,
           object.z_source,dump_calls,dump_rows);
}
static void limit_case(int setter, int count)
{
    ScriptVariant values[3], result = {.lVal=77,.vt=VT_INTEGER}, *out = &result;
    ScriptVariant **args = count > 0 ? (malloc)((size_t)count * sizeof(*args)) : NULL;
    HRESULT status;
    int i;
    memset(values, 0, sizeof(values));
    values[0].vt = VT_PTR; values[0].ptrVal = &object;
    values[1].vt = VT_INTEGER; values[1].lVal = 1;
    values[2].vt = VT_INTEGER; values[2].lVal = 7;
    for(i = 0; i < count; ++i) args[i] = &values[i];
    log_text[0] = '\0';
    status = setter ? openbor_set_flash_property(args, &out, count) : openbor_get_flash_property(args, &out, count);
    printf("{\"result\":"); print_variant(status, out, &result);
    printf(",\"log\":"); quote(log_text); putchar('}');
    (free)(args);
}
int main(void)
{
    static const unsigned profiles[] = {@PROFILES@};
    static const char *const queries[] = {@CONSTANT_QUERIES@};
    unsigned p, c;
    puts("{\"status\":\"PASS\",\"profiles\":[");
    for(p = 0; p < sizeof(profiles) / sizeof(*profiles); ++p)
    {
        obor_profile_build = profiles[p]; registered_count = 0; register_flash();
        printf("%s{\"revision\":%u,\"registered\":[", p ? "," : "", profiles[p]);
        for(c = 0; c < (unsigned)registered_count; ++c) { if(c) putchar(','); quote(registered[c]); }
        printf("],\"constants\":[");
        for(c = 0; c < sizeof(queries) / sizeof(*queries); ++c)
        {
            LONG value = -1;
            int found = constant_query(queries[c], &value);
            printf("%s[%d,%d]", c ? "," : "", found, (int)value);
        }
        printf("],\"names\":[");
        if(registered_count)
        {
            quote(flash_function_name((void*)openbor_get_flash_property)); putchar(',');
            quote(flash_function_name((void*)openbor_set_flash_property));
        }
        printf("],\"maps\":[");
        if(registered_count)
            for(c = 0; c <= (unsigned)obor_profile_flash_property_end(); ++c)
            {
                const s_property_access_map map = flash_get_property_map(&object, c);
                printf("%s[%d,%d,%d,", c ? "," : "", map.config_flags,map.type,field_marker(map.field));
                quote(map.id_string); putchar(']');
            }
        printf("],\"api\":[");
        if(registered_count)
            for(c = 0; c < sizeof(cases) / sizeof(*cases); ++c) { if(c) putchar(','); api_case(&cases[c]); }
        printf("],\"limits\":[");
        if(registered_count)
            for(c = 0; c < 7; ++c) { if(c) putchar(','); limit_case(c >= 3, c < 3 ? (int)c - 1 : (int)c - 4); }
        printf("]}");
    }
    puts("]}");
    return 0;
}
