#include <stdint.h>
#include <stdio.h>
#include <stdarg.h>
#include <stdlib.h>
uint32_t obor_profile_build;
static struct {int dOffset;} videomodes={34};
static char output[64];
static int fps_value,calls;
static int getFPS(void){return fps_value;}
static void font_printf(int x,int y,int font,int flag,const char *format,...){
 if(x!=2 || y!=24 || font || flag || calls++){abort();}
 va_list args;va_start(args,format);int n=vsnprintf(output,sizeof(output),format,args);va_end(args);
 if(n<0 || (size_t)n>=sizeof(output)){abort();}
}
static void legacy(void){@LEGACY_CALL@}
static void current(void){@CURRENT_CALL@}
static const struct {unsigned revision;int legacy;} profiles[]={@PROFILES@};
static const int values[]={@VALUES@};
int main(void){
 for(unsigned p=0;p<sizeof(profiles)/sizeof(*profiles);++p){
  obor_profile_build=profiles[p].revision;printf("{\"revision\":%u,\"results\":[",obor_profile_build);
  for(unsigned i=0;i<sizeof(values)/sizeof(*values);++i){
   fps_value=values[i];calls=0;if(profiles[p].legacy){legacy();}else{current();}
   if(calls!=1){abort();}if(i){putchar(',');}printf("\"%s\"",output);
  }
  puts("]}");
 }
 return 0;
}
