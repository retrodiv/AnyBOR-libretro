 * Native mapper, getter prefix and complete attack-query case.
 */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <stdarg.h>
#include "openbor.h"
#undef printf
#undef assert
#ifdef NDEBUG
#error Diagnostic assertions must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do {if(!(c)){fprintf(stderr,"Diagnostic revision=%u case=%u line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
HRESULT Interpreter_Call(Interpreter *p) { (void)p; abort(); }
HRESULT Interpreter_EvalInstruction(Interpreter *p) { (void)p; abort(); }
static char strings[32][128],diagnostic[4096];
static int used[32];
int StrCache_Pop(void)
{for(int i=0;i<32;++i)if(!used[i]){used[i]=1;strings[i][0]=0;return i;}abort();}
void StrCache_Collect(int i) {assert(i>=0 && i<32 && used[i]);used[i]=0;}
CHAR *StrCache_Get(int i) {assert(i>=0 && i<32 && used[i]);return strings[i];}
void StrCache_Copy(int i,CHAR *text)
{assert(i>=0 && i<32 && used[i] && strlen(text)<sizeof(strings[i]));strcpy(strings[i],text);}
static int record_printf(const char *format,...)
{va_list args;va_start(args,format);size_t len=strlen(diagnostic);int n=vsnprintf(diagnostic+len,sizeof(diagnostic)-len,format,args);va_end(args);assert(n>=0 && (size_t)n<sizeof(diagnostic)-len);return n;}
@VARIANTS@
@SEARCH@
#define printf record_printf
@MACROS@
@DECLARATIONS@
@ENTRIES@
#undef printf
static entity actor;
static const struct {
 unsigned revision;
 struct {int property,arg_index,setter;const char *name,*expected;} cases[9];
} contexts[]={@CONTEXTS@};
static void string_value(ScriptVariant *v,const char *text)
{ScriptVariant_ChangeType(v,VT_STR);StrCache_Copy(v->strVal,(char *)text);}
int main(void)
{
 for(unsigned p=0;p<sizeof(contexts)/sizeof(contexts[0]);++p)
 {
  obor_profile_build=contexts[p].revision;active_case=0;
  for(unsigned k=0;k<9;++k)
  for(int named=0;named<2;++named)
  for(int decimal=0;decimal<2;++decimal)
  for(int premap=0;premap<2;++premap)
  {
   ScriptVariant v[6]={0},*args[6];
   for(int i=0;i<6;++i){v[i].vt=VT_INTEGER;args[i]=v+i;}
   v[0].vt=VT_PTR;v[0].ptrVal=&actor;
   if(named)string_value(v+1,contexts[p].cases[k].name);
   else v[1].lVal=contexts[p].cases[k].property;
   int bad=contexts[p].cases[k].arg_index;
   v[bad].vt=decimal?VT_DECIMAL:VT_EMPTY;
   if(decimal)v[bad].dblVal=2.25;
   diagnostic[0]=0;if(premap)assert(mapstrings_entityproperty(args,6)==1 && !diagnostic[0]);
   entity before;memcpy(&before,&actor,sizeof(actor));
   for(int repeat=0;repeat<2;++repeat)
   {
    ++active_case;diagnostic[0]=0;ScriptVariant result={.vt=VT_INTEGER,.lVal=77},*output=&result;
    HRESULT status=contexts[p].cases[k].setter?
      openbor_changeentityproperty(args,&output,6):openbor_getentityproperty(args,&output,6);
    assert(status==E_FAIL && !output && !strcmp(diagnostic,contexts[p].cases[k].expected));
    assert(v[1].vt==VT_INTEGER && v[1].lVal==contexts[p].cases[k].property);
    assert(v[bad].vt==(decimal?VT_DECIMAL:VT_EMPTY));
    assert(!memcmp(&before,&actor,sizeof(actor)));
    assert(result.vt==(contexts[p].cases[k].setter?VT_INTEGER:VT_EMPTY));
    ScriptVariant_Clear(&result);
   }
   for(int i=0;i<6;++i)ScriptVariant_Clear(v+i);
  }
  for(int i=0;i<32;++i)assert(!used[i]);
  printf("{\"revision\":%u,\"cases\":%u,\"status\":\"PASS\"}\n",obor_profile_build,active_case);
 }
 return 0;
}
