#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <stdarg.h>
#include <ctype.h>
#include "openbor.h"
#include "commands.h"
#undef printf
#undef assert
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do{if(!(c)){fprintf(stderr,"SHADOW revision=%u case=%u line=%d: %s\n",obor_profile_build,active_case,__LINE__,#c);abort();}}while(0)
void *checkAlloc(void *p,size_t n,const char *fn,const char *file,int line){(void)fn;(void)file;(void)line;assert(!n || p);return p;}
#undef malloc
#undef free
HRESULT Interpreter_Call(Interpreter *p){(void)p;abort();}
HRESULT Interpreter_EvalInstruction(Interpreter *p){(void)p;abort();}
void borExit(int status){(void)status;abort();}
#include "List.c"
#ifndef stricmp
#define stricmp strcasecmp
#endif
static char diagnostic[4096];
static int message(const char *format,...)
{
    size_t used=strlen(diagnostic);va_list args;va_start(args,format);
    int result=vsnprintf(diagnostic+used,sizeof(diagnostic)-used,format,args);va_end(args);
    assert(result>=0 && (size_t)result<sizeof(diagnostic)-used);return result;
}
int color_black,color_red,color_orange,color_yellow,color_white,color_blue;
int color_green,color_pink,color_purple,color_magic,color_magic2,colorbars;
int shadowcolor,shadowalpha,shadowopacity,blendfx_is_set,blendfx[MAX_BLENDINGS];
s_axis_i_2d light;
int current_spawn;
static unsigned spawn_calls,render_calls;
static const char *file_contents;
static s_spawn_entry next,entries[1];
static s_level stage;
s_level *level=&stage;
static List *levelcmdlist;
static s_drawmethod observed;
static int table_identity;
int _makecolour(int r,int g,int b){assert(r>=0 && r<=255 && g>=0 && g<=255 && b>=0 && b<=255);return r*65536+g*256+b;}
int buffer_pakfile(char *filename,char **out,size_t *size)
{
    assert(!strcmp(filename,"data/lifebar.txt"));
    if(!file_contents)return 0;
    *size=strlen(file_contents);*out=malloc(*size+1);assert(*out);
    memcpy(*out,file_contents,*size+1);return 1;
}
entity *smartspawn(s_spawn_entry *p){assert(p==entries);spawn_calls++;return NULL;}
static unsigned char table[256];
void spriteq_add_sprite(int x,int y,int z,int id,s_drawmethod *method,int sortid)
{
    assert(x==4 && y==5 && z==6 && id==7 && sortid==0);
    observed=*method;table_identity=method->table==table;render_calls++;
}
static int handle_txt_include(char *command,ArgList *args,char **file,char *name,char **buf,ptrdiff_t *pos,size_t *size)
{(void)args;(void)name;(void)buf;(void)pos;(void)size;assert(command && !strcmp(*file,"unit-level"));return 0;}
@PLAIN@
#define printf message
@PARSER@
@METHODS@
@LIFEBAR@
static void level_line(char *input)
{
    ArgList arglist={0};char argbuf[MAX_ARG_LEN+1]={0};char *command,*buf=input,*filename="unit-level";
    char fnbuf[128]={0};ptrdiff_t pos=0;size_t size=strlen(input);levelCommands cmd;
    ParseArgs(&arglist,buf+pos,argbuf);command=GET_ARG(0);
    cmd=getLevelCommand(levelcmdlist,command);
    switch(cmd){@LEVEL_ARMS@ default:@LEVEL_DEFAULT@}
}
static void event_suffix(void){@EVENTS@}
static void draw_window(int flip,int light_y)
{
    s_drawmethod source=plainmethod,shadowmethod,*drawmethod=&source;
    int alty=7,qx=4,qy=5,z=6,f=7;
    source.table=table;source.scalex=192;source.scaley=128;source.flipx=1;
    source.flipy=flip;source.rotate=9;source.shiftx=3;light.y=light_y;
    @DRAW@
}
#undef printf
static const struct {unsigned revision;int epoch;} contexts[]={@CONTEXTS@};
static const struct {int kind;const char *text;int p[6];} cases[]={@CASES@};
static const struct {const char *diagnostic;unsigned count;long long values[18];int compare[18];} expected[][2]={@EXPECTATIONS@};
static void setup(void)
{
    shadowopacity=37;shadowalpha=4;shadowcolor=11;light.x=128;light.y=64;
    color_black=color_red=color_orange=color_yellow=color_white=color_blue=37;
    color_green=color_pink=color_purple=color_magic=color_magic2=37;colorbars=0;
    memset(&next,0,sizeof(next));next.shadowopacity=37;next.shadowalpha=4;next.shadowcolor=11;
    next.light.x=5;next.light.y=6;next.wait=7;memset(entries,0,sizeof(entries));
    memset(&stage,0,sizeof(stage));stage.spawnpoints=entries;
    memset(blendfx,0,sizeof(blendfx));blendfx_is_set=0;current_spawn=0;
    spawn_calls=render_calls=0;diagnostic[0]=0;memset(&observed,0,sizeof(observed));
}
static void check_values(const long long *values,unsigned count,int epoch)
{
    assert(expected[active_case][epoch].count==count);
    assert(!strcmp(diagnostic,expected[active_case][epoch].diagnostic));
    for(unsigned i=0;i<count;i++)if(expected[active_case][epoch].compare[i]){
        if(values[i]!=expected[active_case][epoch].values[i])
            fprintf(stderr,"SHADOW field=%u actual=%lld expected=%lld\n",i,values[i],expected[active_case][epoch].values[i]);
        assert(values[i]==expected[active_case][epoch].values[i]);
    }
}
int main(void)
{
    for(unsigned context=0;context<sizeof(contexts)/sizeof(*contexts);context++){
        obor_profile_build=contexts[context].revision;int epoch=contexts[context].epoch;
        levelcmdlist=createLevelCommandList();assert(levelcmdlist);
        char name[]="ShAdOwOpAcItY",alpha[]="shadowalpha",color[]="shadowcolor";
        assert(getLevelCommand(levelcmdlist,name)==(epoch?CMD_LEVEL_SHADOWOPACITY:0));
        assert(getLevelCommand(levelcmdlist,alpha)==CMD_LEVEL_SHADOWALPHA);
        assert(getLevelCommand(levelcmdlist,color)==CMD_LEVEL_SHADOWCOLOR);
        for(active_case=0;active_case<sizeof(cases)/sizeof(*cases);active_case++){
            setup();const int *p=cases[active_case].p;
            if(cases[active_case].kind==0){
                file_contents=cases[active_case].text;lifebar_colors();
                long long values[]={shadowopacity,shadowalpha,shadowcolor,colorbars,color_black,color_red};
                check_values(values,sizeof(values)/sizeof(*values),epoch);
            }else if(cases[active_case].kind==1){
                char input[512];assert(cases[active_case].text && strlen(cases[active_case].text)<sizeof(input));
                strcpy(input,cases[active_case].text);char *begin=input,*end;
                do{end=strchr(begin,'|');if(end)*end=0;level_line(begin);begin=end?end+1:NULL;}while(begin);
                long long values[]={next.shadowopacity,next.shadowalpha,next.shadowcolor,next.light.x,next.light.y,next.wait,blendfx[1]};
                check_values(values,sizeof(values)/sizeof(*values),epoch);
            }else if(cases[active_case].kind==2){
                entries[0].shadowopacity=epoch?p[0]:0;entries[0].shadowalpha=p[1];entries[0].shadowcolor=p[2];
                entries[0].light.x=p[3];entries[0].light.y=p[4];event_suffix();
                long long values[]={shadowopacity,shadowalpha,shadowcolor,light.x,light.y,spawn_calls,current_spawn};
                check_values(values,sizeof(values)/sizeof(*values),epoch);
            }else{
                shadowopacity=p[0];shadowcolor=p[1];shadowalpha=p[2];light.x=p[3];draw_window(p[4],p[5]);
                long long values[]={observed.channelr,observed.channelg,observed.channelb,observed.fillcolor,
                    observed.alpha,observed.scalex,observed.scaley,observed.flipx,observed.flipy,observed.centery,
                    observed.rotate,observed.shiftx,table_identity,render_calls};
                check_values(values,sizeof(values)/sizeof(*values),epoch);
            }
        }
        freeCommandList(levelcmdlist);printf("{\"revision\":%u,\"status\":\"PASS\"}\n",obor_profile_build);
    }
    return 0;
}
