#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef assert
#undef printf
#ifdef NDEBUG
#error Special order assertions must remain enabled
#endif
uint32_t obor_profile_build;
static unsigned active_case;
#define assert(c) do {if(!(c)){fprintf(stderr,"SPECIAL_ORDER revision=%u case=%u line=%d\n",obor_profile_build,active_case,__LINE__);abort();}}while(0)
static entity actor,partner,alternate;
entity *self,*smartbomber;
int nocost,healthcheat;
static s_level level_storage;
s_level *level;
static s_anim animation,*animations[ANI_SPECIAL+1];
static s_attack area_attack;
static int energy_hp,energy_mp,idle_mode,mutate_action;
static void initial_action(void) {abort();}
static void callback_action(void) {abort();}
void common_attack_proc(void) {abort();}
static int action_id(void (*action)(void)) {
 if(!action)return 0;
 if(action==initial_action)return 1;
 if(action==callback_action)return 2;
 if(action==common_attack_proc)return 3;
 abort();
}
static int entity_id(entity *e) {
 if(!e)return 0;
 if(e==&actor)return 1;
 if(e==&partner)return 2;
 if(e==&alternate)return 3;
 abort();
}
#define WIDTH 18
static void snapshot(int *out) {
 const int fields[]={action_id(actor.takeaction),actor.attacking,actor.idling,actor.running,
 (int)actor.xdir,(int)actor.zdir,actor.health,actor.mp,action_id(partner.takeaction),
 entity_id(actor.link),entity_id(partner.link),action_id(alternate.takeaction),
 entity_id(alternate.link),entity_id(smartbomber),actor.combostep[0],actor.combostep[19],actor.combostep[20],actor.combostep[26]};
 _Static_assert(sizeof(fields)/sizeof(*fields)==WIDTH,"Observer fields bound");
 _Static_assert(sizeof(int)==4 && sizeof(actor.combostep)>=27,"Native combo reset domain");
 memcpy(out,fields,sizeof(fields));
}
struct event {int kind,subject,fields[WIDTH];};
static struct event events[8];static unsigned event_count;
static void observe(int kind,int subject) {
 assert(event_count<8);struct event *out=&events[event_count++];out->kind=kind;out->subject=subject;snapshot(out->fields);
}
int check_energy(int which,int index) {
 assert((which==0 || which==1) && index==ANI_SPECIAL);observe(1,which);
 return which?energy_mp:energy_hp;
}
int set_idle(entity *e) {
 assert(e==&partner);observe(2,entity_id(e));e->takeaction=callback_action;
 if(idle_mode==1){actor.link=&alternate;alternate.link=&actor;}
 if(idle_mode==2){actor.link=NULL;partner.link=NULL;}
 return 1;
}
#define ent_unlink native_unlink
@UNLINK@
#undef ent_unlink
void ent_unlink(entity *e) {assert(e==self);observe(3,entity_id(e));native_unlink(e);}
void smart_bomb(entity *e,s_attack *attack) {
 assert(e==self && attack==&area_attack);observe(4,entity_id(e));
 if(mutate_action)e->takeaction=callback_action;
}
void ent_set_anim(entity *e,int index,int reset) {
 assert(e==self && index==ANI_SPECIAL && !reset);observe(5,index);
 if(mutate_action)e->takeaction=callback_action;
}
@FUNCTION@
struct special_case {int nospecial,cantfire,hp,mp,linked,idle_mode,bomb,freeze,nocost,cheat,mutate;};
static const struct special_case cases[]={@CASES@};
static const unsigned profiles[]={@PROFILES@};
static void prepare(const struct special_case *c) {
 memset(&actor,0,sizeof(actor));memset(&partner,0,sizeof(partner));memset(&alternate,0,sizeof(alternate));
 memset(&level_storage,0,sizeof(level_storage));memset(&animation,0,sizeof(animation));memset(animations,0,sizeof(animations));
 self=&actor;level=&level_storage;smartbomber=NULL;level->nospecial=c->nospecial;
 actor.takeaction=partner.takeaction=alternate.takeaction=initial_action;
 actor.idling=1;actor.running=1;actor.xdir=2;actor.zdir=3;actor.health=100;actor.mp=50;actor.cantfire=c->cantfire;
 actor.modeldata.animation=animations;actor.modeldata.animation_capacity=ANI_SPECIAL+1;
 animation.numframes=1;animation.energycost.cost=7;animations[ANI_SPECIAL]=&animation;
 actor.modeldata.smartbomb=c->bomb?&area_attack:NULL;actor.modeldata.dofreeze=c->freeze;
 if(c->linked){actor.link=&partner;partner.link=&actor;}
 for(unsigned i=0;i<27;++i)actor.combostep[i]=(unsigned char)(40+i);
 energy_hp=c->hp;energy_mp=c->mp;idle_mode=c->idle_mode;mutate_action=c->mutate;nocost=c->nocost;healthcheat=c->cheat;event_count=0;
}
static void fields_json(const int *v) {
 putchar('[');for(unsigned i=0;i<WIDTH;++i){if(i)putchar(',');printf("%d",v[i]);}putchar(']');
}
int main(void) {
 for(unsigned p=0;p<sizeof(profiles)/sizeof(*profiles);++p){
  obor_profile_build=profiles[p];
  for(unsigned k=0;k<sizeof(cases)/sizeof(*cases);++k){
   active_case=k;prepare(&cases[k]);int result=check_special(),final[WIDTH];snapshot(final);
   printf("{\"revision\":%u,\"case\":%u,\"result\":%d,\"fields\":",obor_profile_build,k,result);fields_json(final);printf(",\"events\":[");
   for(unsigned i=0;i<event_count;++i){struct event *e=&events[i];if(i)putchar(',');printf("{\"kind\":%d,\"subject\":%d,\"fields\":",e->kind,e->subject);fields_json(e->fields);putchar('}');}
   puts("]}");
  }
 }
 return 0;
}
