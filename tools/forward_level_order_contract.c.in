@METHODS@
static s_level_entry *parse_skip(char *text,s_set_entry *set)
{
 ArgList arglist;char argbuf[MAX_ARG_LEN+1]={0};char *arg;int i;
 s_level_entry *le=NULL;const char *errormessage=NULL;
 ParseArgs(&arglist,text,argbuf);
 switch(CMD_LEVELORDER_SKIPSELECT){case CMD_LEVELORDER_SKIPSELECT:
#define CHKDEF if(!set){errormessage="set required";goto lCleanup;}
 @SKIP@
#undef CHKDEF
 }
 return le;
lCleanup:assert(errormessage);return NULL;
}
#undef malloc
#undef realloc
#undef free
static FILE *file;
static unsigned file_opens,file_closes;
static int open_failed,record_io_events;
static char events[64];
static unsigned event_count;
static struct{char kind;int noselect;char names[4][MAX_NAME_LEN];int credits[4];} observations[32];
static void event(char kind)
{
 size_t n=strlen(events);assert(n+1<sizeof(events));events[n]=kind;events[n+1]=0;
 if(kind=='I'||kind=='Q'||kind=='L'||kind=='R')
 {
  assert(event_count<32);observations[event_count].kind=kind;observations[event_count].noselect=levelsets[0].noselect;
  for(int i=0;i<4;++i){strcpy(observations[event_count].names[i],skipselect[i]);observations[event_count].credits[i]=player[i].credits;}
  ++event_count;
 }
}
void getBasePath(char *path,char *kind,int mode)
{assert(!strcmp(kind,"Saves") && mode==0);strcpy(path,"saves/");}
void getPakName(char *name,size_t size,int type)
{assert(type==0 && size>9);strcpy(name,"case.sav");}
static FILE *file_open(const char *path,const char *mode)
{
 assert(!strcmp(path,"saves/case.sav"));++file_opens;
 if(open_failed)return NULL;
 assert(file);rewind(file);if(record_io_events && mode[0]=='w')event('G');return file;
}
static int file_close(FILE *stream)
{assert(stream==file);++file_closes;return fflush(stream);}
#define fopen file_open
#define fclose file_close
@FILES@
#undef fopen
#undef fclose
int loadScriptFile(void){event('R');return 1;}
static int selection_result=1;
int selectplayer(int *ports,char *filename)
{(void)ports;event(filename?'Q':'I');return selection_result;}
void playscene(char *filename){assert(filename);event('S');}
int playlevel(char *filename){assert(filename);event('L');return 1;}
void gameover(void){event('O');}
void hallfame(int add){assert(add==1);event('T');}
void showcomplete(int stage){(void)stage;event('C');}
void fade_out(int type,int speed){assert(!type && !speed);event('F');}
void sound_close_music(void){event('M');}
@GAME@
