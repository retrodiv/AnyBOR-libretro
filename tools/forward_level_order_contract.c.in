int allow_secret_chars,musicoverlap,fade,CONTINUES,PLAYER_LIVES,magic_type,sameplayer;
int useSave,useSet,nosave,credits,bonus,nofadeout,noshare,loadgameMenu,bothnewkeys,saveslot;
int PLAYER_MIN_Z=11,PLAYER_MAX_Z=31,BGHEIGHT=11,z_coords[3];
int SAMPLE_BEEP,SAMPLE_BEEP2;
char branch_name[MAX_NAME_LEN+1],skipselect[MAX_PLAYERS][MAX_NAME_LEN];
static char allowselect_args[MAX_ARG_LEN+1];
static void *owned[128];
static unsigned allocation_count,shutdown_calls;
static int fail_allocation;
static char failure[256];
static void *record_malloc(size_t bytes)
{
 assert(bytes<=8u*1024u*1024u);++allocation_count;
 if(fail_allocation)return NULL;
 void *p=malloc(bytes);assert(p);
 for(unsigned i=0;i<128;++i)if(!owned[i]){owned[i]=p;return p;}
 abort();
}
static void *record_realloc(void *p,size_t bytes)
{
 assert(bytes<=8u*1024u*1024u);++allocation_count;
 if(fail_allocation)return NULL;
 unsigned index=128;for(unsigned i=0;i<128;++i)if(owned[i]==p && p){index=i;break;}
 void *q=realloc(p,bytes);assert(q);
 if(index<128){owned[index]=q;return q;}
 for(unsigned i=0;i<128;++i)if(!owned[i]){owned[i]=q;return q;}
 abort();
}
static void record_free(void *p)
{for(unsigned i=0;i<128;++i)if(p && owned[i]==p){owned[i]=NULL;break;}free(p);}
void shutdown(int status,char *format,...)
{assert(status==1);++shutdown_calls;va_list ap;va_start(ap,format);vsnprintf(failure,sizeof(failure),format,ap);va_end(ap);}
static char *copy_name(const char *name)
{size_t n=strlen(name)+1;char *p=record_malloc(n);if(p)memcpy(p,name,n);return p;}
static s_model models[3];
static s_modelcache caches[3];
unsigned models_cached=3;
static unsigned model_lookups;
s_model *findmodel(char *name)
{++model_lookups;for(unsigned i=0;i<3;++i)if(!strcmp(name,models[i].name))return models+i;return NULL;}
int get_cached_model_index(char *name)
{for(unsigned i=0;i<3;++i)if(!strcmp(name,models[i].name))return (int)i;return -1;}
#pragma pack(push,4)
@ORIGINALS@
#pragma pack(pop)
static const size_t native_sizes[]={@SIZES@};
static const struct{unsigned revision;int credits,local,stored,layout;} contexts[]={@CONTEXTS@};
/* Retain the original record-width copies and their visible truncation warning. */
#if defined(__GNUC__) && !defined(__clang__)
#pragma GCC diagnostic push
#pragma GCC diagnostic warning "-Wstringop-truncation"
#endif
#undef malloc
#undef realloc
#define malloc record_malloc
