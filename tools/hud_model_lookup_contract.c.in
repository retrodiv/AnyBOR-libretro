static void begin(void);
static void draw_hud(void);
static s_modelcache cache_entries[2];
static int lookup_phase, lookups[16][2];
static unsigned lookup_count, model_messages;
s_model *findmodel(char *name)
{
    int index=!strcmp(name,"hero")?0:1;
    assert(!strcmp(name,index?"other":"hero") && lookup_count<16);
    lookups[lookup_count][0]=lookup_phase;lookups[lookup_count++][1]=index;
    return choices+index;
}
static void model_log(char *format,...)
{
    va_list args;va_start(args,format);char *name=va_arg(args,char*);va_end(args);
    assert(!strcmp(format,"next %s\n") || !strcmp(format,"prev %s\n"));
    assert(!strcmp(name,"hero") || !strcmp(name,"other"));++model_messages;
}
static void check_models(int epoch)
{
    const unsigned keys[]={0,FLAG_ANYBUTTON,FLAG_MOVELEFT,FLAG_MOVERIGHT,
        FLAG_MOVEUP,FLAG_MOVEDOWN,FLAG_MOVELEFT|FLAG_ANYBUTTON,FLAG_START};
    for(int seed=0;seed<3;++seed)for(unsigned k=0;k<8;++k)
    for(int frozen=0;frozen<2;++frozen)for(int no_join=0;no_join<2;++no_join)
    for(int same=0;same<2;++same) {
        ++cases;begin();lookup_count=model_messages=0;
        int target=!!seed;sets[0].maxplayers=target+1;
        textbox=frozen?native_entities+3:NULL;
        nojoin=no_join;sameplayer=same;colourselect=1;
        model_cache=cache_entries;models_cached=2;allow_secret_chars=1;bonus=0;
        memset(cache_entries,0,sizeof(cache_entries));
        for(int i=0;i<2;++i) {
            choices[i].type=TYPE_PLAYER;choices[i].health=100*(i+1);choices[i].mp=20*(i+1);
            choices[i].maps_loaded=i?3:1;
            cache_entries[i].model=choices+i;cache_entries[i].selectable=1;
        }
        if(seed==1)player[0].playkeys=FLAG_START;
        if(seed==2) {
            player[0].ent=native_entities;strcpy(player[0].name,"other");
            native_entities[0].modeldata=choices[0];strcpy(native_entities[0].name,"other");
        }
        player[target].joining=1;strcpy(player[target].name,"other");
        player[target].playkeys=keys[k];player[target].colourmap=k==5?0:1;
        int request=!!(keys[k]&FLAG_ANYBUTTON) && !frozen && !no_join;
        int confirmed=request && !(seed==2 && same);
        int left=!request && !!(keys[k]&FLAG_MOVELEFT);
        int right=!request && !left && !!(keys[k]&FLAG_MOVERIGHT);
        int up=!request && !left && !right && !!(keys[k]&FLAG_MOVEUP);
        int down=!request && !left && !right && !up && !!(keys[k]&FLAG_MOVEDOWN);
        /* Own pointer at the start of navigation: the combined HUD and later
         * split HUD find this player's model; intermediate split HUD can carry
         * a model selected by the preceding player, otherwise it is NULL. */
        int model=(epoch==0 || epoch==3)?1:seed==1?0:-1;
        int update_lookup=epoch==3 || (epoch==2 && confirmed) ||
            (epoch==1 && confirmed && model<0) || ((up || down) && model<0);
        int stats=epoch==1 && model>=0?model:1;
        int selected=1,colour=k==5?0:1;
        if(left) {selected=model==1?0:1;colour=target;}
        if(right) {selected=model==0?1:0;colour=target;}
        if(up || down) {
            int maxmap=model==0?1:3;
            colour=up?(colour+1>maxmap?0:colour+1):(colour-1<0?maxmap:colour-1);
        }
        draw_hud();
        assert(!!player[target].ent==confirmed && player[target].joining==!confirmed);
        assert(!strcmp(player[target].name,selected?"other":"hero"));
        assert(player[target].colourmap==colour && spawns==(unsigned)confirmed && joins==(unsigned)confirmed);
        if(confirmed)assert(player[target].spawnhealth==choices[stats].health &&
                            player[target].spawnmp==choices[stats].mp && player[target].lives==PLAYER_LIVES);
        unsigned expected_keys=confirmed || left || right || up || down?0:keys[k];
        assert(player[target].playkeys==expected_keys);
        int expected[3][2],count=0;
        if(epoch==0) {expected[count][0]=1;expected[count++][1]=1;}
        else {
            if(update_lookup) {expected[count][0]=0;expected[count++][1]=1;}
            if(seed==1) {expected[count][0]=1;expected[count++][1]=0;}
            if(!confirmed) {expected[count][0]=1;expected[count++][1]=selected;}
        }
        assert(lookup_count==(unsigned)count);
        for(int i=0;i<count;++i)assert(lookups[i][0]==expected[i][0] && lookups[i][1]==expected[i][1]);
        assert(model_messages==(unsigned)((obor_profile_build>=3613 && obor_profile_build<3623)?(seed==1)+left+right:0));
    }
}
