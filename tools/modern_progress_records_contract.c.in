#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#include "obor_pak_name.h"
#undef printf
uint32_t obor_profile_build;
s_savedata savedata;
s_savelevel *savelevel;
s_savescore savescore;
int num_difficulties = 2;
int bonus;
static FILE *active_file;
static int failed_open, missing, opens, closes, clears, restores, default_path;
void *checkAlloc(void *ptr,size_t size,const char *func,const char *file,int line)
{ (void)func;(void)file;(void)line;if(size && !ptr) abort();return ptr; }

void getBasePath(char *out, char *name, int type)
{ if(strcmp(name,"Saves") || type) abort();strcpy(out,"saves/"); }
void getPakName(char *out, size_t capacity, int type)
{ if(capacity<16 || (type!=0 && type!=1 && type!=4)) abort();strcpy(out,"content.dat"); }
int fileExists(char *path) { (void)path;return !missing; }
void borExit(int status) { (void)status;abort(); }
void clearsettings(void)
{
    ++clears;memset(&savedata,0x5a,sizeof(savedata));
    savedata.compatibleversion=COMPATIBLEVERSION;savedata.vsync=99;savedata.fpslimit=1;
}
void libretro_restore_unbound_players(void) { ++restores; }
static FILE *observed_fopen(const char *path, const char *mode)
{
    ++opens;default_path=strcmp(path,"saves/default.cfg")==0;
    if(strncmp(path,"saves/",6) || (strcmp(mode,"rb") && strcmp(mode,"wb"))) abort();
    return failed_open ? NULL : active_file;
}
static int observed_fclose(FILE *file)
{ if(file!=active_file) abort();++closes;return 0; }
/* Keep the engine's ignored-read-count contract without host fortify attributes. */
static size_t observed_fread(void *out,size_t size,size_t count,FILE *file)
{ return fread(out,size,count,file); }
#define fopen observed_fopen
#define fclose observed_fclose
#define fread observed_fread
@FUNCTIONS@
#undef fopen
#undef fclose
#undef fread

static uint64_t digest(const void *memory,size_t size)
{
    const unsigned char *p=memory;uint64_t result=UINT64_C(14695981039346656037);
    while(size--) { result^=*p++;result*=UINT64_C(1099511628211); }
    return result;
}
static void seed_settings(s_savedata *settings,int invalid)
{
    size_t i;unsigned char *p=(unsigned char*)settings;
    for(i=0;i<sizeof(*settings);++i) p[i]=(unsigned char)(i*3+17);
    settings->compatibleversion=invalid ? 0x12345678u : COMPATIBLEVERSION;
    settings->vsync=7;settings->fpslimit=3;
#if ANDROID
    settings->is_touchpad_vibration_enabled=4;
#endif
}
static void seed_games(s_savelevel *games,int invalid)
{
    size_t i;unsigned char *p=(unsigned char*)games;
    for(i=0;i<2*sizeof(*games);++i) p[i]=(unsigned char)(i*7+29);
    for(i=0;i<2;++i)
    {
        games[i].compatibleversion=invalid ? 0x12345678u : CV_SAVED_GAME;
        games[i].times_completed=i ? 3 : 1;games[i].level=i ? 25 : 12;
    }
}
/* Input media is independent of the implementation's IO helper. */
static size_t make_media(unsigned char *out,const void *source,size_t size,
                         size_t count,size_t gap,size_t removed)
{
    const unsigned char *p=source;size_t i,written=0;
    for(i=0;i<count;++i,p+=size)
    {
        memcpy(out+written,p,gap);written+=gap;
        memcpy(out+written,p+gap+removed,size-gap-removed);written+=size-gap-removed;
    }
    return written;
}
int main(void)
{
    static const unsigned profiles[]={@PROFILES@};
    static const struct input { int kind,base,delta,bad_signature,failed_open,missing; }
        inputs[]={@CASES@};
    static s_savelevel original_games[2],live_games[2];
    unsigned char *media=malloc(sizeof(original_games)+32);
    unsigned char *file_bytes=malloc(sizeof(original_games)+32);
    size_t p,c,i;
    if(!media || !file_bytes) abort();
    savelevel=live_games;
    printf("{\"status\":\"PASS\",\"profiles\":[");
    for(p=0;p<sizeof(profiles)/sizeof(*profiles);++p)
    {
        obor_profile_build=profiles[p];
        printf("%s{\"revision\":%u,\"cases\":[",p ? ",":"",profiles[p]);
        for(c=0;c<sizeof(inputs)/sizeof(*inputs);++c)
        {
            const struct input *in=inputs+c;
            size_t settings_size=sizeof(savedata)-(profiles[p]>=7617u ? 4:0);
            size_t game_size=sizeof(*savelevel)-(profiles[p]>=7613u ? 2:0);
            size_t size=0,length=0,file_size=0,position=0,memory_size;
            int result=9;const void *memory;
            active_file=tmpfile();if(!active_file) abort();
            opens=closes=clears=restores=default_path=0;
            failed_open=in->failed_open;missing=in->missing;bonus=31;
            memset(&savedata,0x5a,sizeof(savedata));
            memset(live_games,0xa5,sizeof(live_games));
            live_games[0].times_completed=2;live_games[1].times_completed=5;
            memset(&savescore,0x5a,sizeof(savescore));
            if(in->kind<=3)
            {
                s_savedata original;seed_settings(&original,in->bad_signature);
                if(in->kind<2) savedata=original;
                else size=make_media(media,&original,sizeof(original),1,
                         offsetof(s_savedata,vsync),profiles[p]>=7617u ? 4:0);
                memory=&savedata;memory_size=sizeof(savedata);
            }
            else if(in->kind<=5)
            {
                seed_games(original_games,in->bad_signature);
                if(in->kind==4) memcpy(live_games,original_games,sizeof(live_games));
                else size=make_media(media,original_games,sizeof(*savelevel),2,
                         offsetof(s_savelevel,dName)+sizeof(savelevel->dName),
                         profiles[p]>=7613u ? 2:0);
                memory=live_games;memory_size=sizeof(live_games);
            }
            else
            {
                for(i=0;i<sizeof(savescore);++i) ((unsigned char*)&savescore)[i]=(unsigned char)(i*3+17);
                savescore.compatibleversion=in->bad_signature ? 0x12345678u : CV_HIGH_SCORE;
                memcpy(media,&savescore,sizeof(savescore));
                if(in->kind==7) { size=sizeof(savescore);memset(&savescore,0x5a,sizeof(savescore)); }
                memory=&savescore;memory_size=sizeof(savescore);
            }
            if(size)
            {
                size_t base=in->base==1 ? settings_size : in->base==2 ? game_size : in->base==3 ? sizeof(savescore) : 0;
                long desired=(long)base+in->delta;
                if(desired<0 || (size_t)desired>sizeof(original_games)+16) abort();
                length=(size_t)desired;
                if(length>size) memset(media+size,0x6b,length-size);
                if(fwrite(media,1,length,active_file)!=length) abort();
                rewind(active_file);
            }
            switch(in->kind)
            {
                case 0:savesettings();break;
                case 1:saveasdefault();break;
                case 2:loadsettings();break;
                case 3:loadfromdefault();break;
                case 4:result=saveGameFile();break;
                case 5:result=loadGameFile();break;
                case 6:result=saveHighScoreFile();break;
                case 7:result=loadHighScoreFile();break;
                default:abort();
            }
            if(ftell(active_file)<0) abort();
            position=(size_t)ftell(active_file);
            if(fseek(active_file,0,SEEK_END) || ftell(active_file)<0) abort();
            file_size=(size_t)ftell(active_file);rewind(active_file);
            if(file_size>sizeof(original_games)+16 || fread(file_bytes,1,file_size,active_file)!=file_size) abort();
            printf("%s{\"result\":%d,\"bonus\":%d,\"services\":[%d,%d,%d,%d,%d],\"position\":%zu,\"size\":%zu,\"file\":\"%016" PRIx64 "\",\"memory\":\"%016" PRIx64 "\"}",
                   c ? ",":"",result,bonus,opens,closes,clears,restores,default_path,position,file_size,
                   digest(file_bytes,file_size),digest(memory,memory_size));
            fclose(active_file);active_file=NULL;
        }
        printf("]}");
    }
    printf("]}\n");free(media);free(file_bytes);return 0;
}
