#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "openbor.h"
#undef assert
#undef printf
#ifdef NDEBUG
#error Picker assertions must remain enabled
#endif
struct picker_case {
 uint32_t revision;const char *name;
 int target,testonly,weapon,valid,range,mp,hp;unsigned random;
 int result;const char *trace;
};
static const struct picker_case cases[]={@CASES@},*test;
static unsigned active_case;
static char observed[2048];static size_t used;
static entity subject,opponent,weapon,*self=&subject;
uint32_t obor_profile_build;
static int max_attacks=3,max_freespecials=2,atkchoices[MAX_ANIS];
static int animattacks[]={114,115,116},animspecials[]={110,111};
static const int ids[]={114,115,116,110,111,ANI_THROWATTACK,ANI_JUMPATTACK,ANI_UPPER};
#define assert(c) do {if(!(c)) {fprintf(stderr,"AI picker mismatch: profile=%u case=%u (%s) line=%d trace=%s expected=%s\n",obor_profile_build,active_case,test->name,__LINE__,observed,test->trace);abort();}} while(0)
static void record(char code,int value,int extra) {
 assert(used<sizeof(observed));
 int count=extra<0?snprintf(observed+used,sizeof(observed)-used,"%c%d;",code,value):
  snprintf(observed+used,sizeof(observed)-used,"%c%d:%d;",code,value,extra);
 assert(count>=0 && (size_t)count<sizeof(observed)-used);used+=(size_t)count;
}
static int slot(int animation) {
 if(animation==-1)return -1;
 for(unsigned i=0;i<sizeof(ids)/sizeof(*ids);++i)if(animation==ids[i])return (int)i;
 assert(!"Unexpected animation index");return -1;
}
static int observed_range(entity *ent,entity *target,int animation) {
 assert(ent==self && target==&opponent);int index=slot(animation);assert(index>=0);
 record('R',index,-1);return !!(test->range&(1<<index));
}
#undef check_range
#define check_range observed_range
int check_energy(int which,int animation) {
 int index=slot(animation);assert((which==0 || which==1) && (index==3 || index==4));
 record('E',which,index);return !!((which?test->mp:test->hp)&(1<<index));
}
static unsigned observed_random(void) {record('D',(int)test->random,-1);return test->random;}
#undef rand32
#define rand32 observed_random
@PICKER@
int main(void) {
 s_anim *animations[MAX_ANIS],available;
 memset(&available,0,sizeof(available));available.numframes=1;
 for(unsigned i=0;i<sizeof(cases)/sizeof(*cases);++i) {
  active_case=i;test=cases+i;obor_profile_build=test->revision;
  memset(&subject,0,sizeof(subject));memset(&opponent,0,sizeof(opponent));
  memset(&weapon,0,sizeof(weapon));memset(animations,0,sizeof(animations));
  for(unsigned at=0;at<sizeof(ids)/sizeof(*ids);++at)
   if(test->valid&(1<<at))animations[ids[at]]=&available;
  subject.modeldata.animation=animations;subject.modeldata.animation_capacity=MAX_ANIS;
  if(test->weapon){subject.weapent=&weapon;weapon.modeldata.subtype=SUBTYPE_PROJECTILE;}
  unsigned char before[sizeof(subject)],target_before[sizeof(opponent)];
  memcpy(before,&subject,sizeof(subject));memcpy(target_before,&opponent,sizeof(opponent));
  used=0;observed[0]=0;
  int result=pick_random_attack(test->target?&opponent:NULL,test->testonly);
  assert(slot(result)==test->result && !strcmp(observed,test->trace));
  assert(!memcmp(before,&subject,sizeof(subject)) && !memcmp(target_before,&opponent,sizeof(opponent)));
 }
 printf("{\"status\":\"PASS\",\"cases\":%u}\n",(unsigned)(sizeof(cases)/sizeof(*cases)));
 return 0;
}
