#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include "scriptcommon.h"
#include "profile_ids.h"
#undef printf
#undef assert
#include <assert.h>

_Static_assert(ATTACKING_PREPARED == 1 && IDLING_INACTIVE == 0, "Original state values");
#ifndef stricmp
#define stricmp strcasecmp
#endif

uint32_t obor_profile_build;
uint32_t obor_profile_features;
int max_animations = MAX_ANIS;
static unsigned frame_calls;

void update_frame(entity *actor, int frame)
{
    assert(actor->animation && frame == 0);
    ++frame_calls;
    actor->animpos = frame;
}

void *checkAlloc(void *ptr, size_t size, const char *func, const char *file, int line)
{
    assert(!size || ptr);
    return ptr;
}

@DECLARATIONS@
@CACHE@
@SEARCH@
@METHODS@
@SELECTOR@

typedef struct { const char *name; int selector, named; } property_entry;
@TABLES@

static ScriptVariant text(const char *name)
{
    return (ScriptVariant){.vt = VT_STR, .strVal = StrCache_CreateNewFrom(name)};
}

static ScriptVariant integer(int value)
{
    return (ScriptVariant){.vt = VT_INTEGER, .lVal = value};
}

static LONG lookup(ScriptVariant *value)
{
    ScriptVariant handle = {.vt = VT_EMPTY};
    ScriptVariant *args[] = {&handle, value};
    if(!mapstrings_entityproperty(args, 2))
    {
        assert(value->vt == VT_STR);
        ScriptVariant_Clear(value);
        return -1;
    }
    assert(value->vt == VT_INTEGER);
    return value->lVal;
}

static DOUBLE read_boomerang(entity *actor, LONG ordinal, ScriptVariant flag)
{
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = actor};
    ScriptVariant property = integer(ordinal);
    ScriptVariant value = {.vt = VT_EMPTY}, *out = &value;
    ScriptVariant *args[] = {&handle, &property, &flag};
    assert(openbor_getentityproperty(args, &out, 3) == S_OK);
    assert(out == &value && value.vt == VT_DECIMAL);
    return value.dblVal;
}

static void check_boomerang(LONG ordinal, bool old)
{
    entity actor = {0};
    actor.modeldata.boomerang_prop.acceleration = 1.25f;
    actor.modeldata.boomerang_prop.hdistance = 7.5f;
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor};
    ScriptVariant value = {.vt = VT_EMPTY}, *out = &value;
    ScriptVariant key = text("boomerang");
    ScriptVariant first = old ? (ScriptVariant){.vt = VT_DECIMAL, .dblVal = -2.25} : text("acceleration");
    ScriptVariant second = {.vt = VT_DECIMAL, .dblVal = 14.5};
    ScriptVariant *args[] = {&handle, &key, &first, &second};

    if(old)
    {
        assert(read_boomerang(&actor, ordinal, integer(0)) == 1.25);
        assert(read_boomerang(&actor, ordinal, integer(-2)) == 7.5);
        assert(read_boomerang(&actor, ordinal, (ScriptVariant){.vt = VT_DECIMAL, .dblVal = 0.75}) == 1.25);
        assert(openbor_getentityproperty(args, &out, 2) == E_FAIL && out == NULL);
        out = &value;
        assert(openbor_changeentityproperty(args, &out, 3) == E_FAIL && out == NULL);
        assert(actor.modeldata.boomerang_prop.acceleration == 1.25f);
        assert(actor.modeldata.boomerang_prop.hdistance == 7.5f);
    }
    else
    {
        assert(read_boomerang(&actor, ordinal, text("acceleration")) == 1.25);
        assert(read_boomerang(&actor, ordinal, text("hdistance")) == 7.5);
    }

    out = &value;
    assert(openbor_changeentityproperty(args, &out, 4) == S_OK && out == NULL);
    assert(read_boomerang(&actor, ordinal, integer(0)) == (old ? -2.25 : 14.5));
    assert(read_boomerang(&actor, ordinal, integer(1)) == (old ? 14.5 : 7.5));
}

static void check_landing_force(LONG ordinal)
{
    entity actor = {.damage_on_landing = {.attack_force = 17, .attack_type = ATK_SHOCK}};
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor};
    ScriptVariant property = integer(ordinal);
    ScriptVariant input = {.vt = VT_DECIMAL, .dblVal = -5.25};
    ScriptVariant extra = integer(1);
    ScriptVariant result = {.vt = VT_EMPTY}, *out = &result;
    ScriptVariant *getter[] = {&handle, &property, &extra};
    ScriptVariant *setter[] = {&handle, &property, &input, &extra};
    assert(openbor_getentityproperty(getter, &out, 3) == S_OK && out == &result);
    assert(result.vt == VT_INTEGER && result.lVal == 17);
    assert(openbor_changeentityproperty(setter, &out, 4) == S_OK && out == NULL);
    assert(actor.damage_on_landing.attack_force == -5);
    assert(actor.damage_on_landing.attack_type == ATK_SHOCK);
}

static void check_previous_animation(LONG ordinal)
{
    s_anim walk = {.numframes = 7, .sync = 3};
    s_anim idle = {.numframes = 4, .sync = 3};
    s_anim *animations[MAX_ANIS] = {[ANI_WALK] = &walk, [ANI_IDLE] = &idle};
    ScriptVariant property = integer(ordinal);
    ScriptVariant result = {.vt = VT_EMPTY};
    const struct {
        s_anim *previous;
        int position, reset, sync, expected_position;
        unsigned expected_calls;
    } cases[] = {
        {&idle, 2, 0,  3, 2, 0},
        {&walk, 2, 0,  3, 2, 0},
        {&walk, 5, 0,  3, 0, 0},
        {&walk, 2, 2, -1, 2, 0},
        {&walk, 2, 0, -1, 0, 1},
        {NULL,  2, 0,  3, 0, 1}
    };
    for(size_t i = 0; i < sizeof(cases) / sizeof(*cases); ++i)
    {
        const bool unchanged = cases[i].previous == &idle;
        entity actor = {
            .modeldata = {.animation = animations, .animation_capacity = MAX_ANIS},
            .animation = cases[i].previous,
            .animnum = unchanged ? ANI_IDLE : ANI_WALK,
            .prevanimnum = ANI_JUMP,
            .animpos = cases[i].position,
            .walking = 1
        };
        ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor}, *out = &result;
        ScriptVariant *args[] = {&handle, &property};
        idle.sync = cases[i].sync;
        frame_calls = 0;
        ent_set_anim(&actor, ANI_IDLE, cases[i].reset);
        assert(actor.animation == &idle && actor.animnum == ANI_IDLE);
        assert(actor.animpos == cases[i].expected_position && actor.walking == unchanged);
        assert(frame_calls == cases[i].expected_calls);
        if(ordinal >= 0)
        {
            assert(openbor_getentityproperty(args, &out, 2) == S_OK && out == &result);
            assert(result.vt == VT_INTEGER && result.lVal == (unchanged ? 2 : 1));
        }
    }
}

static void check_collision_property(LONG ordinal, int selector)
{
    entity contacted = {0}, replacement = {0};
    entity actor = {.collided_entity = &contacted, .movex = 2.25f, .movez = -3.5f};
    actor.modeldata.entitypushing = 1;
    actor.modeldata.pushingfactor = 0.5f;
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor};
    ScriptVariant property = integer(ordinal);
    ScriptVariant value = {.vt = VT_DECIMAL, .dblVal = -1.25};
    ScriptVariant result = {.vt = VT_EMPTY}, *out = &result;
    ScriptVariant *args[] = {&handle, &property, &value};
    assert(openbor_getentityproperty(args, &out, 2) == S_OK && out == &result);
    switch(selector)
    {
    case _ep_collidedentity:
        assert(result.vt == VT_PTR && result.ptrVal == &actor.collided_entity);
        value = (ScriptVariant){.vt = VT_PTR, .ptrVal = &replacement};
        break;
    case _ep_entitypushing:
        assert(result.vt == VT_INTEGER && result.lVal == 1);
        value = integer(0);
        break;
    case _ep_pushingfactor:
        assert(result.vt == VT_DECIMAL && result.dblVal == 0.5);
        break;
    case _ep_movex:
    case _ep_movez:
        assert(result.vt == VT_DECIMAL && result.dblVal == 2.25);
        break;
    }
    assert(openbor_changeentityproperty(args, &out, 3) == S_OK && out == NULL);
    assert(actor.collided_entity == (selector == _ep_collidedentity ? &replacement : &contacted));
    assert(actor.modeldata.entitypushing == (selector != _ep_entitypushing));
    assert(actor.modeldata.pushingfactor == (selector == _ep_pushingfactor ? -1.25f : 0.5f));
    assert(actor.movex == (selector == _ep_movex ? -1.25f : 2.25f));
    assert(actor.movez == (selector == _ep_movez ? -1.25f : -3.5f));
}

static void check_direction(LONG ordinal)
{
    entity actor = {.direction = DIRECTION_LEFT};
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor};
    ScriptVariant property = integer(ordinal);
    ScriptVariant value = {.vt = VT_DECIMAL, .dblVal = 3.75};
    ScriptVariant result = {.vt = VT_EMPTY}, *out = &result;
    ScriptVariant *args[] = {&handle, &property, &value};
    assert(openbor_changeentityproperty(args, &out, 3) == S_OK && out == NULL);
    assert(actor.direction == 3);
    out = &result;
    assert(openbor_getentityproperty(args, &out, 2) == S_OK && result.vt == VT_INTEGER && result.lVal == 3);

    value = text("right");
    assert(openbor_changeentityproperty(args, &out, 3) == S_OK && out == NULL);
    assert(actor.direction == 3);
    ScriptVariant_Clear(&value);
    value = integer(DIRECTION_RIGHT);
    assert(openbor_changeentityproperty(args, &out, 3) == S_OK && out == NULL);
    assert(actor.direction == DIRECTION_RIGHT);
}

static void check_combat_factor(LONG ordinal, int selector)
{
    s_defense defense[MAX_ATKS] = {0};
    float offense[MAX_ATKS] = {0};
    entity actor = {.defense = defense, .offense_factors = offense};
    ScriptVariant handle = {.vt = VT_PTR, .ptrVal = &actor};
    ScriptVariant property = integer(ordinal);
    ScriptVariant type = integer(1);
    ScriptVariant value[] = {
        {.vt = VT_DECIMAL, .dblVal = 0.1}, {.vt = VT_DECIMAL, .dblVal = 0.2},
        {.vt = VT_DECIMAL, .dblVal = 0.3}, {.vt = VT_DECIMAL, .dblVal = 1.1},
        {.vt = VT_DECIMAL, .dblVal = 1.2}, {.vt = VT_DECIMAL, .dblVal = 0.7},
    };
    ScriptVariant *args[] = {&handle, &property, &type, &value[0], &value[1],
                             &value[2], &value[3], &value[4], &value[5]};
    ScriptVariant *out = NULL;
    int count = selector == _ep_defense ? 9 : 4;
    assert(openbor_changeentityproperty(args, &out, count) == S_OK && out == NULL);
    if(selector == _ep_defense)
    {
        const s_defense result = defense[ATK_NORMAL2];
        assert(result.factor == (float)value[0].dblVal && result.pain == (float)value[1].dblVal);
        assert(result.knockdown == (float)value[2].dblVal && result.blockpower == (float)value[3].dblVal);
        assert(result.blockthreshold == (float)value[4].dblVal && result.blockratio == (float)value[5].dblVal);
    }
    else
        assert(offense[ATK_NORMAL2] == (float)value[0].dblVal);
    assert(defense[ATK_NORMAL].factor == 0 && offense[ATK_NORMAL] == 0);
}

int main(void)
{
    const struct { unsigned revision; const property_entry *table; size_t count; int boomerang; } profiles[] = {
        @PROFILES@
    };
    StrCache_Init();
    for(size_t p = 0; p < sizeof(profiles) / sizeof(*profiles); ++p)
    {
        obor_profile_build = profiles[p].revision;
        LONG boomerang = -1;
        LONG previous_animation = -1;
        for(size_t n = 0; n < profiles[p].count; ++n)
        {
            const property_entry *entry = &profiles[p].table[n];
            ScriptVariant name = text(entry->name);
            LONG mapped = lookup(&name);
            if(mapped != entry->named)
                fprintf(stderr, "%u %s expected %d, got %ld\n", obor_profile_build,
                        entry->name, entry->named, (long)mapped);
            assert(mapped == entry->named);
            assert(obor_entityproperty((int)n) == entry->selector);
            if(entry->selector == _ep_boomerang) boomerang = (LONG)n;
            if(entry->selector == _ep_damage_on_landing) check_landing_force((LONG)n);
            if(entry->selector == _ep_prevanimationid) previous_animation = (LONG)n;
            if(entry->selector == _ep_direction) check_direction((LONG)n);
            if(entry->selector == _ep_defense || entry->selector == _ep_offense)
                check_combat_factor((LONG)n, entry->selector);
            if(entry->selector == _ep_collidedentity || entry->selector == _ep_movex ||
                entry->selector == _ep_movez || entry->selector == _ep_entitypushing ||
                entry->selector == _ep_pushingfactor)
                check_collision_property((LONG)n, entry->selector);
        }
        assert(obor_entityproperty((int)profiles[p].count) == _ep_the_end);
        const char *sentinels[] = {@CONTROLS@};
        for(size_t n = 0; n < sizeof(sentinels) / sizeof(*sentinels); ++n)
        {
            LONG expected = -1;
            for(size_t i = 0; i < profiles[p].count; ++i)
                if(!strcmp(sentinels[n], profiles[p].table[i].name)) expected = profiles[p].table[i].named;
            ScriptVariant name = text(sentinels[n]);
            assert(lookup(&name) == expected);
        }
        if(profiles[p].boomerang) check_boomerang(boomerang, profiles[p].boomerang == 1);
        else assert(boomerang < 0);
        check_previous_animation(previous_animation);
        printf("PASS %u\n", obor_profile_build);
    }
    StrCache_Clear();
    return 0;
}
